diff --git a/src/WpfStudio.Contracts/DiagTrace.cs b/src/WpfStudio.Contracts/DiagTrace.cs
new file mode 100644
index 0000000..139662b
--- /dev/null
+++ b/src/WpfStudio.Contracts/DiagTrace.cs
@@ -0,0 +1,24 @@
+namespace WpfStudio.Contracts;
+
+/// <summary>CI diagnostics only: appends timestamped lines to WPFSTUDIO_DIAG_TRACE.&lt;pid&gt; when that variable is set.</summary>
+public static class DiagTrace
+{
+    private static readonly string? Folder = Environment.GetEnvironmentVariable("WPFSTUDIO_DIAG_TRACE");
+    private static readonly object Gate = new();
+    private static int s_ids;
+
+    public static int NextId() => Interlocked.Increment(ref s_ids);
+
+    public static void Write(string message)
+    {
+        if (Folder is null) return;
+        string line = DateTime.UtcNow.ToString("HH:mm:ss.fff", System.Globalization.CultureInfo.InvariantCulture) + " [" + System.Diagnostics.Process.GetCurrentProcess().Id + ":" + Environment.CurrentManagedThreadId + "] " + message + "\n";
+        lock (Gate)
+        {
+            try { File.AppendAllText(Path.Combine(Folder, "trace." + System.Diagnostics.Process.GetCurrentProcess().Id + ".log"), line); }
+            catch (IOException) { }
+        }
+    }
+
+    public static string Name(string? path) => path is null ? "(all)" : Path.GetFileName(path);
+}
