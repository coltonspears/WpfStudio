<Window x:Class="CounterApp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:CounterApp" Title="Counter — WpfStudio sample" Width="500" Height="350" WindowStartupLocation="CenterScreen">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Colors.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Window.DataContext><vm:CounterViewModel/></Window.DataContext>
 <Grid Background="{StaticResource SurfaceBrush}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
  <TextBlock Text="WPF + CommunityToolkit" Foreground="{StaticResource TextBrush}" FontSize="23" HorizontalAlignment="Center"/>
  <TextBlock Text="{Binding Count}" Foreground="{StaticResource AccentBrush}" FontSize="58" HorizontalAlignment="Center" Margin="0,20"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="Increment" Command="{Binding IncrementCommand}" Padding="20,8" Margin="4"/><Button Content="Increment async" Command="{Binding IncrementLaterCommand}" Padding="20,8" Margin="4"/></StackPanel>
 </StackPanel></Grid>
</Window>
