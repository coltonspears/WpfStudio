<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <!-- samples/, tests/*/Fixtures and tools/ stay out of everything below. They stand in for user projects or fixed target frameworks (net48, net8.0), so a warning there is not a defect of ours, and they must keep building as a user would see them. -->
  <PropertyGroup>
    <IsProductCode Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)src'))">true</IsProductCode>
    <IsTestCode Condition="$(MSBuildProjectDirectory.StartsWith('$(MSBuildThisFileDirectory)tests')) And !$(MSBuildProjectDirectory.Contains('\Fixtures\'))">true</IsTestCode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IsProductCode)' == 'true' Or '$(IsTestCode)' == 'true'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Vulnerability advisories stay visible warnings. As errors, a newly published advisory, or the advisory feed being unreachable (NU1900), would break every restore with no code change. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- analyzers.globalconfig curates this set. Without AnalysisModeStyle, Recommended would also raise the IDE style rules. -->
    <AnalysisMode>Recommended</AnalysisMode>
    <AnalysisModeStyle>Default</AnalysisModeStyle>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 only runs when the compiler parses doc comments. The XML is a side effect and stays in obj, out of the output and every published package. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>
  <!-- Analyzer packages are compile-time only: nothing from them reaches the output of any project, including those loaded into inspected applications. -->
  <ItemGroup Condition="'$(IsProductCode)' == 'true' Or '$(IsTestCode)' == 'true'">
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)analyzers.globalconfig" />
    <PackageReference Include="WpfAnalyzers" Version="4.1.1" PrivateAssets="all" />
  </ItemGroup>
  <!-- Product code only: test harnesses own their STA loops and launch their own fixtures, so these rules have nothing to protect there. -->
  <ItemGroup Condition="'$(IsProductCode)' == 'true'">
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Visible="false" />
  </ItemGroup>
</Project>
