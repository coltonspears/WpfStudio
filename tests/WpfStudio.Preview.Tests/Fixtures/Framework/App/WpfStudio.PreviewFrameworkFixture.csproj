<Project Sdk="Microsoft.NET.Sdk">
  <!-- A .NET Framework WPF application, whose build output is its .exe, with App.xaml resources and its own configuration file. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <RootNamespace>WpfStudio.PreviewFrameworkFixture</RootNamespace>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="../Controls/WpfStudio.PreviewFrameworkControls.csproj" />
  </ItemGroup>
</Project>
