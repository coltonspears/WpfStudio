<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <Using Include="Xunit" />
    <ProjectReference Include="../../src/WpfStudio.PreviewHost/WpfStudio.PreviewHost.csproj" />
    <ProjectReference Include="../../src/WpfStudio.Runtime/WpfStudio.Runtime.csproj" />
    <ProjectReference Include="../../src/WpfStudio.Core/WpfStudio.Core.csproj" />
    <ProjectReference Include="Fixtures/Compiled/WpfStudio.PreviewFixture.csproj" ReferenceOutputAssembly="false" />
    <!-- Build order only. Naming their one framework here would make MSBuild build them a second time, at once, into the same obj folder. -->
    <ProjectReference Include="Fixtures/Framework/App/WpfStudio.PreviewFrameworkFixture.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="Fixtures/Framework/App32/WpfStudio.PreviewFrameworkFixture32.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../../src/WpfStudio.PreviewHost.Framework/WpfStudio.PreviewHost.Framework.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../../src/WpfStudio.PreviewHost.Framework32/WpfStudio.PreviewHost.Framework32.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" />
    <ProjectReference Include="../../samples/CounterApp/CounterApp.csproj" ReferenceOutputAssembly="false" AdditionalProperties="Configuration=$(Configuration)" />
    <Compile Remove="Fixtures/**/*.cs" />
    <Page Remove="Fixtures/**/*.xaml" />
    <ApplicationDefinition Remove="Fixtures/**/*.xaml" />
  </ItemGroup>
  <Target Name="CopyFrameworkPreviewFixtures" AfterTargets="Build">
    <ItemGroup>
      <FrameworkFixtureFiles Include="$(MSBuildProjectDirectory)/Fixtures/Framework/App/bin/$(Configuration)/net48/**/*" />
      <FrameworkFixture32Files Include="$(MSBuildProjectDirectory)/Fixtures/Framework/App32/bin/$(Configuration)/net48/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrameworkFixtureFiles)" DestinationFiles="@(FrameworkFixtureFiles->'$(OutDir)FrameworkFixture/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FrameworkFixture32Files)" DestinationFiles="@(FrameworkFixture32Files->'$(OutDir)FrameworkFixture32/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyCompiledPreviewFixture" AfterTargets="Build">
    <ItemGroup>
      <CompiledFixtureFiles Include="$(MSBuildProjectDirectory)/Fixtures/Compiled/bin/$(Configuration)/net10.0-windows/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(CompiledFixtureFiles)" DestinationFiles="@(CompiledFixtureFiles->'$(OutDir)CompiledFixture/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <!-- Authored resources beside the build, as in a real project directory. -->
    <ItemGroup>
      <CompiledFixtureThemeFiles Include="$(MSBuildProjectDirectory)/Fixtures/Compiled/Theme/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(CompiledFixtureThemeFiles)" DestinationFiles="@(CompiledFixtureThemeFiles->'$(OutDir)CompiledFixture/Theme/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="CopyDependencyPreviewFixture" AfterTargets="Build">
    <ItemGroup>
      <DependencyControlFiles Include="$(MSBuildProjectDirectory)/Fixtures/Dependencies/Controls/bin/$(Configuration)/net10.0-windows/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(DependencyControlFiles)" DestinationFiles="@(DependencyControlFiles->'$(OutDir)DependencyFixture/bin/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/Fixtures/Dependencies/Controls/obj/project.assets.json" DestinationFiles="$(OutDir)DependencyFixture/obj/project.assets.json" />
  </Target>
  <Target Name="CopyCounterAppPreviewFixture" AfterTargets="Build">
    <ItemGroup>
      <CounterAppOutputFiles Include="$(MSBuildProjectDirectory)/../../samples/CounterApp/bin/$(Configuration)/net10.0-windows/**/*" />
      <CounterAppAuthoredFiles Include="$(MSBuildProjectDirectory)/../../samples/CounterApp/MainWindow.xaml;$(MSBuildProjectDirectory)/../../samples/CounterApp/wpfstudio.preview.json" />
      <CounterAppThemeFiles Include="$(MSBuildProjectDirectory)/../../samples/CounterApp/Themes/**/*.xaml" />
    </ItemGroup>
    <Copy SourceFiles="@(CounterAppOutputFiles)" DestinationFiles="@(CounterAppOutputFiles->'$(OutDir)CounterAppFixture/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CounterAppAuthoredFiles)" DestinationFiles="@(CounterAppAuthoredFiles->'$(OutDir)CounterAppFixture/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CounterAppThemeFiles)" DestinationFiles="@(CounterAppThemeFiles->'$(OutDir)CounterAppFixture/Themes/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
