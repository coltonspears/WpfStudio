<UserControl x:Class="WpfStudio.InspectionFixture.AppearanceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:fixture="clr-namespace:WpfStudio.InspectionFixture">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="AppearanceResources.xaml"/></ResourceDictionary.MergedDictionaries>
   <SolidColorBrush x:Key="LocalAccent" Color="DarkCyan"/>
   <Style x:Key="BaseAppearanceStyle" TargetType="TextBlock"><Setter Property="Foreground" Value="Navy"/></Style>
   <Style x:Key="AppearanceStyle" TargetType="TextBlock" BasedOn="{StaticResource BaseAppearanceStyle}">
    <Setter Property="Foreground" Value="DarkGreen"/>
