   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <StackPanel x:Name="Body">
  <TextBlock x:Name="AppearanceStyle" Text="Styled appearance" Style="{StaticResource AppearanceStyle}"/>
  <TextBlock x:Name="AppearanceStatic" Text="Static appearance" Foreground="{StaticResource LocalAccent}"/>
  <TextBlock x:Name="AppearanceDynamic" Text="Dynamic appearance" Foreground="{DynamicResource SharedAccent}"/>
  <fixture:AppearanceProbe x:Name="AppearanceReadOnly"/>
  <Button x:Name="AppearanceTemplate" Content="Template appearance">
   <Button.Template><ControlTemplate TargetType="Button"><Border Background="Teal"><ContentPresenter/></Border></ControlTemplate></Button.Template>
  </Button>
 </StackPanel>
</UserControl>
