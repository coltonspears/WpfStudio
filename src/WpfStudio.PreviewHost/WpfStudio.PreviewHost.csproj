<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- On .NET this project is the whole host. -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net48'">
    <OutputType>Exe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <Compile Remove="NetFramework/**/*.cs" />
    <Compile Include="../Shared/XamlNamespaceLibraryReader.cs" Link="XamlNamespaceLibraryReader.cs" />
    <PackageReference Include="StreamJsonRpc" Version="2.26.150" />
    <InternalsVisibleTo Include="WpfStudio.Preview.Tests" />
  </ItemGroup>
  <!-- On .NET Framework it is the engine alone, loaded beside project code, while WpfStudio.PreviewHost.Framework owns the process and transport. No package may be added here without checking it against that: a package this code binds to competes with the project's own copy. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="Program.cs;PreviewAssemblyResolver.NetCore.cs" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/PreviewDependencyCatalog.cs" Link="PreviewDependencyCatalog.cs" />
    <Compile Include="../Shared/XamlNamespaceIndex.cs" Link="XamlNamespaceIndex.cs" />
    <Compile Include="../Shared/XamlNamespaceLibrary.cs" Link="XamlNamespaceLibrary.cs" />
    <ProjectReference Include="../WpfStudio.Contracts/WpfStudio.Contracts.csproj" />
    <ProjectReference Include="../WpfStudio.Wpf.PropertyEditing/WpfStudio.Wpf.PropertyEditing.csproj" />
    <ProjectReference Include="../WpfStudio.Wpf.Diagnostics/WpfStudio.Wpf.Diagnostics.csproj" />
  </ItemGroup>
</Project>
