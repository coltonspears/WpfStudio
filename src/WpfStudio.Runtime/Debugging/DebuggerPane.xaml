<UserControl x:Class="WpfStudio.Runtime.Debugging.DebuggerPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:WpfStudio.Runtime.Debugging">
 <UserControl.Resources>
  <HierarchicalDataTemplate DataType="{x:Type local:DebugVariableViewModel}" ItemsSource="{Binding Children}">
   <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,10,0"/><TextBlock Text="{Binding Value}"/><TextBlock Text="{Binding Type}" Foreground="{DynamicResource SubtleBrush}" Margin="10,0,0,0"/></StackPanel>
  </HierarchicalDataTemplate>
  <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}"><Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/></Style>
 </UserControl.Resources>
 <DockPanel Margin="10,4,10,8" Background="{DynamicResource SurfaceBrush}">
  <StackPanel DockPanel.Dock="Top">
   <WrapPanel><Button Content="Continue" Command="{Binding ContinueCommand}" IsEnabled="{Binding IsStopped}"/><Button Content="Pause" Command="{Binding PauseCommand}" IsEnabled="{Binding IsActive}"/><Button Content="Step over" Command="{Binding StepOverCommand}" IsEnabled="{Binding IsStopped}"/><Button Content="Step into" Command="{Binding StepIntoCommand}" IsEnabled="{Binding IsStopped}"/><Button Content="Step out" Command="{Binding StepOutCommand}" IsEnabled="{Binding IsStopped}"/><Button Content="Stop" Command="{Binding StopCommand}" IsEnabled="{Binding IsActive}"/><Button Content="Detach" Command="{Binding DetachCommand}" IsEnabled="{Binding CanDetach}" ToolTip="Detach is available for attached processes. The bundled debugger cannot detach applications it launched." ToolTipService.ShowOnDisabled="True"/></WrapPanel>
   <Expander Header="Attach to a process / debugging options" Margin="0,3,0,3"><StackPanel Margin="0,6,0,6">
    <WrapPanel><TextBlock Text="Process ID" VerticalAlignment="Center"/><TextBox Width="90" Text="{Binding AttachProcessId, UpdateSourceTrigger=PropertyChanged}" Margin="6,0"/><Button Content="Attach" Command="{Binding AttachCommand}"/><CheckBox Content="Break on thrown exceptions" IsChecked="{Binding BreakOnThrown}" Margin="12,0,0,0" VerticalAlignment="Center"/></WrapPanel>
    <WrapPanel Margin="0,6,0,0" ToolTip="These apply when WpfStudio starts the program. An attach always uses the debugger's defaults: Just My Code and step filtering on.">
     <CheckBox Content="Just My Code" IsChecked="{Binding JustMyCode}" Margin="0,0,12,0" VerticalAlignment="Center" ToolTip="Stop and step in your solution's code only, not in framework or package code"/>
     <CheckBox Content="Step over properties and operators" IsChecked="{Binding StepFiltering}" Margin="0,0,12,0" VerticalAlignment="Center"/>
     <CheckBox Content="Stop at entry" IsChecked="{Binding StopAtEntry}" VerticalAlignment="Center" ToolTip="Pause on the program's first line"/>
    </WrapPanel>
   </StackPanel></Expander>
   <Border Padding="10,8" Margin="0,4,0,6" CornerRadius="4" Background="{DynamicResource WarningSoftBrush}">
    <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
     <DataTrigger Binding="{Binding IsAdapterMissing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
     <DataTrigger Binding="{Binding IsInstallingAdapter}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
    </Style.Triggers></Style></Border.Style>
    <DockPanel>
     <Button DockPanel.Dock="Right" Content="Install debugger" Command="{Binding InstallAdapterCommand}" VerticalAlignment="Center" Margin="10,0,0,0"/>
     <StackPanel>
      <TextBlock TextWrapping="Wrap"><Run Text="The debug adapter isn't installed. WpfStudio can download"/> <Run Text="{Binding AdapterDescription, Mode=OneWay}"/> <Run Text="(about 5 MB from GitHub), verify its checksum and install it in your WpfStudio profile."/></TextBlock>
      <TextBlock Text="{Binding AdapterStatus}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" Margin="2,0,0,4"/><TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4"/>
  </StackPanel>
  <TabControl SelectedIndex="{Binding SelectedTab}">
   <TabItem Header="Stack &amp; locals"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
    <DockPanel><ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Threads}" SelectedItem="{Binding SelectedThread}" DisplayMemberPath="Name"/><ListBox ItemsSource="{Binding Frames}" SelectedItem="{Binding SelectedFrame}" DisplayMemberPath="Name"/></DockPanel>
    <TreeView Grid.Column="1" ItemsSource="{Binding Locals}"/></Grid></TabItem>
   <TabItem Header="Watches"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox Text="{Binding WatchExpression, UpdateSourceTrigger=PropertyChanged}" Width="250"/><Button Content="Add" Command="{Binding AddWatchCommand}"/><Button Content="Clear" Command="{Binding ClearWatchesCommand}"/></StackPanel><TreeView ItemsSource="{Binding Watches}"/></DockPanel></TabItem>
   <TabItem Header="Breakpoints"><DockPanel><TextBlock DockPanel.Dock="Top" Text="Click the editor gutter or press F9. Hollow circles are pending/unbound; solid circles are bound. A dot indicates a condition; a diamond is a tracepoint, which writes its log message to Output and continues. Hit count: 5 breaks on the fifth hit, &gt;=5 from the fifth, %5 on every fifth. Put expressions in braces, for example Total={order.Total}." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="3,5"/><WrapPanel DockPanel.Dock="Top"><Button Content="Go to source" Command="{Binding NavigateBreakpointCommand}"/><Button Content="Enable all" Command="{Binding EnableAllBreakpointsCommand}"/><Button Content="Disable all" Command="{Binding DisableAllBreakpointsCommand}"/><Button Content="Apply changes" Command="{Binding ApplyBreakpointsCommand}"/><Button Content="Remove selected" Command="{Binding RemoveBreakpointCommand}"/></WrapPanel><DataGrid ItemsSource="{Binding Breakpoints}" SelectedItem="{Binding SelectedBreakpoint}" AutoGenerateColumns="False" CanUserAddRows="False"><DataGrid.Columns><DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}"><DataGridCheckBoxColumn.ElementStyle><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Focusable" Value="False"/><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0"/></Style></DataGridCheckBoxColumn.ElementStyle><DataGridCheckBoxColumn.EditingElementStyle><Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="Margin" Value="0"/></Style></DataGridCheckBoxColumn.EditingElementStyle></DataGridCheckBoxColumn><DataGridTextColumn Header="File" Binding="{Binding Path}" IsReadOnly="True" Width="*"/><DataGridTextColumn Header="Line" Binding="{Binding Line}" IsReadOnly="True"/><DataGridTextColumn Header="Condition" Binding="{Binding Condition}" Width="*"/><DataGridTextColumn Header="Hit count" Binding="{Binding HitCondition}" Width="70"/><DataGridTextColumn Header="Log message" Binding="{Binding LogMessage}" Width="*"/><DataGridTextColumn Header="Hits" Binding="{Binding HitCount}" IsReadOnly="True"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
   <TabItem Header="Modules"><DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="3,5">
     <TextBox DockPanel.Dock="Left" Width="220" Text="{Binding ModuleFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}" ToolTip="Filter by name, path or symbol status" AutomationProperties.Name="Filter modules"/>
     <TextBlock Text="{Binding ModuleSummary}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"/>
    </DockPanel>
    <DataGrid ItemsSource="{Binding Modules}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="220"/><DataGridTextColumn Header="Symbols" Binding="{Binding Symbols}" Width="160"/><DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/></DataGrid.Columns></DataGrid>
   </DockPanel></TabItem>
   <TabItem Header="Exception"><TextBox Text="{Binding ExceptionDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></TabItem>
   <TabItem Header="Output"><DockPanel><Button Content="Clear" Command="{Binding ClearOutputCommand}" DockPanel.Dock="Top" HorizontalAlignment="Left"/><TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono,Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></DockPanel></TabItem>
  </TabControl>
 </DockPanel>
</UserControl>
