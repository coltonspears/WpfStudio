<UserControl x:Class="WpfStudio.Database.Views.DatabasePane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:WpfStudio.Database.ViewModels"
 xmlns:behaviors="clr-namespace:WpfStudio.Database.Views"
 xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit"
 behaviors:DatabaseViewBehaviors.LoadedCommand="{Binding InitializeCommand}"
 MinWidth="320" MinHeight="240">
 <UserControl.InputBindings>
  <KeyBinding Key="F5" Command="{Binding ExecuteCommand}"/>
  <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewQueryCommand}"/>
 </UserControl.InputBindings>
 <UserControl.Resources>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="2"/><Setter Property="Padding" Value="10,3"/></Style>
  <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="2"/></Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="2"/></Style>
  <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
   <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
   <Setter Property="ToolTip" Value="{Binding ErrorMessage}"/>
  </Style>
  <HierarchicalDataTemplate DataType="{x:Type vm:SchemaNodeViewModel}" ItemsSource="{Binding Children}">
   <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Title}"/><TextBlock Text="{Binding Detail}" Margin="8,0,0,0" Opacity="0.6" FontSize="11"/></StackPanel>
  </HierarchicalDataTemplate>
 </UserControl.Resources>
 <Grid Margin="10,4,10,6" Background="{DynamicResource SurfaceBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Expander Header="SQL Server connections" IsExpanded="False">
   <StackPanel>
    <DockPanel><Button DockPanel.Dock="Right" Content="New" Command="{Binding NewProfileCommand}"/><ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" ToolTip="Saved connections"/></DockPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="Name" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Connection name"/>
     <TextBlock Grid.Row="1" Text="Server" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SQL server"/>
     <TextBlock Grid.Row="2" Text="Database" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DatabaseName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SQL database"/>
     <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Windows authentication" IsChecked="{Binding WindowsAuthentication}" Margin="2,5"/>
     <TextBlock Grid.Row="4" Text="SQL login" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SQL login"/>
     <TextBlock Grid.Row="5" Text="Password" VerticalAlignment="Center"/><PasswordBox Grid.Row="5" Grid.Column="1" Margin="2" Padding="4" behaviors:DatabaseViewBehaviors.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="SQL password"/>
    </Grid>
    <CheckBox Content="Remember password for this Windows user" IsChecked="{Binding RememberPassword}" Margin="2,4"/>
    <CheckBox Content="Trust server certificate (explicit override)" IsChecked="{Binding TrustServerCertificate}" Margin="2,4" ToolTip="Encryption remains enabled. Enable only for a server whose certificate you trust."/>
    <WrapPanel><Button Content="Save connection" Command="{Binding SaveProfileCommand}"/><Button Content="Remove" Command="{Binding DeleteProfileCommand}"/><Button Content="Connect / refresh" Command="{Binding ConnectCommand}"/><Button Content="Cancel" Command="{Binding ConnectCancelCommand}"/></WrapPanel>
   </StackPanel>
  </Expander>
  <Border Grid.Row="1" Padding="10,6" Margin="0,4" BorderBrush="{DynamicResource StrongBorderBrush}" Background="{DynamicResource EditorBrush}" BorderThickness="1" CornerRadius="6">
   <StackPanel><TextBlock Text="QUERY TARGET" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ActiveTarget}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveTarget}"/></StackPanel>
  </Border>
  <Expander Grid.Row="2" Header="Database objects" IsExpanded="False">
   <DockPanel MaxHeight="250">
    <WrapPanel DockPanel.Dock="Bottom"><Button Content="Use database" Command="{Binding UseDatabaseCommand}"/><Button Content="Open definition" Command="{Binding OpenDefinitionCommand}"/></WrapPanel>
    <TreeView ItemsSource="{Binding Schema}" behaviors:DatabaseViewBehaviors.TrackSelection="True" behaviors:DatabaseViewBehaviors.SelectedNode="{Binding SelectedSchema, Mode=TwoWay}" MinHeight="70" AutomationProperties.Name="SQL schema"/>
   </DockPanel>
  </Expander>
  <DockPanel Grid.Row="3">
   <WrapPanel DockPanel.Dock="Top" Margin="0,4"><Button Content="New query" Command="{Binding NewQueryCommand}"/><Button Content="Open" Command="{Binding OpenScriptCommand}"/><Button Content="Save" Command="{Binding SaveScriptCommand}"/><Button Content="▶ Execute" Command="{Binding ExecuteCommand}" ToolTip="F5 — execute selection, or all SQL when nothing is selected"/><Button Content="■ Cancel" Command="{Binding ExecuteCancelCommand}"/><Button Content="Export CSV" Command="{Binding ExportCsvCommand}"/><Button Content="Close query" Command="{Binding CloseQueryCommand}"/></WrapPanel>
   <TabControl ItemsSource="{Binding Documents}" SelectedItem="{Binding SelectedDocument}">
    <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayTitle}"/></DataTemplate></TabControl.ItemTemplate>
    <TabControl.ContentTemplate>
     <DataTemplate DataType="{x:Type vm:QueryDocumentViewModel}">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="80"/><RowDefinition Height="5"/><RowDefinition Height="*" MinHeight="70"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <editor:TextEditor FontFamily="Cascadia Mono, Consolas" FontSize="13" ShowLineNumbers="True" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
        behaviors:SqlEditorBehavior.Text="{Binding SqlText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
        behaviors:SqlEditorBehavior.Selection="{Binding SelectedText, Mode=TwoWay}"
        behaviors:SqlEditorBehavior.SelectionLine="{Binding SelectionStartLine, Mode=TwoWay}"
        behaviors:SqlEditorBehavior.Completions="{Binding DataContext.CompletionItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
        AutomationProperties.Name="SQL editor"/>
       <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"/>
       <TabControl Grid.Row="2">
        <TabItem Header="Results">
         <TabControl ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}">
          <TabControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></TabControl.ItemTemplate>
          <TabControl.ContentTemplate><DataTemplate><DockPanel><TextBlock DockPanel.Dock="Bottom" Text="{Binding Summary}" Margin="4" FontWeight="SemiBold"/><DataGrid ItemsSource="{Binding Table.DefaultView}" IsReadOnly="True" AutoGenerateColumns="True" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False" CanUserDeleteRows="False" ClipboardCopyMode="IncludeHeader"/></DockPanel></DataTemplate></TabControl.ContentTemplate>
         </TabControl>
        </TabItem>
        <TabItem Header="Messages"><TextBox Text="{Binding Messages, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/></TabItem>
       </TabControl>
       <StackPanel Grid.Row="3" Margin="2,4"><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Target}" FontSize="11" Opacity="0.7"/></StackPanel>
      </Grid>
     </DataTemplate>
    </TabControl.ContentTemplate>
   </TabControl>
  </DockPanel>
  <TextBlock Grid.Row="4" Text="{Binding Status}" TextWrapping="Wrap" Margin="2,5" FontSize="11"/>
 </Grid>
</UserControl>
