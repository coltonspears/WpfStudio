<Project Sdk="Microsoft.NET.Sdk">

  <!-- The API client's engine: requests, collections, OpenAPI and Postman import, and C# model generation. No WPF, so its tests run anywhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfStudio.Core\WpfStudio.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WpfStudio.Api.Tests" />
  </ItemGroup>

</Project>
