<Project Sdk="Microsoft.NET.Sdk">
  <!-- The .NET Framework preview host's process and transport. Its packages stay in the default domain, away from project code; the engine it starts in the project's domain is WpfStudio.PreviewHost. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>../WpfStudio.PreviewHost/app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/XamlNamespaceLibrary.cs" Link="XamlNamespaceLibrary.cs" />
    <Compile Include="../Shared/XamlNamespaceLibraryReader.cs" Link="XamlNamespaceLibraryReader.cs" />
    <ProjectReference Include="../WpfStudio.PreviewHost/WpfStudio.PreviewHost.csproj" />
    <PackageReference Include="StreamJsonRpc" Version="2.26.150" />
    <PackageReference Include="System.Reflection.Metadata" Version="8.0.1" />
  </ItemGroup>
</Project>
