      <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource SubtleBrush}" Margin="28,0,0,0" VerticalAlignment="Center"/>
      <Grid x:Name="ArrowSlot" Grid.Column="3" Width="14" Margin="10,0,-2,0">
       <c:Glyph x:Name="Arrow" Kind="ChevronRight" Width="12" Height="12" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
      </Grid>
     </Grid>
    </Border>
    <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Placement="Right" HorizontalOffset="2" VerticalOffset="-5"
           PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
