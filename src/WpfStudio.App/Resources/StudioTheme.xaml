<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:WpfStudio.App.Controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:cc="clr-namespace:ICSharpCode.AvalonEdit.CodeCompletion;assembly=ICSharpCode.AvalonEdit"
                    xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit">
 <ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="EditorMenus.xaml"/>
 </ResourceDictionary.MergedDictionaries>

 <!-- ================================================================
      Graphite design tokens. Values here are the dark defaults;
      ThemeService recolours the same brush instances at runtime.
      ================================================================ -->
 <SolidColorBrush x:Key="WindowBrush" Color="#131417"/>
 <SolidColorBrush x:Key="SurfaceBrush" Color="#18191D"/>
 <SolidColorBrush x:Key="EditorBrush" Color="#1C1D22"/>
 <SolidColorBrush x:Key="RaisedBrush" Color="#23252B"/>
 <SolidColorBrush x:Key="HoverBrush" Color="#2A2C33"/>
 <SolidColorBrush x:Key="PressedBrush" Color="#32353D"/>
 <SolidColorBrush x:Key="BorderBrush" Color="#26282E"/>
 <SolidColorBrush x:Key="StrongBorderBrush" Color="#34373F"/>
 <SolidColorBrush x:Key="TextBrush" Color="#E4E5E9"/>
 <SolidColorBrush x:Key="MutedBrush" Color="#9397A1"/>
 <SolidColorBrush x:Key="SubtleBrush" Color="#6C707B"/>
 <SolidColorBrush x:Key="AccentBrush" Color="#8C94FF"/>
 <SolidColorBrush x:Key="AccentFillBrush" Color="#5B63E6"/>
 <SolidColorBrush x:Key="AccentHoverBrush" Color="#6B73F0"/>
 <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="AccentSoftBrush" Color="#272B4D"/>
 <SolidColorBrush x:Key="SelectionBrush" Color="#2B2F54"/>
 <SolidColorBrush x:Key="InactiveSelectionBrush" Color="#25272E"/>
 <SolidColorBrush x:Key="SuccessBrush" Color="#5CC896"/>
 <SolidColorBrush x:Key="WarningBrush" Color="#E3B458"/>
 <SolidColorBrush x:Key="DangerBrush" Color="#F0736B"/>
 <SolidColorBrush x:Key="DebugBrush" Color="#B4531F"/>
 <SolidColorBrush x:Key="OverlayBrush" Color="#A60A0B0D"/>
 <SolidColorBrush x:Key="EditorLineBrush" Color="#22242A"/>
 <SolidColorBrush x:Key="EditorSelectionBrush" Color="#33386A"/>
 <SolidColorBrush x:Key="GutterTextBrush" Color="#555A64"/>
 <SolidColorBrush x:Key="CanvasBrush" Color="#111215"/>
 <SolidColorBrush x:Key="CanvasDotBrush" Color="#24262D"/>
 <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A2327"/>
 <SolidColorBrush x:Key="WarningSoftBrush" Color="#3A3223"/>

 <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
 <FontFamily x:Key="CodeFont">Cascadia Code, Cascadia Mono, Consolas</FontFamily>
 <sys:Double x:Key="UiFontSize">12</sys:Double>
 <CornerRadius x:Key="ControlRadius">6</CornerRadius>
 <DropShadowEffect x:Key="PopupShadow" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.32" Color="Black" RenderingBias="Performance"/>
 <DropShadowEffect x:Key="CardShadow" BlurRadius="40" ShadowDepth="12" Direction="270" Opacity="0.38" Color="Black" RenderingBias="Performance"/>

 <BooleanToVisibilityConverter x:Key="BooleanToVisibility"/>
 <c:PresenceVisibilityConverter x:Key="Presence"/>
 <c:FileIconKindConverter x:Key="FileIconKind"/>
 <c:FileStemConverter x:Key="FileStem"/>
 <c:DirectoryConverter x:Key="DirectoryOf"/>
 <c:ExtensionLabelConverter x:Key="ExtensionLabel"/>
 <c:ContentGlyphConverter x:Key="ContentGlyph"/>
 <c:KeyCapsConverter x:Key="ToKeyCaps"/>
 <c:EqualsConverter x:Key="EqualsText"/>
 <c:TreeIndentConverter x:Key="TreeIndent"/>
 <c:SeverityGlyphConverter x:Key="SeverityGlyph"/>

 <!-- ================================================================ Base -->
 <Style TargetType="Window">
  <Setter Property="Background" Value="{DynamicResource WindowBrush}"/>
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
  <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
  <Setter Property="UseLayoutRounding" Value="True"/>
  <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
 </Style>
 <Style TargetType="ScrollViewer"><Setter Property="Background" Value="Transparent"/></Style>

 <!-- Key cap used for shortcuts in menus, the palette and the start page. -->
 <Style x:Key="KeyCap" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1,1,1,2"/>
  <Setter Property="CornerRadius" Value="4"/>
  <Setter Property="Padding" Value="5,0"/>
  <Setter Property="MinWidth" Value="20"/>
  <Setter Property="Height" Value="20"/>
  <Setter Property="Margin" Value="0,0,3,0"/>
 </Style>
 <DataTemplate x:Key="KeyCapTemplate">
  <Border Style="{StaticResource KeyCap}">
   <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border>
 </DataTemplate>
 <ItemsPanelTemplate x:Key="HorizontalItems"><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
 <Style x:Key="KeyCaps" TargetType="ItemsControl">
  <Setter Property="ItemTemplate" Value="{StaticResource KeyCapTemplate}"/>
  <Setter Property="ItemsPanel" Value="{StaticResource HorizontalItems}"/>
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>

 <Style x:Key="SectionLabel" TargetType="TextBlock">
  <Setter Property="FontSize" Value="11"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
  <Setter Property="Margin" Value="0,0,0,8"/>
 </Style>
 <Style x:Key="Caption" TargetType="TextBlock">
  <Setter Property="FontSize" Value="11"/>
  <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
  <Setter Property="TextWrapping" Value="Wrap"/>
 </Style>
 <Style x:Key="PaneHeading" TargetType="TextBlock">
  <Setter Property="FontSize" Value="15"/>
  <Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
 </Style>
 <Style x:Key="OverlayCard" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="10"/>
  <Setter Property="Padding" Value="24"/>
  <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
 </Style>
 <Style x:Key="Card" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource EditorBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="CornerRadius" Value="8"/>
  <Setter Property="Padding" Value="12"/>
 </Style>
 <Style x:Key="Badge" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
  <Setter Property="CornerRadius" Value="4"/>
  <Setter Property="Padding" Value="6,1"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
 </Style>
 <Style x:Key="PaneToolbar" TargetType="Border">
  <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  <Setter Property="BorderThickness" Value="0,0,0,1"/>
  <Setter Property="Padding" Value="8,5"/>
 </Style>

 <!-- ================================================================ Buttons -->
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="12,5"/>
  <Setter Property="Margin" Value="2"/>
  <Setter Property="MinHeight" Value="28"/>
  <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
  <Setter Property="FontSize" Value="{StaticResource UiFontSize}"/>
  <Setter Property="HorizontalContentAlignment" Value="Center"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="SnapsToDevicePixels" Value="True"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
       <c:Glyph x:Name="Icon" Kind="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" Margin="-2,0,7,0"/>
       <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center"/>
      </StackPanel>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="c:Ui.Icon" Value="{x:Null}"><Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="{DynamicResource AccentFillBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource AccentFillBrush}"/>
  <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
       <c:Glyph x:Name="Icon" Kind="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" Margin="-2,0,7,0"/>
       <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.FontWeight="SemiBold"/>
      </StackPanel>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="c:Ui.Icon" Value="{x:Null}"><Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentHoverBrush}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource TextBrush}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Borderless button for secondary and inline actions. -->
 <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="Padding" Value="8,4"/>
 </Style>
 <!-- Square icon-only button. Put the glyph kind in c:Ui.Icon and a ToolTip on the button. -->
 <Style x:Key="IconButton" TargetType="ButtonBase">
  <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Width" Value="28"/>
  <Setter Property="Height" Value="28"/>
  <Setter Property="Margin" Value="1,0"/>
  <Setter Property="Padding" Value="0"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ButtonBase">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6">
      <Grid>
       <c:Glyph Kind="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger>
      <Trigger Property="ToggleButton.IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <!-- Ghost button with optional glyph, used in toolbars and pane headers. -->
 <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="BorderBrush" Value="Transparent"/>
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="Padding" Value="8,0"/>
  <Setter Property="Height" Value="28"/>
  <Setter Property="MinHeight" Value="0"/>
  <Setter Property="Margin" Value="1,0"/>
 </Style>
 <!-- Toolbar toggle (CheckBox or ToggleButton) rendered as a chip: a glyph from c:Ui.Icon and an optional short label. -->
 <Style x:Key="ToolbarToggle" TargetType="ToggleButton">
  <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
  <Setter Property="Background" Value="Transparent"/>
  <Setter Property="Height" Value="28"/>
  <Setter Property="Margin" Value="1,0"/>
  <Setter Property="Padding" Value="7,0,9,0"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="VerticalAlignment" Value="Center"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
   <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <c:Glyph x:Name="Icon" Kind="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16"/>
     <ContentPresenter x:Name="Label" Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </StackPanel>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="Content" Value="{x:Null}"><Setter TargetName="Label" Property="Visibility" Value="Collapsed"/><Setter Property="Padding" Value="6,0"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Trigger>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <!-- Selectable tile (theme picker, segmented choices). -->
 <Style x:Key="ChoiceTile" TargetType="RadioButton">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="Background" Value="{DynamicResource EditorBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
  <Setter Property="Padding" Value="12,10"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="RadioButton">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
      <ContentPresenter/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Chrome" Property="BorderThickness" Value="2"/><Setter TargetName="Chrome" Property="Padding" Value="11,9"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- ================================================================ Text inputs -->
 <Style TargetType="TextBox">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="Background" Value="{DynamicResource EditorBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="7,5"/>
  <Setter Property="MinHeight" Value="28"/>
  <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
  <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillBrush}"/>
  <Setter Property="SelectionOpacity" Value="0.45"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="TextBox">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
      <Grid>
       <TextBlock x:Name="Hint" Text="{Binding (c:Ui.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" Foreground="{DynamicResource SubtleBrush}" Margin="{TemplateBinding Padding}" Padding="2,0,0,0"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
       <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
      </Grid>
     </Border>
     <ControlTemplate.Triggers>
      <MultiTrigger>
       <MultiTrigger.Conditions>
        <Condition Property="Text" Value=""/>
        <Condition Property="IsKeyboardFocused" Value="False"/>
       </MultiTrigger.Conditions>
       <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
      </MultiTrigger>
      <MultiTrigger>
       <MultiTrigger.Conditions>
        <Condition Property="IsMouseOver" Value="True"/>
        <Condition Property="IsReadOnly" Value="False"/>
       </MultiTrigger.Conditions>
       <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SubtleBrush}"/>
      </MultiTrigger>
      <MultiTrigger>
       <MultiTrigger.Conditions>
        <Condition Property="IsKeyboardFocused" Value="True"/>
        <Condition Property="IsReadOnly" Value="False"/>
       </MultiTrigger.Conditions>
       <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      </MultiTrigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
      <!-- Multi-line text starts at the top and its scroll bars sit at the box edges,
           not directly under the last line of a short text. -->
      <Trigger Property="AcceptsReturn" Value="True"><Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="PasswordBox">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="Background" Value="{DynamicResource EditorBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="7,5"/>
  <Setter Property="MinHeight" Value="28"/>
  <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
  <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillBrush}"/>
  <Setter Property="VerticalContentAlignment" Value="Center"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="PasswordBox">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SubtleBrush}"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>

 <!-- ================================================================ ComboBox -->
 <Style x:Key="ComboToggle" TargetType="ToggleButton">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
      <c:Glyph Kind="ChevronDown" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ComboBox">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="Background" Value="{DynamicResource EditorBrush}"/>
  <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}"/>
  <Setter Property="BorderThickness" Value="1"/>
  <Setter Property="Padding" Value="9,4,28,4"/>
  <Setter Property="MinHeight" Value="28"/>
  <Setter Property="Margin" Value="2"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
  <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBox">
     <Grid SnapsToDevicePixels="True">
      <ToggleButton x:Name="Toggle" Style="{StaticResource ComboToggle}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
      <ContentPresenter x:Name="Selection" Margin="{TemplateBinding Padding}" IsHitTestVisible="False" VerticalAlignment="Center"
                        Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                        TextElement.Foreground="{TemplateBinding Foreground}">
       <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></ContentPresenter.Resources>
      </ContentPresenter>
      <TextBlock x:Name="Hint" Text="{Binding (c:Ui.Placeholder), RelativeSource={RelativeSource TemplatedParent}}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" Foreground="{DynamicResource SubtleBrush}" IsHitTestVisible="False" Visibility="Collapsed" TextTrimming="CharacterEllipsis"/>
      <TextBox x:Name="PART_EditableTextBox" Visibility="Hidden" Background="Transparent" BorderThickness="0" MinHeight="0" Padding="0" Margin="8,1,26,1" VerticalContentAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}" Foreground="{TemplateBinding Foreground}"/>
      <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="2" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
       <Border Margin="0,0,16,16">
        <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4"
                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}" Effect="{StaticResource PopupShadow}">
         <ScrollViewer CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
         </ScrollViewer>
        </Border>
       </Border>
      </Popup>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="IsEditable" Value="True">
       <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
       <Setter TargetName="Selection" Property="Visibility" Value="Hidden"/>
      </Trigger>
      <MultiTrigger>
       <MultiTrigger.Conditions><Condition Property="SelectedItem" Value="{x:Null}"/><Condition Property="IsEditable" Value="False"/></MultiTrigger.Conditions>
       <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
      </MultiTrigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Toggle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value>
  </Setter>
 </Style>
 <Style TargetType="ComboBoxItem">
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  <Setter Property="Padding" Value="8,5"/>
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  <Setter Property="Template">
   <Setter.Value>
    <ControlTemplate TargetType="ComboBoxItem">
