       <TextBox.Text>
        <Binding Path="SearchPattern" RelativeSource="{RelativeSource TemplatedParent}" UpdateSourceTrigger="PropertyChanged">
         <Binding.ValidationRules><ExceptionValidationRule/></Binding.ValidationRules>
        </Binding>
       </TextBox.Text>
      </TextBox>
      <c:Glyph Kind="Search" Width="13" Height="13" HorizontalAlignment="Left" Margin="8,0,0,0" Foreground="{DynamicResource SubtleBrush}" IsHitTestVisible="False"/>
      <Popup Name="PART_dropdownPopup" StaysOpen="False"/>
     </Grid>
     <ToggleButton Style="{StaticResource IconButton}" Width="26" Height="26" Margin="4,0,0,0" IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{Binding Localization.MatchCaseText, RelativeSource={RelativeSource TemplatedParent}}">
      <TextBlock Text="Aa" FontSize="11.5" FontWeight="SemiBold"/>
     </ToggleButton>
     <ToggleButton Style="{StaticResource IconButton}" Width="26" Height="26" IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{Binding Localization.MatchWholeWordsText, RelativeSource={RelativeSource TemplatedParent}}">
      <TextBlock Text="ab" FontSize="11.5" FontWeight="SemiBold" TextDecorations="Underline"/>
     </ToggleButton>
     <ToggleButton Style="{StaticResource IconButton}" Width="26" Height="26" IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}" ToolTip="{Binding Localization.UseRegexText, RelativeSource={RelativeSource TemplatedParent}}">
      <TextBlock Text=".*" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource CodeFont}"/>
     </ToggleButton>
     <Border Width="1" Margin="4,5" Background="{DynamicResource BorderBrush}"/>
     <Button Style="{StaticResource IconButton}" Width="26" Height="26" Command="search:SearchCommands.FindPrevious" ToolTip="{Binding Localization.FindPreviousText, RelativeSource={RelativeSource TemplatedParent}}">
      <c:Glyph Kind="ChevronDown" Width="14" Height="14" RenderTransformOrigin="0.5,0.5"><c:Glyph.RenderTransform><RotateTransform Angle="180"/></c:Glyph.RenderTransform></c:Glyph>
     </Button>
     <Button Style="{StaticResource IconButton}" Width="26" Height="26" Command="search:SearchCommands.FindNext" ToolTip="{Binding Localization.FindNextText, RelativeSource={RelativeSource TemplatedParent}}">
      <c:Glyph Kind="ChevronDown" Width="14" Height="14"/>
     </Button>
     <Button Style="{StaticResource IconButton}" Width="26" Height="26" c:Ui.Icon="Close" Command="search:SearchCommands.CloseSearchPanel" Focusable="False" ToolTip="Close (Esc)"/>
    </StackPanel>
   </Border>
  </ControlTemplate></Setter.Value></Setter>
 </Style>

 <!-- ================================================================ Progress -->
 <!-- Thin indeterminate bar: a highlight sweeps across the track. -->
 <Style x:Key="ActivityBar" TargetType="ProgressBar">
  <Setter Property="Height" Value="2"/>
  <Setter Property="IsIndeterminate" Value="True"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
   <Border x:Name="Track" Background="Transparent" ClipToBounds="True">
    <Rectangle x:Name="Sweep" Fill="{DynamicResource AccentBrush}">
     <Rectangle.OpacityMask>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
       <GradientStop Color="Transparent" Offset="-0.3"/>
       <GradientStop Color="Black" Offset="-0.15"/>
       <GradientStop Color="Transparent" Offset="0"/>
      </LinearGradientBrush>
     </Rectangle.OpacityMask>
    </Rectangle>
   </Border>
   <ControlTemplate.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
     <BeginStoryboard>
      <Storyboard RepeatBehavior="Forever">
       <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="(UIElement.OpacityMask).(GradientBrush.GradientStops)[0].(GradientStop.Offset)" From="-0.3" To="1.0" Duration="0:0:1.4"/>
       <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="(UIElement.OpacityMask).(GradientBrush.GradientStops)[1].(GradientStop.Offset)" From="-0.15" To="1.15" Duration="0:0:1.4"/>
       <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="(UIElement.OpacityMask).(GradientBrush.GradientStops)[2].(GradientStop.Offset)" From="0" To="1.3" Duration="0:0:1.4"/>
      </Storyboard>
     </BeginStoryboard>
    </EventTrigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
