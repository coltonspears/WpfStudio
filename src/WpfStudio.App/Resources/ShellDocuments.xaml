<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
                    xmlns:vm="clr-namespace:WpfStudio.App.ViewModels"
                    xmlns:controls="clr-namespace:WpfStudio.App.Controls"
                    xmlns:c="clr-namespace:WpfStudio.App.Controls"
                    xmlns:b="clr-namespace:WpfStudio.App.Behaviors"
                    xmlns:packages="clr-namespace:WpfStudio.App.Features.Packages"
                    xmlns:git="clr-namespace:WpfStudio.App.Features.Git"
                    xmlns:profiling="clr-namespace:WpfStudio.App.Features.Profiling"
                    xmlns:designer="clr-namespace:WpfStudio.App.Features.Designer"
                    xmlns:inspection="clr-namespace:WpfStudio.App.Features.Inspection">
  <!-- Editor documents: context bar with breadcrumb, related files and MVVM actions. -->
  <Style x:Key="ContextChip" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <DataTemplate DataType="{x:Type vm:EditorViewModel}">
    <DockPanel Background="{DynamicResource EditorBrush}">
      <Border DockPanel.Dock="Top" Height="30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0,8,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Project" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Visibility="{Binding HasXamlProjects, Converter={StaticResource BooleanToVisibility}}" />
            <ComboBox ItemsSource="{Binding XamlProjects}" SelectedItem="{Binding XamlProject}" DisplayMemberPath="Name"
                      Width="160" Height="24" FontSize="11" Padding="6,0" Margin="0,0,6,0"
                      Visibility="{Binding HasXamlProjects, Converter={StaticResource BooleanToVisibility}}"
                      AutomationProperties.Name="XAML project context" ToolTip="Choose the project whose types are used for XAML completion, diagnostics and navigation." />
            <ItemsControl ItemsSource="{Binding RelatedFiles}" ItemsPanel="{StaticResource HorizontalItems}" Focusable="False">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ContextChip}" Command="{Binding DataContext.OpenRelatedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding Path}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Role}" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                      <c:StudioIcon Kind="{Binding IconKind}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Width="1" Margin="6,7" Background="{DynamicResource BorderBrush}" Visibility="{Binding IsViewModel, Converter={StaticResource BooleanToVisibility}}" />
            <Button Style="{StaticResource ContextChip}" c:Ui.Icon="Plus" Content="Property" ToolTip="Insert an [ObservableProperty]" Command="{Binding ActionCommand}" CommandParameter="{x:Static vm:EditorAction.InsertProperty}" Visibility="{Binding IsViewModel, Converter={StaticResource BooleanToVisibility}}" />
            <Button Style="{StaticResource ContextChip}" c:Ui.Icon="Plus" Content="Command" ToolTip="Insert a [RelayCommand]" Command="{Binding ActionCommand}" CommandParameter="{x:Static vm:EditorAction.InsertCommand}" Visibility="{Binding IsViewModel, Converter={StaticResource BooleanToVisibility}}" />
            <Button Style="{StaticResource ContextChip}" Content="Preview" ToolTip="Open XAML Designer" Command="{Binding ActionCommand}" CommandParameter="{x:Static vm:EditorAction.OpenDesigner}" Visibility="{Binding IsXaml, Converter={StaticResource BooleanToVisibility}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{Binding Location}" Foreground="{DynamicResource SubtleBrush}" FontSize="11.5" VerticalAlignment="Center" />
            <TextBlock Text="  ›  " Foreground="{DynamicResource SubtleBrush}" FontSize="11.5" VerticalAlignment="Center" Visibility="{Binding Location, Converter={StaticResource Presence}}" />
            <c:StudioIcon Kind="{Binding IconKind}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center" />
            <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource RaisedBrush}">
              <TextBlock Text="{Binding KindLabel}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
            </Border>
          </StackPanel>
        </DockPanel>
      </Border>
      <controls:EditorSurface ContextMenu="{StaticResource EditorContextMenu}" ViewModel="{Binding}" Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource TextBrush}" LineNumbersForeground="{DynamicResource GutterTextBrush}" FontFamily="Cascadia Code, Cascadia Mono, Consolas" FontSize="13" />
    </DockPanel>
  </DataTemplate>
  <!-- Retained panes: DockingBehavior instantiates each once and keeps the view across layout changes. -->
  <DataTemplate DataType="{x:Type packages:PackagesViewModel}"><packages:PackagesPane /></DataTemplate>
  <DataTemplate DataType="{x:Type git:GitViewModel}"><git:GitPane /></DataTemplate>
  <DataTemplate DataType="{x:Type profiling:MemoryProfilerViewModel}"><profiling:MemoryProfilerPane /></DataTemplate>
  <DataTemplate DataType="{x:Type designer:DesignerViewModel}"><designer:DesignerPane /></DataTemplate>
  <DataTemplate DataType="{x:Type inspection:InspectionViewModel}"><inspection:InspectionPane /></DataTemplate>
  <Style x:Key="DocumentContainer" TargetType="dc:LayoutDocumentItem">
    <Setter Property="Title" Value="{Binding Model.Title, RelativeSource={RelativeSource Self}}" />
    <Setter Property="ContentId" Value="{Binding Model.ContentId, RelativeSource={RelativeSource Self}}" />
  </Style>
  <b:DocumentDockStyleSelector x:Key="DocumentStyles" DocumentStyle="{StaticResource DocumentContainer}" />
</ResourceDictionary>
