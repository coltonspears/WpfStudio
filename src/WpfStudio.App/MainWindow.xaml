<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WpfStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:dc="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        xmlns:vm="clr-namespace:WpfStudio.App.ViewModels"
        xmlns:views="clr-namespace:WpfStudio.App.Views"
        xmlns:ai="clr-namespace:WpfStudio.App.Features.ColtonGpt"
        xmlns:controls="clr-namespace:WpfStudio.App.Controls"
        xmlns:c="clr-namespace:WpfStudio.App.Controls"
        xmlns:b="clr-namespace:WpfStudio.App.Behaviors"
        xmlns:term="clr-namespace:WpfStudio.Runtime.Terminal;assembly=WpfStudio.Runtime"
        xmlns:debug="clr-namespace:WpfStudio.Runtime.Debugging;assembly=WpfStudio.Runtime"
        xmlns:sql="clr-namespace:WpfStudio.Database.Views;assembly=WpfStudio.Database"
        Title="{Binding WindowTitle}" Icon="/WpfStudio;component/Resources/WpfStudio.ico"
        Width="1480" Height="940" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen"
        b:Interaction.CloseGuard="{Binding}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <c:ScaffoldKindTextConverter x:Key="ScaffoldText" />

    <!-- Editor documents: context bar with breadcrumb, related files and MVVM actions. -->
    <Style x:Key="ContextChip" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
      </Style.Triggers>
    </Style>
    <DataTemplate DataType="{x:Type vm:EditorViewModel}">
      <DockPanel Background="{DynamicResource EditorBrush}">
        <Border DockPanel.Dock="Top" Height="30" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0,8,0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Project" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0" Visibility="{Binding HasXamlProjects, Converter={StaticResource BooleanToVisibility}}" />
              <ComboBox ItemsSource="{Binding XamlProjects}" SelectedItem="{Binding XamlProject}" DisplayMemberPath="Name"
                        Width="160" Height="24" FontSize="11" Padding="6,0" Margin="0,0,6,0"
                        Visibility="{Binding HasXamlProjects, Converter={StaticResource BooleanToVisibility}}"
                        AutomationProperties.Name="XAML project context" ToolTip="Choose the project whose types are used for XAML completion, diagnostics and navigation." />
              <ItemsControl ItemsSource="{Binding RelatedFiles}" ItemsPanel="{StaticResource HorizontalItems}" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ContextChip}" Command="{Binding DataContext.OpenRelatedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding Path}">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Role}" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <c:StudioIcon Kind="{Binding IconKind}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Width="1" Margin="6,7" Background="{DynamicResource BorderBrush}" Visibility="{Binding IsViewModel, Converter={StaticResource BooleanToVisibility}}" />
              <Button Style="{StaticResource ContextChip}" c:Ui.Icon="Plus" Content="Property" ToolTip="Insert an [ObservableProperty]" Command="{Binding ActionCommand}" CommandParameter="{x:Static vm:EditorAction.InsertProperty}" Visibility="{Binding IsViewModel, Converter={StaticResource BooleanToVisibility}}" />
              <Button Style="{StaticResource ContextChip}" c:Ui.Icon="Plus" Content="Command" ToolTip="Insert a [RelayCommand]" Command="{Binding ActionCommand}" CommandParameter="{x:Static vm:EditorAction.InsertCommand}" Visibility="{Binding IsViewModel, Converter={StaticResource BooleanToVisibility}}" />
              <Button Style="{StaticResource ContextChip}" Content="Preview" ToolTip="Open XAML Designer" Command="{Binding ActionCommand}" CommandParameter="{x:Static vm:EditorAction.OpenDesigner}" Visibility="{Binding IsXaml, Converter={StaticResource BooleanToVisibility}}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding Location}" Foreground="{DynamicResource SubtleBrush}" FontSize="11.5" VerticalAlignment="Center" />
              <TextBlock Text="  ›  " Foreground="{DynamicResource SubtleBrush}" FontSize="11.5" VerticalAlignment="Center" Visibility="{Binding Location, Converter={StaticResource Presence}}" />
              <c:StudioIcon Kind="{Binding IconKind}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding FileName}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" VerticalAlignment="Center" />
              <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource RaisedBrush}">
                <TextBlock Text="{Binding KindLabel}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" />
              </Border>
            </StackPanel>
          </DockPanel>
        </Border>
        <controls:EditorSurface ContextMenu="{StaticResource EditorContextMenu}" ViewModel="{Binding}" Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource TextBrush}" LineNumbersForeground="{DynamicResource GutterTextBrush}" FontFamily="Cascadia Code, Cascadia Mono, Consolas" FontSize="13" />
      </DockPanel>
    </DataTemplate>
    <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal">
        <controls:StudioIcon Kind="{Binding IconKind}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" VerticalAlignment="Center" />
      </StackPanel>
    </HierarchicalDataTemplate>
    <Style x:Key="DocumentContainer" TargetType="dc:LayoutDocumentItem">
      <Setter Property="Title" Value="{Binding Model.Title, RelativeSource={RelativeSource Self}}" />
      <Setter Property="ContentId" Value="{Binding Model.ContentId, RelativeSource={RelativeSource Self}}" />
    </Style>
    <b:DocumentDockStyleSelector x:Key="DocumentStyles" DocumentStyle="{StaticResource DocumentContainer}" />

    <!-- Window caption buttons (Segoe Fluent Icons, falling back to MDL2 on Windows 10). -->
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextRenderingMode="Grayscale" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
              <Trigger Property="c:Ui.IsChromeHover" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}" /></Trigger>
              <Trigger Property="c:Ui.IsChromePressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PressedBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
          <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextOptions.TextRenderingMode="Grayscale" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="White" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#A32619" /><Setter Property="Foreground" Value="White" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- The command center in the title bar opens quick open. -->
    <Style x:Key="CommandCenterButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,0,4,0">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SubtleBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ToolbarDivider" TargetType="Border">
      <Setter Property="Width" Value="1" />
      <Setter Property="Margin" Value="8,7" />
      <Setter Property="Background" Value="{DynamicResource StrongBorderBrush}" />
    </Style>
    <Style x:Key="StatusButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="Height" Value="22" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=DockPanel}}" />
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Margin" Value="8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Start page action row: icon, title, description and shortcut. -->
    <Style x:Key="StartAction" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="IconWell" Width="32" Height="32" CornerRadius="7" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                  <c:Glyph Kind="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <ContentPresenter TextElement.FontWeight="SemiBold" />
                  <TextBlock Text="{TemplateBinding ToolTip}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ItemsControl Grid.Column="2" Style="{StaticResource KeyCaps}" ItemsSource="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToKeyCaps}}" Margin="12,0,0,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter TargetName="IconWell" Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ToolTipService.IsEnabled" Value="False" />
    </Style>
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding QuickOpenCommand}" />
    <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding CommandPaletteCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
    <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenWorkspaceCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}" />
    <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseActiveCommand}" />
    <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding BuildCommand}" />
    <KeyBinding Key="F5" Command="{Binding DebugCommand}" />
    <KeyBinding Key="F5" Modifiers="Control" Command="{Binding RunCommand}" />
    <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding Debugger.StopCommand}" />
    <KeyBinding Key="F7" Command="{Binding SwitchRelatedCommand}" />
    <KeyBinding Key="F9" Command="{Binding ToggleBreakpointCommand}" />
    <KeyBinding Key="F10" Command="{Binding Debugger.StepOverCommand}" />
    <KeyBinding Key="F11" Command="{Binding Debugger.StepIntoCommand}" />
    <KeyBinding Key="F11" Modifiers="Shift" Command="{Binding Debugger.StepOutCommand}" />
    <KeyBinding Key="F12" Command="{Binding GoToDefinitionCommand}" />
    <KeyBinding Key="F12" Modifiers="Shift" Command="{Binding FindReferencesCommand}" />
    <KeyBinding Key="F2" Command="{Binding RenameSymbolCommand}" />
    <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding FormatCommand}" />
    <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewWpfItemCommand}" />
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Key="Oem3" Modifiers="Control" Command="{Binding ShowToolCommand}" CommandParameter="Terminal" />
  </Window.InputBindings>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <!-- ============================================================ Title bar -->
    <Grid Background="{DynamicResource WindowBrush}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal">
        <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource AccentFillBrush}" Margin="14,0,8,0" VerticalAlignment="Center" ToolTip="WpfStudio">
          <c:Glyph Kind="Window" Width="15" Height="15" Foreground="White" StrokeWeight="1.6" />
        </Border>
        <Menu x:Name="MainMenu" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
          <MenuItem Header="_File">
            <MenuItem Header="New WPF item…" c:Ui.Icon="NewFile" Command="{Binding NewWpfItemCommand}" InputGestureText="Ctrl+Shift+N" />
            <Separator />
            <MenuItem Header="Open solution or project…" c:Ui.Icon="FolderOpen" Command="{Binding OpenWorkspaceCommand}" InputGestureText="Ctrl+Shift+O" />
            <MenuItem Header="Open file…" c:Ui.Icon="File" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
            <MenuItem Header="Open recent" c:Ui.Icon="Clock" ItemsSource="{Binding RecentWorkspaces}">
              <MenuItem.Style>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding RecentWorkspaces.Count}" Value="0"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </MenuItem.Style>
              <MenuItem.ItemContainerStyle>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                  <Setter Property="Header" Value="{Binding Converter={StaticResource FileStem}}" />
                  <Setter Property="InputGestureText" Value="{Binding Converter={StaticResource ExtensionLabel}}" />
                  <Setter Property="ToolTip" Value="{Binding}" />
                  <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                  <Setter Property="CommandParameter" Value="{Binding}" />
                </Style>
              </MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator />
            <MenuItem Header="Save" c:Ui.Icon="Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
            <MenuItem Header="Save all" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
            <MenuItem Header="Reload from disk" Command="{Binding ReloadDocumentCommand}" />
            <Separator />
            <MenuItem Header="Close document" Command="{Binding CloseActiveCommand}" InputGestureText="Ctrl+W" />
            <MenuItem Header="Exit" Command="{x:Static SystemCommands.CloseWindowCommand}" InputGestureText="Alt+F4" />
          </MenuItem>
          <MenuItem Header="_Edit">
            <MenuItem Header="Undo" Command="ApplicationCommands.Undo" InputGestureText="Ctrl+Z" />
            <MenuItem Header="Redo" Command="ApplicationCommands.Redo" InputGestureText="Ctrl+Y" />
            <Separator />
            <MenuItem Header="Cut" Command="ApplicationCommands.Cut" InputGestureText="Ctrl+X" />
            <MenuItem Header="Copy" Command="ApplicationCommands.Copy" InputGestureText="Ctrl+C" />
            <MenuItem Header="Paste" Command="ApplicationCommands.Paste" InputGestureText="Ctrl+V" />
            <MenuItem Header="Select all" Command="ApplicationCommands.SelectAll" InputGestureText="Ctrl+A" />
            <Separator />
            <MenuItem Header="Find in file…" c:Ui.Icon="Search" Command="ApplicationCommands.Find" InputGestureText="Ctrl+F" />
            <MenuItem Header="Find in workspace…" Command="{Binding FindInWorkspaceCommand}" />
            <Separator />
            <MenuItem Header="Undo last workspace edit" Command="{Binding UndoWorkspaceEditCommand}" />
          </MenuItem>
          <MenuItem Header="_View">
            <MenuItem Header="Command palette…" c:Ui.Icon="Command" Command="{Binding CommandPaletteCommand}" InputGestureText="Ctrl+Shift+P" />
            <MenuItem Header="Go to file…" c:Ui.Icon="Search" Command="{Binding QuickOpenCommand}" InputGestureText="Ctrl+P" />
            <Separator />
            <MenuItem Header="Solution Explorer" c:Ui.Icon="Folder" Command="{Binding ShowToolCommand}" CommandParameter="Explorer" />
            <MenuItem Header="WPF Explorer" c:Ui.Icon="Layers" Command="{Binding ShowToolCommand}" CommandParameter="WpfTools" />
            <MenuItem Header="XAML Designer" c:Ui.Icon="Layers" Command="{Binding OpenDesignerCommand}" />
            <MenuItem Header="Live XAML" c:Ui.Icon="Layers" Command="{Binding ShowToolCommand}" CommandParameter="LiveInspection" />
            <MenuItem Header="ColtonGPT" c:Ui.Icon="Chat" Command="{Binding OpenAssistantCommand}" />
            <Separator />
            <MenuItem Header="Output" c:Ui.Icon="Output" Command="{Binding ShowToolCommand}" CommandParameter="Output" />
            <MenuItem Header="Problems" c:Ui.Icon="Warning" Command="{Binding ShowToolCommand}" CommandParameter="Problems" />
            <MenuItem Header="Search results" Command="{Binding ShowToolCommand}" CommandParameter="Search" />
            <MenuItem Header="Terminal" c:Ui.Icon="Terminal" Command="{Binding ShowToolCommand}" CommandParameter="Terminal" InputGestureText="Ctrl+`" />
            <MenuItem Header="Debugger" c:Ui.Icon="Bug" Command="{Binding ShowToolCommand}" CommandParameter="Debugger" />
            <MenuItem Header="SQL Server" c:Ui.Icon="Database" Command="{Binding ShowToolCommand}" CommandParameter="Database" />
            <Separator />
            <MenuItem Header="Theme">
              <MenuItem Header="Dark" IsCheckable="False" IsChecked="{Binding IsDarkTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
              <MenuItem Header="Light" IsCheckable="False" IsChecked="{Binding IsLightTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
            </MenuItem>
            <MenuItem Header="Layout">
              <MenuItem Header="Save current layout" Command="{Binding SaveLayoutCommand}" />
              <MenuItem Header="Reset to default layout" Command="{Binding ResetLayoutCommand}" />
            </MenuItem>
          </MenuItem>
          <MenuItem Header="_Code">
            <MenuItem Header="Go to definition" c:Ui.Icon="Target" Command="{Binding GoToDefinitionCommand}" InputGestureText="F12" />
            <MenuItem Header="Find references" Command="{Binding FindReferencesCommand}" InputGestureText="Shift+F12" />
            <Separator />
            <MenuItem Header="Rename symbol…" Command="{Binding RenameSymbolCommand}" InputGestureText="F2" />
            <MenuItem Header="Organize usings…" Command="{Binding RefactorCommand}" CommandParameter="OrganizeUsings" />
            <MenuItem Header="Use var…" Command="{Binding RefactorCommand}" CommandParameter="UseVar" />
            <MenuItem Header="Use explicit type…" Command="{Binding RefactorCommand}" CommandParameter="UseExplicitType" />
            <Separator />
            <MenuItem Header="Format document" c:Ui.Icon="Braces" Command="{Binding FormatCommand}" InputGestureText="Ctrl+Shift+F" />
          </MenuItem>
          <MenuItem Header="_WPF">
            <MenuItem Header="New WPF item…" c:Ui.Icon="NewFile" Command="{Binding NewWpfItemCommand}" InputGestureText="Ctrl+Shift+N" />
            <MenuItem Header="Switch view ⇄ view model" c:Ui.Icon="Swap" Command="{Binding SwitchRelatedCommand}" InputGestureText="F7" />
            <Separator />
            <MenuItem Header="Insert observable property…" c:Ui.Icon="Plus" Command="{Binding InsertPropertyCommand}" />
            <MenuItem Header="Insert relay command…" c:Ui.Icon="Plus" Command="{Binding InsertCommandCommand}" />
            <Separator />
            <MenuItem Header="Rename resource key…" c:Ui.Icon="Tag" Command="{Binding RenameResourceCommand}" />
            <MenuItem Header="Assets" c:Ui.Icon="Image">
              <MenuItem Header="Import asset…" Command="{Binding ImportAssetCommand}" />
              <MenuItem Header="Show pack URI" Command="{Binding ShowPackUriCommand}" />
            </MenuItem>
            <MenuItem Header="Refresh WPF index" c:Ui.Icon="Refresh" Command="{Binding RefreshWpfCommand}" />
          </MenuItem>
          <MenuItem Header="_Build">
            <MenuItem Header="Build" c:Ui.Icon="Build" Command="{Binding BuildCommand}" InputGestureText="Ctrl+Shift+B" />
            <MenuItem Header="Rebuild" Command="{Binding RebuildCommand}" />
            <MenuItem Header="Clean" Command="{Binding CleanCommand}" />
            <MenuItem Header="Restore packages" Command="{Binding RestoreCommand}" />
            <Separator />
            <MenuItem Header="Run tests" c:Ui.Icon="Flask" Command="{Binding TestCommand}" />
            <Separator />
            <MenuItem Header="Cancel running operation" c:Ui.Icon="Stop" Command="{Binding CancelOperationCommand}" />
          </MenuItem>
          <MenuItem Header="_Debug">
            <MenuItem Header="Start / continue" c:Ui.Icon="Play" Command="{Binding DebugCommand}" InputGestureText="F5" />
            <MenuItem Header="Run without debugging" c:Ui.Icon="PlayOutline" Command="{Binding RunCommand}" InputGestureText="Ctrl+F5" />
            <MenuItem Header="Run with XAML inspection" Command="{Binding RunWithInspectionCommand}" />
            <MenuItem Header="Debug with XAML inspection" Command="{Binding DebugWithInspectionCommand}" />
            <MenuItem Header="Attach to process…" c:Ui.Icon="Plug" Command="{Binding ShowToolCommand}" CommandParameter="Debugger" />
            <Separator />
            <MenuItem Header="Pause" c:Ui.Icon="Pause" Command="{Binding Debugger.PauseCommand}" />
            <MenuItem Header="Stop debugging" c:Ui.Icon="Stop" Command="{Binding Debugger.StopCommand}" InputGestureText="Shift+F5" />
            <MenuItem Header="Detach" Command="{Binding Debugger.DetachCommand}" />
            <Separator />
            <MenuItem Header="Step over" c:Ui.Icon="StepOver" Command="{Binding Debugger.StepOverCommand}" InputGestureText="F10" />
            <MenuItem Header="Step into" c:Ui.Icon="StepInto" Command="{Binding Debugger.StepIntoCommand}" InputGestureText="F11" />
            <MenuItem Header="Step out" c:Ui.Icon="StepOut" Command="{Binding Debugger.StepOutCommand}" InputGestureText="Shift+F11" />
            <Separator />
            <MenuItem Header="Toggle breakpoint" Command="{Binding ToggleBreakpointCommand}" InputGestureText="F9" />
            <MenuItem Header="Breakpoint condition…" Command="{Binding BreakpointConditionCommand}" />
            <MenuItem Header="Show breakpoints" Command="{Binding ShowBreakpointsCommand}" />
          </MenuItem>
          <MenuItem Header="_Tools">
            <MenuItem Header="NuGet packages…" c:Ui.Icon="Package" Command="{Binding OpenPackagesCommand}" />
            <MenuItem Header="Git changes…" c:Ui.Icon="Git" Command="{Binding OpenGitCommand}" />
            <MenuItem Header="Memory profiler…" c:Ui.Icon="Layers" Command="{Binding ShowToolCommand}" CommandParameter="Profiler" />
            <Separator />
            <MenuItem Header="Reload workspace" c:Ui.Icon="Refresh" Command="{Binding ReloadWorkspaceCommand}" />
            <MenuItem Header="Restart language service" c:Ui.Icon="Restart" Command="{Binding RestartWorkspaceCommand}" />
            <Separator />
            <MenuItem Header="Settings…" c:Ui.Icon="Settings" Command="{Binding OpenSettingsCommand}" InputGestureText="Ctrl+," />
          </MenuItem>
          <MenuItem Header="_Help">
            <MenuItem Header="All commands and shortcuts…" c:Ui.Icon="Keyboard" Command="{Binding ShowShortcutsCommand}" />
            <MenuItem Header="Open data folder" c:Ui.Icon="FolderOpen" Command="{Binding OpenDataFolderCommand}" />
          </MenuItem>
        </Menu>
      </StackPanel>

      <Button Grid.Column="1" Style="{StaticResource CommandCenterButton}" Command="{Binding QuickOpenCommand}" HorizontalAlignment="Center" MinWidth="220" MaxWidth="460" Width="440" Margin="16,0" ToolTip="Go to file (Ctrl+P) · Commands (Ctrl+Shift+P)">
        <DockPanel>
          <ItemsControl DockPanel.Dock="Right" Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='Ctrl+P', Converter={StaticResource ToKeyCaps}}" />
          <c:Glyph Kind="Search" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CommandCenterText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Button>

      <StackPanel Grid.Column="2" Orientation="Horizontal">
        <Button WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding ToggleThemeCommand}" ToolTip="Switch between dark and light" VerticalAlignment="Center">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
              <Setter Property="c:Ui.Icon" Value="Sun" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsLightTheme}" Value="True"><Setter Property="c:Ui.Icon" Value="Moon" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button Style="{StaticResource IconButton}" c:Ui.Icon="Settings" WindowChrome.IsHitTestVisibleInChrome="True" Command="{Binding OpenSettingsCommand}" ToolTip="Settings (Ctrl+,)" VerticalAlignment="Center" Margin="1,0,10,0" />
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" Command="{x:Static SystemCommands.MinimizeWindowCommand}" ToolTip="Minimize" />
        <Button x:Name="MaximizeButton" Command="{x:Static SystemCommands.MaximizeWindowCommand}" ToolTip="Maximize">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
              <Setter Property="Content" Value="&#xE922;" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized"><Setter Property="Content" Value="&#xE923;" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Content="&#xE8BB;" Command="{x:Static SystemCommands.CloseWindowCommand}" ToolTip="Close" />
      </StackPanel>
    </Grid>

    <!-- ============================================================ Run toolbar -->
    <Border Grid.Row="1" Background="{DynamicResource WindowBrush}" Padding="10,0,10,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource ToolbarButton}" c:Ui.Icon="NewFile" Content="New item" Command="{Binding NewWpfItemCommand}" ToolTip="New WPF item: view + view model, control, dictionary or converter (Ctrl+Shift+N)" />
          <Button Style="{StaticResource ToolbarButton}" c:Ui.Icon="Swap" Content="View ⇄ VM" Command="{Binding SwitchRelatedCommand}" ToolTip="Jump between a view, its code-behind and its view model (F7)" />
          <Border Style="{StaticResource ToolbarDivider}" />
          <Button Style="{StaticResource IconButton}" c:Ui.Icon="Layers" Command="{Binding ShowToolCommand}" CommandParameter="WpfTools" ToolTip="WPF Explorer" />
          <Button Style="{StaticResource IconButton}" c:Ui.Icon="Git" Command="{Binding OpenGitCommand}" ToolTip="Git changes" />
          <Button Style="{StaticResource IconButton}" c:Ui.Icon="Package" Command="{Binding OpenPackagesCommand}" ToolTip="NuGet packages" />
          <Button Style="{StaticResource IconButton}" c:Ui.Icon="Database" Command="{Binding ShowToolCommand}" CommandParameter="Database" ToolTip="SQL Server" />
          <Button Style="{StaticResource IconButton}" c:Ui.Icon="Terminal" Command="{Binding ShowToolCommand}" CommandParameter="Terminal" ToolTip="Terminal (Ctrl+`)" />
          <Button Style="{StaticResource IconButton}" c:Ui.Icon="Chat" Command="{Binding OpenAssistantCommand}" ToolTip="ColtonGPT" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="7" Height="30" Padding="2,0">
            <StackPanel Orientation="Horizontal">
              <c:StudioIcon Kind="Project" Width="15" Height="15" Margin="7,0,0,0" VerticalAlignment="Center" />
              <ComboBox Style="{StaticResource ToolbarCombo}" Width="176" ItemsSource="{Binding Projects}" SelectedItem="{Binding StartupProject}" DisplayMemberPath="Name" ToolTip="Startup project" c:Ui.Placeholder="No startup project" />
              <Border Style="{StaticResource ToolbarDivider}" Margin="0,7" />
              <ComboBox Style="{StaticResource ToolbarCombo}" Width="92" ItemsSource="{Binding Configurations}" SelectedItem="{Binding Configuration}" ToolTip="Build configuration" />
              <Border Style="{StaticResource ToolbarDivider}" Margin="0,7" Visibility="{Binding TargetFrameworks.Count, Converter={StaticResource Presence}}" />
              <ComboBox Style="{StaticResource ToolbarCombo}" Width="132" ItemsSource="{Binding TargetFrameworks}" SelectedItem="{Binding TargetFramework}" ToolTip="Target framework" Visibility="{Binding TargetFrameworks.Count, Converter={StaticResource Presence}}" />
              <Border Style="{StaticResource ToolbarDivider}" Margin="0,7" Visibility="{Binding LaunchProfiles.Count, Converter={StaticResource Presence}}" />
              <ComboBox Style="{StaticResource ToolbarCombo}" Width="132" ItemsSource="{Binding LaunchProfiles}" SelectedItem="{Binding LaunchProfile}" ToolTip="Launch profile" Visibility="{Binding LaunchProfiles.Count, Converter={StaticResource Presence}}" />
            </StackPanel>
          </Border>
          <Button Command="{Binding DebugCommand}" Height="30" Margin="8,0,2,0" Padding="12,0,14,0" MinHeight="0">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                <Setter Property="c:Ui.Icon" Value="Play" />
                <Setter Property="Content" Value="Start" />
                <Setter Property="ToolTip" Value="Start debugging (F5)" />
                <Setter Property="IsEnabled" Value="{Binding HasWorkspace}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Debugger.IsActive}" Value="True"><Setter Property="IsEnabled" Value="True" /></DataTrigger>
                  <DataTrigger Binding="{Binding Debugger.IsStopped}" Value="True">
                    <Setter Property="c:Ui.Icon" Value="Continue" />
                    <Setter Property="Content" Value="Continue" />
                    <Setter Property="ToolTip" Value="Continue (F5)" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button Style="{StaticResource IconButton}" c:Ui.Icon="PlayOutline" Command="{Binding RunCommand}" IsEnabled="{Binding HasWorkspace}" ToolTip="Run without debugging (Ctrl+F5)" />
          <Button Style="{StaticResource IconButton}" c:Ui.Icon="Build" Command="{Binding BuildCommand}" IsEnabled="{Binding HasWorkspace}" ToolTip="Build (Ctrl+Shift+B)" />
          <Button Style="{StaticResource IconButton}" c:Ui.Icon="Flask" Command="{Binding TestCommand}" IsEnabled="{Binding HasWorkspace}" ToolTip="Run tests" />
          <Button Style="{StaticResource IconButton}" c:Ui.Icon="Stop" Command="{Binding CancelOperationCommand}" ToolTip="Cancel the running operation" Foreground="{DynamicResource DangerBrush}" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
          <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="7" Height="30" Padding="2,0" Margin="8,0,0,0" Visibility="{Binding Debugger.IsActive, Converter={StaticResource BooleanToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource IconButton}" c:Ui.Icon="Pause" Command="{Binding Debugger.PauseCommand}" ToolTip="Pause" />
              <Button Style="{StaticResource IconButton}" c:Ui.Icon="Stop" Command="{Binding Debugger.StopCommand}" ToolTip="Stop debugging (Shift+F5)" Foreground="{DynamicResource DangerBrush}" />
              <Border Style="{StaticResource ToolbarDivider}" Margin="3,7" />
              <Button Style="{StaticResource IconButton}" c:Ui.Icon="StepOver" Command="{Binding Debugger.StepOverCommand}" ToolTip="Step over (F10)" />
              <Button Style="{StaticResource IconButton}" c:Ui.Icon="StepInto" Command="{Binding Debugger.StepIntoCommand}" ToolTip="Step into (F11)" />
              <Button Style="{StaticResource IconButton}" c:Ui.Icon="StepOut" Command="{Binding Debugger.StepOutCommand}" ToolTip="Step out (Shift+F11)" />
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============================================================ Docking workspace -->
    <dock:DockingManager x:Name="DockManager" Grid.Row="2" Margin="6,0,6,0" DocumentsSource="{Binding Documents}" LayoutItemContainerStyleSelector="{StaticResource DocumentStyles}" b:DockingBehavior.Shell="{Binding}"
                         Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" GridSplitterWidth="5" GridSplitterHeight="5"
                         DocumentPaneControlStyle="{DynamicResource StudioDocumentPaneStyle}" AnchorablePaneControlStyle="{DynamicResource StudioAnchorablePaneStyle}"
                         DocumentHeaderTemplate="{DynamicResource StudioDocumentHeaderTemplate}" AnchorableHeaderTemplate="{DynamicResource StudioAnchorableHeaderTemplate}" AnchorableTitleTemplate="{DynamicResource StudioAnchorableTitleTemplate}">
      <layout:LayoutRoot>
        <layout:LayoutPanel Orientation="Vertical">
          <layout:LayoutPanel Orientation="Horizontal">
            <layout:LayoutAnchorablePane DockWidth="264" DockMinWidth="180">
              <layout:LayoutAnchorable Title="Solution Explorer" ContentId="Explorer" CanClose="False" CanHide="True" CanAutoHide="True">
                <DockPanel Background="{DynamicResource SurfaceBrush}">
                  <DockPanel DockPanel.Dock="Top" Margin="12,0,6,4" Height="28">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button Style="{StaticResource IconButton}" c:Ui.Icon="NewFile" Command="{Binding NewWpfItemCommand}" ToolTip="New WPF item (Ctrl+Shift+N)" Width="26" Height="26" />
                      <Button Style="{StaticResource IconButton}" c:Ui.Icon="Refresh" Command="{Binding ReloadWorkspaceCommand}" ToolTip="Reload workspace" Width="26" Height="26" />
                      <Button Style="{StaticResource IconButton}" c:Ui.Icon="FolderOpen" Command="{Binding OpenWorkspaceCommand}" ToolTip="Open solution or project (Ctrl+Shift+O)" Width="26" Height="26" />
                    </StackPanel>
                    <TextBlock Text="{Binding WorkspaceSummary}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <Grid>
                    <TreeView x:Name="ExplorerTree" b:Interaction.SelectOnRightClick="True" ItemsSource="{Binding Explorer}" b:Interaction.ActivateCommand="{Binding OpenNodeCommand}" b:Interaction.SelectedNode="{Binding SelectedNode, Mode=TwoWay}">
                      <TreeView.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                          <MenuItem Header="Open" c:Ui.Icon="File" Command="{Binding OpenNodeCommand}" CommandParameter="{Binding SelectedNode}" />
                          <MenuItem Header="New WPF item…" c:Ui.Icon="NewFile" Command="{Binding NewWpfItemCommand}" InputGestureText="Ctrl+Shift+N" />
                          <Separator />
                          <MenuItem Header="Set as startup project" c:Ui.Icon="Target" Command="{Binding SetStartupProjectCommand}" />
                          <MenuItem Header="Edit project file" Command="{Binding EditProjectCommand}" />
                          <MenuItem Header="Manage NuGet packages…" c:Ui.Icon="Package" Command="{Binding OpenSelectedProjectPackagesCommand}" />
                          <Separator />
                          <MenuItem Header="Git changes…" c:Ui.Icon="Git" Command="{Binding OpenGitCommand}" />
                          <MenuItem Header="Open containing folder" c:Ui.Icon="FolderOpen" Command="{Binding RevealSelectedCommand}" />
                          <MenuItem Header="Copy full path" c:Ui.Icon="Link" Command="{Binding CopySelectedPathCommand}" />
                        </ContextMenu>
                      </TreeView.ContextMenu>
                      <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                          <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                      </TreeView.ItemContainerStyle>
                    </TreeView>
                    <StackPanel VerticalAlignment="Center" Margin="22,0,22,40" Visibility="{Binding Explorer.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}">
                      <c:Glyph Kind="FolderOpen" Width="30" Height="30" Foreground="{DynamicResource SubtleBrush}" StrokeWeight="1.1" />
                      <TextBlock Text="No workspace open" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                      <TextBlock Text="Open a solution or project to browse its files, WPF components and resources." Style="{StaticResource Caption}" TextAlignment="Center" />
                      <Button Style="{StaticResource AccentButton}" Content="Open solution…" Command="{Binding OpenWorkspaceCommand}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                      <Button Style="{StaticResource QuietButton}" Content="Try the sample app" Command="{Binding OpenSampleCommand}" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasSample, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </DockPanel>
              </layout:LayoutAnchorable>
            </layout:LayoutAnchorablePane>
            <layout:LayoutDocumentPane>
              <layout:LayoutDocument Title="Start" ContentId="Welcome" CanClose="False">
                <ScrollViewer Background="{DynamicResource EditorBrush}" VerticalScrollBarVisibility="Auto">
                  <Grid MaxWidth="1000" Margin="48,40,48,32" HorizontalAlignment="Center" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource AccentFillBrush}" VerticalAlignment="Center">
                        <c:Glyph Kind="Window" Width="32" Height="32" Foreground="White" StrokeWeight="1.5" />
                      </Border>
                      <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="WpfStudio" FontSize="28" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" />
                        <TextBlock Text="An IDE for WPF, XAML and MVVM — with the data and tools behind your app." Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,2,0,0" />
                      </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,32,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="*" MinWidth="300" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="START" Style="{StaticResource SectionLabel}" Margin="10,0,0,10" />
                        <Button Style="{StaticResource StartAction}" c:Ui.Icon="FolderOpen" Content="Open solution or project" ToolTip="Load a .sln, .slnx or .csproj with language services" Tag="Ctrl+Shift+O" Command="{Binding OpenWorkspaceCommand}" />
                        <Button Style="{StaticResource StartAction}" c:Ui.Icon="File" Content="Open file" ToolTip="Edit a single file without a workspace" Tag="Ctrl+O" Command="{Binding OpenFileCommand}" />
                        <Button Style="{StaticResource StartAction}" c:Ui.Icon="Sample" Content="Explore the sample app" ToolTip="CounterApp — WPF with CommunityToolkit.Mvvm, ready to debug" Command="{Binding OpenSampleCommand}" Visibility="{Binding HasSample, Converter={StaticResource BooleanToVisibility}}" />
                        <Button Style="{StaticResource StartAction}" c:Ui.Icon="NewFile" Content="New WPF item" ToolTip="View + view model, user control, dictionary or converter" Tag="Ctrl+Shift+N" Command="{Binding NewWpfItemCommand}" IsEnabled="{Binding HasWorkspace}" />

                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="RECENT" Style="{StaticResource SectionLabel}" Margin="10,0,0,10" />
                        <ScrollViewer MaxHeight="292" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding RecentWorkspaces}" Focusable="False">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding}">
                                <Button.Style>
                                  <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    <Setter Property="Margin" Value="0,0,0,4" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                      <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                          <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                            <ContentPresenter />
                                          </Border>
                                          <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}" /></Trigger>
                                          </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                      </Setter.Value>
                                    </Setter>
                                  </Style>
                                </Button.Style>
                                <Grid>
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                  <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                                    <c:StudioIcon Kind="Project" Width="17" Height="17" />
                                  </Border>
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Converter={StaticResource FileStem}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Converter={StaticResource DirectoryOf}}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                  </StackPanel>
                                  <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{DynamicResource RaisedBrush}" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Converter={StaticResource ExtensionLabel}}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                  </Border>
                                </Grid>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                        <Border Style="{StaticResource Card}" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Padding="16,14" Margin="0,0,0,0" Visibility="{Binding RecentWorkspaces.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}">
                          <StackPanel>
                            <TextBlock Text="Nothing here yet" FontWeight="SemiBold" />
                            <TextBlock Text="Solutions and projects you open appear here for one-click access." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                          </StackPanel>
                        </Border>
                        <TextBlock Text="GET STARTED" Style="{StaticResource SectionLabel}" Margin="10,26,0,12" />
                        <StackPanel Margin="10,0,0,0">
                          <StackPanel.Resources>
                            <Style x:Key="Step" TargetType="Border">
                              <Setter Property="Width" Value="22" />
                              <Setter Property="Height" Value="22" />
                              <Setter Property="CornerRadius" Value="11" />
                              <Setter Property="BorderThickness" Value="1.5" />
                              <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
                              <Setter Property="Background" Value="Transparent" />
                              <Setter Property="VerticalAlignment" Value="Top" />
                              <Setter Property="Margin" Value="0,1,12,0" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                  <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                                  <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Resources>
                          <DockPanel Margin="0,0,0,14">
                            <Border Style="{StaticResource Step}" Tag="{Binding HasWorkspace}">
                              <Grid>
                                <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasWorkspace, Converter={StaticResource Presence}, ConverterParameter=Invert}" />
                                <c:Glyph Kind="Check" Width="14" Height="14" Foreground="White" StrokeWeight="2" Visibility="{Binding HasWorkspace, Converter={StaticResource BooleanToVisibility}}" />
                              </Grid>
                            </Border>
                            <StackPanel>
                              <TextBlock Text="Open a solution or project" FontWeight="SemiBold" />
                              <TextBlock Text="Language services, build, test and debug come online for it." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                          </DockPanel>
                          <DockPanel Margin="0,0,0,14">
                            <Border Style="{StaticResource Step}">
                              <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel>
                              <TextBlock Text="Jump between a view and its view model" FontWeight="SemiBold" />
                              <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">Open any .xaml view and press <Run Text="F7" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /> — WpfStudio follows naming conventions and declared DataContexts.</TextBlock>
                            </StackPanel>
                          </DockPanel>
                          <DockPanel>
                            <Border Style="{StaticResource Step}" Tag="{Binding IsColtonGptReady}">
                              <Grid>
                                <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsColtonGptReady, Converter={StaticResource Presence}, ConverterParameter=Invert}" />
                                <c:Glyph Kind="Check" Width="14" Height="14" Foreground="White" StrokeWeight="2" Visibility="{Binding IsColtonGptReady, Converter={StaticResource BooleanToVisibility}}" />
                              </Grid>
                            </Border>
                            <StackPanel>
                              <TextBlock Text="Connect ColtonGPT (optional)" FontWeight="SemiBold" />
                              <TextBlock Text="Add an OpenRouter key to ask questions about your code with explicit, previewed context." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                              <Button Style="{StaticResource QuietButton}" Content="Open settings" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" Padding="0,2" Margin="0,2,0,0" MinHeight="0" />
                            </StackPanel>
                          </DockPanel>
                        </StackPanel>
                      </StackPanel>
                    </Grid>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="10,18,0,0">
                      <StackPanel>
                        <TextBlock Text="KEYBOARD" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                        <WrapPanel>
                          <WrapPanel.Resources>
                            <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Margin" Value="4,0,26,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
                            <Style TargetType="StackPanel"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
                          </WrapPanel.Resources>
                          <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='Ctrl+P', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="Go to file" /></StackPanel>
                          <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='Ctrl+Shift+P', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="All commands" /></StackPanel>
                          <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='F7', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="View ⇄ view model" /></StackPanel>
                          <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='Ctrl+.', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="Editor actions" /></StackPanel>
                          <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='F5', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="Debug" /></StackPanel>
                          <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='Ctrl+Shift+B', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="Build" /></StackPanel>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </Grid>
                </ScrollViewer>
              </layout:LayoutDocument>
            </layout:LayoutDocumentPane>
            <layout:LayoutAnchorablePane DockWidth="340" DockMinWidth="260">
              <layout:LayoutAnchorable Title="WPF Explorer" ContentId="WpfTools" CanClose="False" CanHide="True" CanAutoHide="True">
                <views:WpfExplorerPane />
              </layout:LayoutAnchorable>
              <layout:LayoutAnchorable Title="ColtonGPT" ContentId="ColtonGPT" CanClose="False" CanHide="True" CanAutoHide="True">
                <ai:AssistantPane DataContext="{Binding Features.Assistant}" />
              </layout:LayoutAnchorable>
            </layout:LayoutAnchorablePane>
          </layout:LayoutPanel>
          <layout:LayoutAnchorablePane DockHeight="230" DockMinHeight="110">
            <layout:LayoutAnchorable Title="Output" ContentId="Output" CanClose="False" CanHide="True" IsSelected="True">
              <DockPanel Background="{DynamicResource SurfaceBrush}">
                <DockPanel DockPanel.Dock="Top" Margin="12,0,6,4" Height="26">
                  <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Trash" Command="{Binding ClearOutputCommand}" ToolTip="Clear output" Width="26" Height="26" />
                  <TextBlock Text="Build, restore, test and workspace messages" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" />
                </DockPanel>
                <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource CodeFont}" FontSize="12" BorderThickness="0" Padding="12,6" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource EditorBrush}" />
              </DockPanel>
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Problems" ContentId="Problems" CanClose="False" CanHide="True">
              <Grid Background="{DynamicResource SurfaceBrush}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <DockPanel Margin="10,3,8,3">
                  <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Check XAML" Command="{Binding RefreshProjectXamlAnalysisCommand}" ToolTip="Refresh XAML diagnostics across the loaded projects, including closed files." />
                  <TextBlock Text="{Binding XamlAnalysisStatus}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding XamlAnalysisStatus}" />
                </DockPanel>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Diagnostics}" SelectedItem="{Binding SelectedDiagnostic}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" b:Interaction.ActivateCommand="{Binding NavigateDiagnosticCommand}">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="34">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <c:Glyph Kind="{Binding Severity, Converter={StaticResource SeverityGlyph}}" Foreground="{Binding Severity, Converter={StaticResource SeverityGlyph}, ConverterParameter=Brush}" Width="15" Height="15" ToolTip="{Binding Severity}" />
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Code" Binding="{Binding Id}" Width="112" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                    <DataGridTextColumn Header="Project" Binding="{Binding ProjectName}" Width="130" />
                    <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="240" />
                    <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="56" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0" Visibility="{Binding Diagnostics.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}" IsHitTestVisible="False">
                  <c:Glyph Kind="Check" Width="22" Height="22" Foreground="{DynamicResource SuccessBrush}" />
                  <TextBlock Text="No reported problems" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>
              </Grid>
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Search" ContentId="Search" CanClose="False" CanHide="True">
              <DockPanel Background="{DynamicResource SurfaceBrush}">
                <DockPanel DockPanel.Dock="Top" Margin="10,4,8,6">
                  <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Cancel" Command="{Binding SearchCancelCommand}" />
                  <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" c:Ui.Icon="Search" Content="Search" Command="{Binding SearchCommand}" />
                  <TextBox x:Name="SearchBox" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Find text in workspace files" ToolTip="Find text across source files (Enter)">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                  </TextBox>
                </DockPanel>
                <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" b:Interaction.ActivateCommand="{Binding NavigateSearchCommand}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="220" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel Margin="0,0,12,0">
                          <c:StudioIcon DockPanel.Dock="Left" Kind="{Binding Path, Converter={StaticResource FileIconKind}}" Width="14" Height="14" Margin="0,0,6,0" />
                          <TextBlock Text="{Binding Location}" ToolTip="{Binding Location}" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Grid.Column="1" Text="{Binding Text}" ToolTip="{Binding Text}" TextTrimming="CharacterEllipsis" FontFamily="{StaticResource CodeFont}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Terminal" ContentId="Terminal" CanClose="False" CanHide="True">
              <term:TerminalPane DataContext="{Binding Terminal}" />
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Debugger" ContentId="Debugger" CanClose="False" CanHide="True">
              <debug:DebuggerPane DataContext="{Binding Debugger}" />
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="SQL Server" ContentId="Database" CanClose="False" CanHide="True">
              <sql:DatabasePane DataContext="{Binding Database}" />
            </layout:LayoutAnchorable>
          </layout:LayoutAnchorablePane>
        </layout:LayoutPanel>
      </layout:LayoutRoot>
    </dock:DockingManager>

    <!-- ============================================================ Status bar -->
    <Border Grid.Row="3">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Debugger.IsActive}" Value="True"><Setter Property="Background" Value="{DynamicResource DebugBrush}" /></DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid>
        <DockPanel Margin="8,0">
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Setter Property="TextElement.Foreground" Value="{DynamicResource MutedBrush}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding Debugger.IsActive}" Value="True"><Setter Property="TextElement.Foreground" Value="White" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource StatusButton}" Command="{Binding ShowToolCommand}" CommandParameter="Problems" ToolTip="Errors and warnings — open Problems">
              <StackPanel Orientation="Horizontal">
                <c:Glyph Kind="Error" Width="13" Height="13" Margin="0,0,4,0" />
                <TextBlock Text="{Binding ErrorCount}" VerticalAlignment="Center" />
                <c:Glyph Kind="Warning" Width="13" Height="13" Margin="10,0,4,0" />
                <TextBlock Text="{Binding WarningCount}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource StatusText}" Text="{Binding ActiveDocument.LanguageStatus}" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveDocument.LanguageStatus}" />
            <TextBlock Style="{StaticResource StatusText}" Visibility="{Binding ActiveDocument, Converter={StaticResource Presence}}">
              <Run Text="Ln " /><Run Text="{Binding ActiveDocument.State.CaretLine, Mode=OneWay}" /><Run Text=",  Col " /><Run Text="{Binding ActiveDocument.State.CaretColumn, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Style="{StaticResource StatusText}" Text="{Binding ActiveDocument.EncodingLabel}" Visibility="{Binding ActiveDocument, Converter={StaticResource Presence}}" />
            <TextBlock Style="{StaticResource StatusText}" Text="{Binding ActiveDocument.LanguageLabel}" Visibility="{Binding ActiveDocument, Converter={StaticResource Presence}}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource StatusButton}" Command="{Binding ShowToolCommand}" CommandParameter="Explorer" ToolTip="Show Solution Explorer">
              <StackPanel Orientation="Horizontal">
                <c:Glyph Kind="Window" Width="13" Height="13" Margin="0,0,6,0" />
                <TextBlock VerticalAlignment="Center">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="{Binding WorkspaceName}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding HasWorkspace}" Value="False"><Setter Property="Text" Value="No workspace" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Margin="6,0,0,0" Visibility="{Binding Debugger.IsActive, Converter={StaticResource BooleanToVisibility}}">
              <c:Glyph Kind="Bug" Width="13" Height="13" Margin="0,0,5,0" />
              <TextBlock Text="Debugging" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource StatusText}" Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
          </StackPanel>
        </DockPanel>
        <ProgressBar Style="{StaticResource ActivityBar}" VerticalAlignment="Top" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
      </Grid>
    </Border>

    <!-- ============================================================ Command palette -->
    <Grid Grid.RowSpan="4" Panel.ZIndex="20" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsPaletteOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Style="{StaticResource OverlayCard}" Width="660" MaxHeight="560" VerticalAlignment="Top" Margin="0,72,0,0" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,6,12,6">
            <DockPanel>
              <c:Glyph DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}">
                <c:Glyph.Style>
                  <Style TargetType="c:Glyph">
                    <Setter Property="Kind" Value="Search" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsCommandPalette}" Value="True"><Setter Property="Kind" Value="Command" /></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </c:Glyph.Style>
              </c:Glyph>
              <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="Files" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCommandPalette}" Value="True"><Setter Property="Text" Value="Commands" /></DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Border>
              <TextBox x:Name="PaletteBox" Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}" FontSize="15" BorderThickness="0" Background="Transparent" MinHeight="40" Padding="4,0"
                       c:Ui.Placeholder="{Binding PalettePlaceholder}" b:Interaction.FocusCaretEnd="True" AutomationProperties.Name="Quick open and command palette">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding ExecutePaletteCommand}" />
                  <KeyBinding Key="Escape" Command="{Binding ClosePaletteCommand}" />
                  <KeyBinding Key="Down" Command="{Binding PaletteNextCommand}" />
                  <KeyBinding Key="Up" Command="{Binding PalettePreviousCommand}" />
                </TextBox.InputBindings>
              </TextBox>
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,8" Background="{DynamicResource WindowBrush}" CornerRadius="0,0,10,10">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='Esc', Converter={StaticResource ToKeyCaps}}" />
                <TextBlock Text="close" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='↑+↓', Converter={StaticResource ToKeyCaps}}" />
                <TextBlock Text="select" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="2,0,14,0" />
                <ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='Enter', Converter={StaticResource ToKeyCaps}}" />
                <TextBlock Text="open" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="2,0,14,0" />
                <ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='&gt;', Converter={StaticResource ToKeyCaps}}" />
                <TextBlock Text="commands" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="2,0,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid>
            <ListBox x:Name="PaletteList" ItemsSource="{Binding PaletteResults}" SelectedItem="{Binding SelectedPaletteEntry}" b:Interaction.ActivateCommand="{Binding ExecutePaletteCommand}" b:Interaction.ActivateOnClick="True" b:Interaction.FollowSelection="True" Padding="0,6" Focusable="False">
              <ListBox.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding ClosePaletteCommand}" />
              </ListBox.InputBindings>
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Margin" Value="6,1" />
                  <Setter Property="Padding" Value="10,6" />
                  <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectionBrush}" /></Trigger>
                  </Style.Triggers>
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="28" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <c:StudioIcon Kind="{Binding IconKind}" Width="16" Height="16" HorizontalAlignment="Left" Visibility="{Binding IsFile, Converter={StaticResource BooleanToVisibility}}" />
                    <c:Glyph Kind="{Binding Icon}" Width="16" Height="16" HorizontalAlignment="Left" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource SubtleBrush}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="3" Text="{Binding Category}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                    <ItemsControl Grid.Column="4" Style="{StaticResource KeyCaps}" ItemsSource="{Binding Shortcut, Converter={StaticResource ToKeyCaps}}" Margin="12,0,0,0" Visibility="{Binding HasShortcut, Converter={StaticResource BooleanToVisibility}}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="No matches" Foreground="{DynamicResource SubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24" Visibility="{Binding PaletteResults.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}" />
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ============================================================ New WPF item -->
    <Grid Grid.RowSpan="4" Panel.ZIndex="30" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsScaffoldOpen, Converter={StaticResource BooleanToVisibility}}">
      <Grid.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelScaffoldCommand}" />
      </Grid.InputBindings>
      <Border Style="{StaticResource OverlayCard}" Width="560" VerticalAlignment="Center" Padding="28,24">
        <StackPanel>
          <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Close" Command="{Binding CancelScaffoldCommand}" ToolTip="Cancel (Esc)" />
            <TextBlock Text="New WPF item" FontSize="20" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" />
          </DockPanel>
          <TextBlock Text="Generates the files together. You review every change before anything is written." Style="{StaticResource Caption}" FontSize="12" Margin="0,0,0,18" />
          <TextBlock Text="TYPE" Style="{StaticResource SectionLabel}" />
          <ListBox ItemsSource="{Binding ScaffoldKinds}" SelectedItem="{Binding SelectedScaffoldKind}" Margin="-4,0,-4,14" Padding="0">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Margin" Value="4,1" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <c:Glyph DockPanel.Dock="Left" Kind="{Binding Converter={StaticResource ScaffoldText}, ConverterParameter=Icon}" Width="16" Height="16" Margin="0,0,12,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                  <StackPanel>
                    <TextBlock Text="{Binding Converter={StaticResource ScaffoldText}}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Converter={StaticResource ScaffoldText}, ConverterParameter=Detail}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="NAME" Style="{StaticResource SectionLabel}" />
          <TextBox Text="{Binding ScaffoldName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" FontSize="13" b:Interaction.FocusWhenVisible="True" c:Ui.Placeholder="CustomerView">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding CreateWpfItemCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <CheckBox Content="Also add a view-model DataTemplate to a shared dictionary" IsChecked="{Binding AddDataTemplate}" Margin="0,0,0,4" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Cancel" Command="{Binding CancelScaffoldCommand}" />
            <Button Content="Preview files" c:Ui.Icon="ChevronRight" Command="{Binding CreateWpfItemCommand}" Style="{StaticResource AccentButton}" Margin="8,2,0,2" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ============================================================ Change preview -->
    <!-- Near full-window review: a file list with per-file line counts and a syntax-highlighted
         split or inline diff focused on the changed lines. -->
    <Grid Grid.RowSpan="4" Panel.ZIndex="40" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsPreviewOpen, Converter={StaticResource BooleanToVisibility}}">
      <Grid.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelPreviewCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AcceptPreviewCommand}" />
      </Grid.InputBindings>
      <Border Style="{StaticResource OverlayCard}" Margin="20,16" Padding="0" AutomationProperties.Name="Change review">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="22,14,14,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Close" Command="{Binding CancelPreviewCommand}" ToolTip="Cancel (Esc)" VerticalAlignment="Top" />
                <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="12,0,10,0" Padding="8,2">
                  <TextBlock Text="{Binding PreviewSummary}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" FontSize="11" />
                </Border>
                <c:Glyph DockPanel.Dock="Left" Kind="Diff" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding PreviewTitle}" FontSize="18" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="Nothing changes until you apply. Applying edits the open buffers as one undoable step; save normally to write files." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                </StackPanel>
              </DockPanel>
              <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="10,7" Margin="0,10,0,0" Visibility="{Binding PreviewWarnings, Converter={StaticResource Presence}}">
                <DockPanel>
                  <c:Glyph DockPanel.Dock="Left" Kind="Warning" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" />
                  <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding PreviewWarnings}" TextWrapping="Wrap" />
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Padding="22,10,16,10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Cancel" Command="{Binding CancelPreviewCommand}" ToolTip="Esc" />
                <Button Content="Apply changes" c:Ui.Icon="Check" Command="{Binding AcceptPreviewCommand}" Style="{StaticResource AccentButton}" Margin="8,2,0,2" ToolTip="Ctrl+Enter" />
              </StackPanel>
              <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource SubtleBrush}" FontSize="11" TextTrimming="CharacterEllipsis"
                         Text="F8 / Shift+F8 moves between changes · click a collapsed region to expand it · Ctrl+Enter applies" />
            </DockPanel>
          </Border>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Width="280" Visibility="{Binding PreviewHasManyFiles, Converter={StaticResource BooleanToVisibility}}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="FILES" Style="{StaticResource SectionLabel}" Margin="14,10,0,4" />
                <ListBox ItemsSource="{Binding PreviewFiles}" SelectedItem="{Binding SelectedPreviewFile}" AutomationProperties.Name="Changed files">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ChangeReviewFile}">
                      <DockPanel ToolTip="{Binding Change.Path}">
                        <c:StudioIcon DockPanel.Dock="Left" Kind="{Binding Change.Path, Converter={StaticResource FileIconKind}}" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top" />
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="6,1,0,0">
                          <TextBlock Text="{Binding AddedText}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0" />
                          <TextBlock Text="{Binding RemovedText}" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Padding="5,0">
                              <Border.Visibility><Binding Path="IsNew" Converter="{StaticResource BooleanToVisibility}" /></Border.Visibility>
                              <TextBlock Text="New" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                            </Border>
                          </StackPanel>
                          <TextBlock Text="{Binding Folder}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                        </StackPanel>
                      </DockPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
            <diff:DiffView xmlns:diff="clr-namespace:WpfStudio.App.Controls.Diff" Grid.Column="1" x:Name="ReviewDiff"
                           Before="{Binding SelectedPreviewChange.Before}" After="{Binding SelectedPreviewChange.After}" FilePath="{Binding SelectedPreviewChange.Path}"
                           OldLabel="Current" NewLabel="After applying" AutomationProperties.Name="Change diff">
              <diff:DiffView.Header>
                <StackPanel Orientation="Horizontal" DataContext="{Binding SelectedPreviewFile}">
                  <c:StudioIcon Kind="{Binding Change.Path, Converter={StaticResource FileIconKind}}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Folder}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                  <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="12,1,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                </StackPanel>
              </diff:DiffView.Header>
            </diff:DiffView>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>

    <!-- ============================================================ Settings -->
    <Grid Grid.RowSpan="4" Panel.ZIndex="60" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Grid.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}" />
      </Grid.InputBindings>
      <Border Style="{StaticResource OverlayCard}" Width="700" MaxHeight="800" Margin="20" VerticalAlignment="Center" Padding="0">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="28,20,18,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Close" Command="{Binding CloseSettingsCommand}" ToolTip="Close (Esc)" />
              <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextOptions.TextFormattingMode="Ideal" />
            </DockPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,20,28,24">
              <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
              <UniformGrid Columns="2" Margin="0,0,0,28">
                <RadioButton Style="{StaticResource ChoiceTile}" GroupName="Theme" IsChecked="{Binding IsDarkTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" Margin="0,0,6,0">
                  <StackPanel>
                    <Border Height="54" CornerRadius="5" Background="#131417" BorderBrush="#34373F" BorderThickness="1" Margin="0,0,0,10">
                      <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="#18191D" CornerRadius="3" />
                        <StackPanel Grid.Column="1" Margin="8,2,0,0">
                          <Border Height="4" Width="70" HorizontalAlignment="Left" CornerRadius="2" Background="#A3AAFF" />
                          <Border Height="4" Width="110" HorizontalAlignment="Left" CornerRadius="2" Background="#3A3D45" Margin="0,6,0,0" />
                          <Border Height="4" Width="90" HorizontalAlignment="Left" CornerRadius="2" Background="#E2B883" Margin="0,6,0,0" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <DockPanel>
                      <c:Glyph DockPanel.Dock="Left" Kind="Moon" Width="15" Height="15" Margin="0,0,8,0" />
                      <TextBlock Text="Graphite dark" FontWeight="SemiBold" />
                    </DockPanel>
                  </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource ChoiceTile}" GroupName="Theme" IsChecked="{Binding IsLightTheme, Mode=OneWay}" Command="{Binding SetThemeCommand}" CommandParameter="Light" Margin="6,0,0,0">
                  <StackPanel>
                    <Border Height="54" CornerRadius="5" Background="#EDEEF1" BorderBrush="#CBCED6" BorderThickness="1" Margin="0,0,0,10">
                      <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="#F6F7F9" CornerRadius="3" BorderBrush="#E0E1E6" BorderThickness="1" />
                        <StackPanel Grid.Column="1" Margin="8,2,0,0">
                          <Border Height="4" Width="70" HorizontalAlignment="Left" CornerRadius="2" Background="#4B3DC9" />
                          <Border Height="4" Width="110" HorizontalAlignment="Left" CornerRadius="2" Background="#CBCED6" Margin="0,6,0,0" />
                          <Border Height="4" Width="90" HorizontalAlignment="Left" CornerRadius="2" Background="#955A12" Margin="0,6,0,0" />
                        </StackPanel>
                      </Grid>
                    </Border>
                    <DockPanel>
                      <c:Glyph DockPanel.Dock="Left" Kind="Sun" Width="15" Height="15" Margin="0,0,8,0" />
                      <TextBlock Text="Graphite light" FontWeight="SemiBold" />
                    </DockPanel>
                  </StackPanel>
                </RadioButton>
              </UniformGrid>
              <ai:AssistantSettingsView DataContext="{Binding Features.Assistant.Settings}" MaxWidth="10000" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
