<Window x:Class="WpfStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock"
        xmlns:views="clr-namespace:WpfStudio.App.Views"
        xmlns:ai="clr-namespace:WpfStudio.App.Features.ColtonGpt"
        xmlns:b="clr-namespace:WpfStudio.App.Behaviors"
        xmlns:term="clr-namespace:WpfStudio.Runtime.Terminal;assembly=WpfStudio.Runtime"
        xmlns:debug="clr-namespace:WpfStudio.Runtime.Debugging;assembly=WpfStudio.Runtime"
        xmlns:sql="clr-namespace:WpfStudio.Database.Views;assembly=WpfStudio.Database"
        xmlns:shell="clr-namespace:WpfStudio.App.Views.Shell"
        Title="{Binding WindowTitle}" Icon="/WpfStudio;component/Resources/WpfStudio.ico"
        Width="1480" Height="940" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen"
        b:Interaction.CloseGuard="{Binding}">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <ResourceDictionary Source="Resources/ShellDocuments.xaml" />
  </Window.Resources>

  <Window.InputBindings>
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding QuickOpenCommand}" />
    <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding CommandPaletteCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
    <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenWorkspaceCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}" />
    <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseActiveCommand}" />
    <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding BuildCommand}" />
    <KeyBinding Key="F5" Command="{Binding DebugCommand}" />
    <KeyBinding Key="F5" Modifiers="Control" Command="{Binding RunCommand}" />
    <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding Debugger.StopCommand}" />
    <KeyBinding Key="F7" Command="{Binding SwitchRelatedCommand}" />
    <KeyBinding Key="F9" Command="{Binding Breakpoints.ToggleCommand}" />
    <KeyBinding Key="F10" Command="{Binding Debugger.StepOverCommand}" />
    <KeyBinding Key="F11" Command="{Binding Debugger.StepIntoCommand}" />
    <KeyBinding Key="F11" Modifiers="Shift" Command="{Binding Debugger.StepOutCommand}" />
    <KeyBinding Key="F12" Command="{Binding GoToDefinitionCommand}" />
    <KeyBinding Key="F12" Modifiers="Shift" Command="{Binding FindReferencesCommand}" />
    <KeyBinding Key="F12" Modifiers="Control" Command="{Binding GoToImplementationCommand}" />
    <KeyBinding Key="T" Modifiers="Control" Command="{Binding GoToSymbolCommand}" />
    <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding NavigateBackCommand}" />
    <KeyBinding Key="OemMinus" Modifiers="Control+Shift" Command="{Binding NavigateForwardCommand}" />
    <KeyBinding Key="F2" Command="{Binding RenameSymbolCommand}" />
    <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding FormatCommand}" />
    <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewWpfItemCommand}" />
    <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}" />
    <KeyBinding Key="Oem3" Modifiers="Control" Command="{Binding ShowToolCommand}" CommandParameter="Terminal" />
  </Window.InputBindings>

  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="40" />
      <RowDefinition Height="42" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>

    <shell:ShellTitleBar x:Name="TitleBar" />

    <shell:RunToolbar Grid.Row="1" />

    <DockPanel Grid.Row="2">
    <shell:ExternalChangesBanner DockPanel.Dock="Top" Visibility="{Binding ExternalChanges.HasChanges, Converter={StaticResource BooleanToVisibility}}" />
    <shell:RuntimeBanner DockPanel.Dock="Top" Visibility="{Binding Runtimes.IsVisible, Converter={StaticResource BooleanToVisibility}}" />
    <dock:DockingManager x:Name="DockManager" Margin="6,0,6,0" DocumentsSource="{Binding Documents}" LayoutItemContainerStyleSelector="{StaticResource DocumentStyles}" b:DockingBehavior.Shell="{Binding}"
                         Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" GridSplitterWidth="5" GridSplitterHeight="5"
                         DocumentPaneControlStyle="{DynamicResource StudioDocumentPaneStyle}" AnchorablePaneControlStyle="{DynamicResource StudioAnchorablePaneStyle}"
                         DocumentHeaderTemplate="{DynamicResource StudioDocumentHeaderTemplate}" AnchorableHeaderTemplate="{DynamicResource StudioAnchorableHeaderTemplate}" AnchorableTitleTemplate="{DynamicResource StudioAnchorableTitleTemplate}">
      <layout:LayoutRoot>
        <layout:LayoutPanel Orientation="Vertical">
          <layout:LayoutPanel Orientation="Horizontal">
            <layout:LayoutAnchorablePane DockWidth="264" DockMinWidth="180">
              <layout:LayoutAnchorable Title="Solution Explorer" ContentId="Explorer" CanClose="False" CanHide="True" CanAutoHide="True">
                <shell:SolutionExplorerPane x:Name="SolutionExplorer" />
              </layout:LayoutAnchorable>
              <layout:LayoutAnchorable Title="File Groups" ContentId="FileGroups" CanClose="False" CanHide="True" CanAutoHide="True">
                <shell:FileGroupsPane />
              </layout:LayoutAnchorable>
            </layout:LayoutAnchorablePane>
            <layout:LayoutDocumentPane>
              <layout:LayoutDocument Title="Start" ContentId="Welcome" CanClose="False">
                <shell:StartPage />
              </layout:LayoutDocument>
            </layout:LayoutDocumentPane>
            <layout:LayoutAnchorablePane DockWidth="340" DockMinWidth="260">
              <layout:LayoutAnchorable Title="WPF Explorer" ContentId="WpfTools" CanClose="False" CanHide="True" CanAutoHide="True">
                <views:WpfExplorerPane />
              </layout:LayoutAnchorable>
              <layout:LayoutAnchorable Title="ColtonGPT" ContentId="ColtonGPT" CanClose="False" CanHide="True" CanAutoHide="True">
                <ai:AssistantPane DataContext="{Binding Features.Assistant}" />
              </layout:LayoutAnchorable>
            </layout:LayoutAnchorablePane>
          </layout:LayoutPanel>
          <layout:LayoutAnchorablePane DockHeight="230" DockMinHeight="110">
            <layout:LayoutAnchorable Title="Output" ContentId="Output" CanClose="False" CanHide="True" IsSelected="True">
              <shell:OutputPane />
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Problems" ContentId="Problems" CanClose="False" CanHide="True">
              <shell:ProblemsPane />
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Task List" ContentId="TaskList" CanClose="False" CanHide="True">
              <shell:TaskListPane />
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Tasks" ContentId="Tasks" CanClose="False" CanHide="True">
              <shell:TasksPane />
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Search" ContentId="Search" CanClose="False" CanHide="True">
              <shell:SearchPane x:Name="WorkspaceSearch" />
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Terminal" ContentId="Terminal" CanClose="False" CanHide="True">
              <term:TerminalPane DataContext="{Binding Terminal}" />
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Debugger" ContentId="Debugger" CanClose="False" CanHide="True">
              <debug:DebuggerPane DataContext="{Binding Debugger}" />
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="SQL Server" ContentId="Database" CanClose="False" CanHide="True">
              <sql:DatabasePane DataContext="{Binding Database}" />
            </layout:LayoutAnchorable>
          </layout:LayoutAnchorablePane>
        </layout:LayoutPanel>
      </layout:LayoutRoot>
    </dock:DockingManager>
    </DockPanel>

    <shell:ShellStatusBar Grid.Row="3" />

    <shell:CommandPaletteOverlay Grid.RowSpan="4" Panel.ZIndex="20" Visibility="{Binding Palette.IsOpen, Converter={StaticResource BooleanToVisibility}}" />

    <shell:NewItemOverlay Grid.RowSpan="4" Panel.ZIndex="30" Visibility="{Binding IsScaffoldOpen, Converter={StaticResource BooleanToVisibility}}" />

    <shell:ChangeReviewOverlay Grid.RowSpan="4" Panel.ZIndex="40" Visibility="{Binding IsPreviewOpen, Converter={StaticResource BooleanToVisibility}}" />

    <shell:AboutOverlay Grid.RowSpan="4" Panel.ZIndex="55" Visibility="{Binding IsAboutOpen, Converter={StaticResource BooleanToVisibility}}" />

    <!-- ============================================================ Settings -->
    <Grid Grid.RowSpan="4" Panel.ZIndex="60" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Grid.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}" />
      </Grid.InputBindings>
      <Border Style="{StaticResource OverlayCard}" Width="1000" Height="740" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}" MaxHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}}" Margin="24" VerticalAlignment="Center" Padding="0">
        <views:SettingsView />
      </Border>
    </Grid>
  </Grid>
</Window>
