<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="WpfStudio.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dock="clr-namespace:AvalonDock;assembly=AvalonDock" xmlns:layout="clr-namespace:AvalonDock.Layout;assembly=AvalonDock" xmlns:dc="clr-namespace:AvalonDock.Controls;assembly=AvalonDock" xmlns:vm="clr-namespace:WpfStudio.App.ViewModels" xmlns:views="clr-namespace:WpfStudio.App.Views" xmlns:packages="clr-namespace:WpfStudio.App.Features.Packages" xmlns:git="clr-namespace:WpfStudio.App.Features.Git" xmlns:ai="clr-namespace:WpfStudio.App.Features.ColtonGpt" xmlns:controls="clr-namespace:WpfStudio.App.Controls" xmlns:b="clr-namespace:WpfStudio.App.Behaviors" xmlns:term="clr-namespace:WpfStudio.Runtime.Terminal;assembly=WpfStudio.Runtime" xmlns:debug="clr-namespace:WpfStudio.Runtime.Debugging;assembly=WpfStudio.Runtime" xmlns:sql="clr-namespace:WpfStudio.Database.Views;assembly=WpfStudio.Database" Title="{Binding WindowTitle}" Width="1480" Height="940" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" b:Interaction.CloseGuard="{Binding}">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:EditorViewModel}">
      <controls:EditorSurface ContextMenu="{StaticResource EditorContextMenu}" ViewModel="{Binding}" Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource TextBrush}" LineNumbersForeground="{DynamicResource MutedBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="13" />
    </DataTemplate>
    <HierarchicalDataTemplate DataType="{x:Type vm:ExplorerNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal">
        <controls:StudioIcon Kind="{Binding IconKind}" Width="18" Height="18" Margin="0,0,7,0" />
        <TextBlock Text="{Binding Name}" ToolTip="{Binding Path}" />
      </StackPanel>
    </HierarchicalDataTemplate>
    <Style x:Key="DocumentContainer" TargetType="dc:LayoutDocumentItem">
      <Setter Property="Title" Value="{Binding Model.Title, RelativeSource={RelativeSource Self}}" />
      <Setter Property="ContentId" Value="{Binding Model.ContentId, RelativeSource={RelativeSource Self}}" />
    </Style>
    <b:DocumentDockStyleSelector x:Key="DocumentStyles" DocumentStyle="{StaticResource DocumentContainer}" />
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="P" Modifiers="Control" Command="{Binding QuickOpenCommand}" />
    <KeyBinding Key="P" Modifiers="Control+Shift" Command="{Binding CommandPaletteCommand}" />
    <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFileCommand}" />
    <KeyBinding Key="O" Modifiers="Control+Shift" Command="{Binding OpenWorkspaceCommand}" />
    <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    <KeyBinding Key="S" Modifiers="Control+Shift" Command="{Binding SaveAllCommand}" />
    <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseActiveCommand}" />
    <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding BuildCommand}" />
    <KeyBinding Key="F5" Command="{Binding DebugCommand}" />
    <KeyBinding Key="F5" Modifiers="Control" Command="{Binding RunCommand}" />
    <KeyBinding Key="F9" Command="{Binding ToggleBreakpointCommand}" />
    <KeyBinding Key="F10" Command="{Binding Debugger.StepOverCommand}" />
    <KeyBinding Key="F11" Command="{Binding Debugger.StepIntoCommand}" />
    <KeyBinding Key="F11" Modifiers="Shift" Command="{Binding Debugger.StepOutCommand}" />
    <KeyBinding Key="F12" Command="{Binding GoToDefinitionCommand}" />
    <KeyBinding Key="F12" Modifiers="Shift" Command="{Binding FindReferencesCommand}" />
    <KeyBinding Key="F2" Command="{Binding RenameSymbolCommand}" />
    <KeyBinding Key="N" Modifiers="Control+Shift" Command="{Binding NewWpfItemCommand}" />
  </Window.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="35" />
      <RowDefinition Height="43" />
      <RowDefinition Height="*" />
      <RowDefinition Height="26" />
    </Grid.RowDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="10,0,8,0">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
          <TextBlock Text="◈" FontSize="20" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
          <TextBlock Text="WpfStudio" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="Quick open   Ctrl+P" Command="{Binding QuickOpenCommand}" Style="{StaticResource QuietButton}" Foreground="{DynamicResource MutedBrush}" />
        <Menu VerticalAlignment="Center">
          <MenuItem Header="_File">
            <MenuItem Header="Open solution or project…" Command="{Binding OpenWorkspaceCommand}" InputGestureText="Ctrl+Shift+O" />
            <MenuItem Header="Open file…" Command="{Binding OpenFileCommand}" InputGestureText="Ctrl+O" />
            <Separator />
            <MenuItem Header="Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" />
            <MenuItem Header="Save all" Command="{Binding SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
            <MenuItem Header="Reload from disk" Command="{Binding ReloadDocumentCommand}" />
            <Separator />
            <MenuItem Header="Close document" Command="{Binding CloseActiveCommand}" InputGestureText="Ctrl+W" />
          </MenuItem>
          <MenuItem Header="_Edit">
            <MenuItem Header="Organize usings…" Command="{Binding RefactorCommand}" CommandParameter="OrganizeUsings" />
            <MenuItem Header="Use var…" Command="{Binding RefactorCommand}" CommandParameter="UseVar" />
            <MenuItem Header="Use explicit type…" Command="{Binding RefactorCommand}" CommandParameter="UseExplicitType" />
            <Separator />
            <MenuItem Header="Format document" Command="{Binding FormatCommand}" />
            <MenuItem Header="Rename symbol…" Command="{Binding RenameSymbolCommand}" InputGestureText="F2" />
            <MenuItem Header="Go to definition" Command="{Binding GoToDefinitionCommand}" InputGestureText="F12" />
            <MenuItem Header="Find references" Command="{Binding FindReferencesCommand}" InputGestureText="Shift+F12" />
            <Separator />
            <MenuItem Header="Undo workspace edit" Command="{Binding UndoWorkspaceEditCommand}" />
          </MenuItem>
          <MenuItem Header="_View">
            <MenuItem Header="Packages" Command="{Binding OpenPackagesCommand}" />
            <MenuItem Header="Git" Command="{Binding OpenGitCommand}" />
            <MenuItem Header="ColtonGPT" Command="{Binding OpenAssistantCommand}" />
            <Separator />
            <MenuItem Header="Command palette" Command="{Binding CommandPaletteCommand}" InputGestureText="Ctrl+Shift+P" />
            <MenuItem Header="Quick open" Command="{Binding QuickOpenCommand}" InputGestureText="Ctrl+P" />
            <Separator />
            <MenuItem Header="Solution explorer" Command="{Binding ShowToolCommand}" CommandParameter="Explorer" />
            <MenuItem Header="WPF Explorer" Command="{Binding ShowToolCommand}" CommandParameter="WpfTools" />
            <MenuItem Header="Output" Command="{Binding ShowToolCommand}" CommandParameter="Output" />
            <MenuItem Header="Problems" Command="{Binding ShowToolCommand}" CommandParameter="Problems" />
            <MenuItem Header="Search" Command="{Binding ShowToolCommand}" CommandParameter="Search" />
            <MenuItem Header="Terminal" Command="{Binding ShowToolCommand}" CommandParameter="Terminal" />
            <MenuItem Header="Debugger" Command="{Binding ShowToolCommand}" CommandParameter="Debugger" />
            <MenuItem Header="SQL Server" Command="{Binding ShowToolCommand}" CommandParameter="Database" />
            <Separator />
            <MenuItem Header="Switch light / dark theme" Command="{Binding ToggleThemeCommand}" />
            <MenuItem Header="Save docking layout" Command="{Binding SaveLayoutCommand}" />
            <MenuItem Header="Reset docking layout" Command="{Binding ResetLayoutCommand}" />
          </MenuItem>
          <MenuItem Header="_Build">
            <MenuItem Header="Build" Command="{Binding BuildCommand}" InputGestureText="Ctrl+Shift+B" />
            <MenuItem Header="Restore packages" Command="{Binding RestoreCommand}" />
            <MenuItem Header="Rebuild" Command="{Binding RebuildCommand}" />
            <MenuItem Header="Clean" Command="{Binding CleanCommand}" />
            <MenuItem Header="Run tests" Command="{Binding TestCommand}" />
            <Separator />
            <MenuItem Header="Cancel operation" Command="{Binding CancelOperationCommand}" />
          </MenuItem>
          <MenuItem Header="_Debug">
            <MenuItem Header="Show breakpoints" Command="{Binding ShowBreakpointsCommand}" />
            <MenuItem Header="Breakpoint condition…" Command="{Binding BreakpointConditionCommand}" />
            <Separator />
            <MenuItem Header="Start / continue" Command="{Binding DebugCommand}" InputGestureText="F5" />
            <MenuItem Header="Run without debugging" Command="{Binding RunCommand}" InputGestureText="Ctrl+F5" />
            <MenuItem Header="Pause" Command="{Binding Debugger.PauseCommand}" />
            <MenuItem Header="Stop" Command="{Binding Debugger.StopCommand}" />
            <MenuItem Header="Detach" Command="{Binding Debugger.DetachCommand}" />
            <Separator />
            <MenuItem Header="Toggle breakpoint" Command="{Binding ToggleBreakpointCommand}" InputGestureText="F9" />
            <MenuItem Header="Step over" Command="{Binding Debugger.StepOverCommand}" InputGestureText="F10" />
            <MenuItem Header="Step into" Command="{Binding Debugger.StepIntoCommand}" InputGestureText="F11" />
            <MenuItem Header="Step out" Command="{Binding Debugger.StepOutCommand}" InputGestureText="Shift+F11" />
            <MenuItem Header="Attach to process…" Command="{Binding ShowToolCommand}" CommandParameter="Debugger" />
          </MenuItem>
          <MenuItem Header="_WPF">
            <MenuItem Header="New WPF item…" Command="{Binding NewWpfItemCommand}" InputGestureText="Ctrl+Shift+N" />
            <MenuItem Header="Switch view / view model" Command="{Binding SwitchRelatedCommand}" />
            <MenuItem Header="Insert observable property…" Command="{Binding InsertPropertyCommand}" />
            <MenuItem Header="Insert relay command…" Command="{Binding InsertCommandCommand}" />
            <Separator />
            <MenuItem Header="Rename resource key…" Command="{Binding RenameResourceCommand}" />
            <MenuItem Header="Import asset…" Command="{Binding ImportAssetCommand}" />
            <MenuItem Header="Show pack URI" Command="{Binding ShowPackUriCommand}" />
            <MenuItem Header="Refresh resources" Command="{Binding RefreshWpfCommand}" />
          </MenuItem>
          <MenuItem Header="_Tools">
            <MenuItem Header="Manage NuGet packages…" Command="{Binding OpenPackagesCommand}" />
            <MenuItem Header="Git changes…" Command="{Binding OpenGitCommand}" />
            <MenuItem Header="ColtonGPT" Command="{Binding OpenAssistantCommand}" />
            <MenuItem Header="Settings…" Command="{Binding OpenSettingsCommand}" />
            <Separator />
            <MenuItem Header="SQL Server" Command="{Binding ShowToolCommand}" CommandParameter="Database" />
            <MenuItem Header="Terminal" Command="{Binding ShowToolCommand}" CommandParameter="Terminal" />
            <Separator />
            <MenuItem Header="Reload workspace" Command="{Binding ReloadWorkspaceCommand}" />
            <MenuItem Header="Restart language service" Command="{Binding RestartWorkspaceCommand}" />
          </MenuItem>
        </Menu>
      </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <DockPanel Margin="7,3">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Content="ColtonGPT" Command="{Binding OpenAssistantCommand}" />
          <Button Content="+ WPF item" Command="{Binding NewWpfItemCommand}" />
          <Button Content="SQL" Command="{Binding ShowToolCommand}" CommandParameter="Database" />
          <Button Content="⌘" Command="{Binding CommandPaletteCommand}" ToolTip="Command palette" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Content="▶" Foreground="{DynamicResource SuccessBrush}" Command="{Binding DebugCommand}" ToolTip="Start debugging / continue (F5)" Width="35" />
          <Button Content="Build" Command="{Binding BuildCommand}" />
          <Button Content="■" Command="{Binding CancelOperationCommand}" ToolTip="Cancel operation" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}" />
          <Border Width="1" Background="{DynamicResource BorderBrush}" Margin="8,5" />
          <ComboBox Width="205" ItemsSource="{Binding Projects}" SelectedItem="{Binding StartupProject}" DisplayMemberPath="Name" ToolTip="Startup project" />
          <ComboBox Width="82" ItemsSource="{Binding Configurations}" SelectedItem="{Binding Configuration}" ToolTip="Build configuration" />
          <ComboBox Width="125" ItemsSource="{Binding TargetFrameworks}" SelectedItem="{Binding TargetFramework}" ToolTip="Target framework" />
          <ComboBox Width="135" ItemsSource="{Binding LaunchProfiles}" SelectedItem="{Binding LaunchProfile}" ToolTip="Launch profile" />
        </StackPanel>
      </DockPanel>
    </Border>
    <dock:DockingManager x:Name="DockManager" Grid.Row="2" DocumentsSource="{Binding Documents}" LayoutItemContainerStyleSelector="{StaticResource DocumentStyles}" b:DockingBehavior.Shell="{Binding}" Background="{DynamicResource EditorBrush}">
      <layout:LayoutRoot>
        <layout:LayoutPanel Orientation="Vertical">
          <layout:LayoutPanel Orientation="Horizontal">
            <layout:LayoutAnchorablePane DockWidth="235" DockMinWidth="170">
              <layout:LayoutAnchorable Title="Solution Explorer" ContentId="Explorer" CanClose="False" CanHide="True" CanAutoHide="True">
                <DockPanel Background="{DynamicResource SurfaceBrush}">
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="5">
                    <Button Content="Open…" Command="{Binding OpenWorkspaceCommand}" ToolTip="Open solution or project" />
                    <Button Content="↻" Command="{Binding ReloadWorkspaceCommand}" ToolTip="Reload workspace" />
                  </StackPanel>
                  <TreeView x:Name="ExplorerTree" b:Interaction.SelectOnRightClick="True" ItemsSource="{Binding Explorer}" b:Interaction.ActivateCommand="{Binding OpenNodeCommand}" b:Interaction.SelectedNode="{Binding SelectedNode, Mode=TwoWay}" Margin="6,0">
                    <TreeView.ContextMenu>
                      <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Open" Command="{Binding OpenNodeCommand}" CommandParameter="{Binding SelectedNode}" />
                        <MenuItem Header="New WPF item…" Command="{Binding NewWpfItemCommand}" />
                        <MenuItem Header="Edit project file" Command="{Binding EditProjectCommand}" />
                        <MenuItem Header="Set as startup project" Command="{Binding SetStartupProjectCommand}" />
                        <Separator />
                        <MenuItem Header="Manage packages…" Command="{Binding OpenSelectedProjectPackagesCommand}" />
                        <MenuItem Header="Git changes…" Command="{Binding OpenGitCommand}" />
                        <Separator />
                        <MenuItem Header="Open containing folder" Command="{Binding RevealSelectedCommand}" />
                        <MenuItem Header="Copy full path" Command="{Binding CopySelectedPathCommand}" />
                      </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemContainerStyle>
                      <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                      </Style>
                    </TreeView.ItemContainerStyle>
                  </TreeView>
                </DockPanel>
              </layout:LayoutAnchorable>
            </layout:LayoutAnchorablePane>
            <layout:LayoutDocumentPane>
              <layout:LayoutDocument Title="Start" ContentId="Welcome" CanClose="False">
                <ScrollViewer Background="{DynamicResource EditorBrush}" VerticalScrollBarVisibility="Auto">
                  <StackPanel MaxWidth="650" Margin="48,52" HorizontalAlignment="Left">
                    <TextBlock Text="YOUR WPF WORKSPACE" Style="{StaticResource SectionLabel}" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Build with focus." FontSize="38" FontWeight="SemiBold" Margin="0,5,0,14" />
                    <TextBlock Text="A focused workspace for XAML, C#, MVVM, and the data behind your app." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="15" Margin="0,0,0,27" />
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Open solution or project" Command="{Binding OpenWorkspaceCommand}" Style="{StaticResource AccentButton}" Padding="16,10" />
                      <Button Content="Open file" Command="{Binding OpenFileCommand}" Padding="16,10" Margin="8,2,2,2" />
                    </StackPanel>
                    <TextBlock Text="RECENT WORKSPACES" Style="{StaticResource SectionLabel}" Margin="2,35,0,8" />
                    <ItemsControl ItemsSource="{Binding RecentWorkspaces}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Content="{Binding}" Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" MaxWidth="620" ToolTip="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,22,0,0">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="FIND YOUR WAY" Style="{StaticResource SectionLabel}" />
                          <TextBlock Text="Ctrl+P   Go to a file" Margin="0,4" />
                          <TextBlock Text="Ctrl+Shift+P   Run a command" Margin="0,4" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                          <TextBlock Text="BUILD SOMETHING" Style="{StaticResource SectionLabel}" />
                          <TextBlock Text="Ctrl+Shift+N   Add a WPF item" Margin="0,4" />
                          <TextBlock Text="F5   Start debugging" Margin="0,4" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
              </layout:LayoutDocument>
            </layout:LayoutDocumentPane>
            <layout:LayoutAnchorablePane DockWidth="330" DockMinWidth="260">
              <layout:LayoutAnchorable Title="WPF Explorer" ContentId="WpfTools" CanClose="False" CanHide="True" CanAutoHide="True">
                <views:WpfExplorerPane />
              </layout:LayoutAnchorable>
              <layout:LayoutAnchorable Title="ColtonGPT" ContentId="ColtonGPT" CanClose="False" CanHide="True" CanAutoHide="True">
                <ai:AssistantPane DataContext="{Binding Features.Assistant}" />
              </layout:LayoutAnchorable>
            </layout:LayoutAnchorablePane>
          </layout:LayoutPanel>
          <layout:LayoutAnchorablePane DockHeight="245" DockMinHeight="100">
            <layout:LayoutAnchorable Title="Output" ContentId="Output" CanClose="False" CanHide="True" IsSelected="True">
              <DockPanel Background="{DynamicResource SurfaceBrush}">
                <DockPanel DockPanel.Dock="Top" Margin="7,2">
                  <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearOutputCommand}" />
                  <TextBlock Text="BUILD &amp; WORKSPACE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="4,0" />
                </DockPanel>
                <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource EditorBrush}" />
              </DockPanel>
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Problems" ContentId="Problems" CanClose="False" CanHide="True">
              <DataGrid ItemsSource="{Binding Diagnostics}" SelectedItem="{Binding SelectedDiagnostic}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" b:Interaction.ActivateCommand="{Binding NavigateDiagnosticCommand}">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="85" />
                  <DataGridTextColumn Header="Code" Binding="{Binding Id}" Width="80" />
                  <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                  <DataGridTextColumn Header="File" Binding="{Binding Path}" Width="230" />
                  <DataGridTextColumn Header="Line" Binding="{Binding Line}" Width="50" />
                </DataGrid.Columns>
              </DataGrid>
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Search" ContentId="Search" CanClose="False" CanHide="True">
              <DockPanel Background="{DynamicResource SurfaceBrush}">
                <DockPanel DockPanel.Dock="Top" Margin="8,5">
                  <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding SearchCancelCommand}" />
                  <Button DockPanel.Dock="Right" Content="Search workspace" Command="{Binding SearchCommand}" />
                  <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Find text across source files">
                    <TextBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                  </TextBox>
                </DockPanel>
                <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" b:Interaction.ActivateCommand="{Binding NavigateSearchCommand}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="210" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Location}" Foreground="{DynamicResource AccentBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Text}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Terminal" ContentId="Terminal" CanClose="False" CanHide="True">
              <term:TerminalPane DataContext="{Binding Terminal}" />
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="Debugger" ContentId="Debugger" CanClose="False" CanHide="True">
              <debug:DebuggerPane DataContext="{Binding Debugger}" />
            </layout:LayoutAnchorable>
            <layout:LayoutAnchorable Title="SQL Server" ContentId="Database" CanClose="False" CanHide="True">
              <sql:DatabasePane DataContext="{Binding Database}" />
            </layout:LayoutAnchorable>
          </layout:LayoutAnchorablePane>
        </layout:LayoutPanel>
      </layout:LayoutRoot>
    </dock:DockingManager>
    <Border Grid.Row="3" Background="{DynamicResource AccentFillBrush}">
      <DockPanel Margin="12,0">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="{Binding ActiveDocument.LanguageStatus}" VerticalAlignment="Center" Margin="10,0" />
          <TextBlock Text="{Binding ActiveDocument.State.CaretLine, StringFormat=Ln {0}}" VerticalAlignment="Center" Margin="10,0" />
          <TextBlock Text="{Binding ActiveDocument.State.CaretColumn, StringFormat=Col {0}}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ThemeName}" VerticalAlignment="Center" Margin="20,0,0,0" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Grid Grid.RowSpan="4" Panel.ZIndex="20" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsPaletteOpen, Converter={StaticResource BooleanToVisibility}}">
      <Border Style="{StaticResource OverlayCard}" Width="700" MaxHeight="540" VerticalAlignment="Top" Margin="0,86,0,0" Padding="14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="QUICK OPEN / COMMAND PALETTE" Style="{StaticResource SectionLabel}" Margin="4,0,0,9" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Esc" Command="{Binding ClosePaletteCommand}" Style="{StaticResource QuietButton}" />
              <TextBox Text="{Binding PaletteQuery, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="10" b:Interaction.FocusWhenVisible="True">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding ExecutePaletteCommand}" />
                  <KeyBinding Key="Escape" Command="{Binding ClosePaletteCommand}" />
                </TextBox.InputBindings>
              </TextBox>
            </DockPanel>
          </StackPanel>
          <ListBox ItemsSource="{Binding PaletteResults}" SelectedItem="{Binding SelectedPaletteEntry}" b:Interaction.ActivateCommand="{Binding ExecutePaletteCommand}" Margin="0,10,0,0">
            <ListBox.InputBindings>
              <KeyBinding Key="Escape" Command="{Binding ClosePaletteCommand}" />
            </ListBox.InputBindings>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="3,3">
                  <TextBlock Text="{Binding Label}" />
                  <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="4" Panel.ZIndex="30" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsScaffoldOpen, Converter={StaticResource BooleanToVisibility}}">
      <Grid.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelScaffoldCommand}" />
      </Grid.InputBindings>
      <Border Style="{StaticResource OverlayCard}" Width="490" VerticalAlignment="Center">
        <StackPanel>
          <TextBlock Text="NEW WPF ITEM" Style="{StaticResource SectionLabel}" />
          <TextBlock Text="Create the pieces together." FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20" />
          <TextBlock Text="Item type" Foreground="{DynamicResource MutedBrush}" />
          <ComboBox ItemsSource="{Binding ScaffoldKinds}" SelectedItem="{Binding SelectedScaffoldKind}" Margin="0,5,0,16" />
          <TextBlock Text="Name" Foreground="{DynamicResource MutedBrush}" />
          <TextBox Text="{Binding ScaffoldName, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,13" b:Interaction.FocusWhenVisible="True" />
          <CheckBox Content="Add a view-model DataTemplate" IsChecked="{Binding AddDataTemplate}" Margin="0,0,0,17" />
          <TextBlock Text="Review generated files and resource changes before applying them to your workspace." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Cancel" Command="{Binding CancelScaffoldCommand}" />
            <Button Content="Preview files" Command="{Binding CreateWpfItemCommand}" Style="{StaticResource AccentButton}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="4" Panel.ZIndex="40" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsPreviewOpen, Converter={StaticResource BooleanToVisibility}}">
      <Grid.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelPreviewCommand}" />
      </Grid.InputBindings>
      <Border Style="{StaticResource OverlayCard}" Margin="38" MaxWidth="1380">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding PreviewTitle}" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PreviewWarnings}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Margin="0,10,0,14" />
          </StackPanel>
          <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="Cancel" Command="{Binding CancelPreviewCommand}" />
              <Button Content="Apply changes" Command="{Binding AcceptPreviewCommand}" Style="{StaticResource AccentButton}" />
            </StackPanel>
            <TextBlock Text="Review every file before applying." Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
          </DockPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding PreviewChanges}" SelectedItem="{Binding SelectedPreviewChange}" Margin="0,0,10,0">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,4">
                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Path}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,5,0,0" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <DockPanel Grid.Column="1" Margin="0,0,6,0">
              <TextBlock DockPanel.Dock="Top" Text="BEFORE" Style="{StaticResource SectionLabel}" />
              <TextBox Text="{Binding SelectedPreviewChange.Before, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
            <DockPanel Grid.Column="2" Margin="6,0,0,0">
              <TextBlock DockPanel.Dock="Top" Text="AFTER" Style="{StaticResource SectionLabel}" />
              <TextBox Text="{Binding SelectedPreviewChange.After, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
            </DockPanel>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
    <Grid Grid.RowSpan="4" Panel.ZIndex="60" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsSettingsOpen, Converter={StaticResource BooleanToVisibility}}">
      <Grid.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CloseSettingsCommand}" />
      </Grid.InputBindings>
      <Border Style="{StaticResource OverlayCard}" Width="650" MaxHeight="760" Margin="20" VerticalAlignment="Center">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseSettingsCommand}" />
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Switch light / dark" Command="{Binding ToggleThemeCommand}" />
                <StackPanel>
                  <TextBlock Text="Appearance" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ThemeName}" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
              </DockPanel>
              <ai:AssistantSettingsView DataContext="{Binding Features.Assistant.Settings}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
