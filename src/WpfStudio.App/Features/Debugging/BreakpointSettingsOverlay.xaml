<UserControl x:Class="WpfStudio.App.Features.Debugging.BreakpointSettingsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfStudio.App.Features.Debugging"
             xmlns:c="clr-namespace:WpfStudio.App.Controls"
             xmlns:b="clr-namespace:WpfStudio.App.Behaviors">
  <!-- One breakpoint's settings: a condition, a hit count and a tracepoint message, each turned on by its box.
       The DataContext is a BreakpointSettingsViewModel. -->
  <UserControl.Resources>
    <!-- Part of the form that is turned off: still editable, and editing it turns it on. -->
    <Style x:Key="ConditionBody" TargetType="FrameworkElement">
      <Style.Triggers><DataTrigger Binding="{Binding UseCondition}" Value="False"><Setter Property="Opacity" Value="0.55" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="HitCountBody" TargetType="FrameworkElement">
      <Style.Triggers><DataTrigger Binding="{Binding UseHitCount}" Value="False"><Setter Property="Opacity" Value="0.55" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="LogMessageBody" TargetType="FrameworkElement">
      <Style.Triggers><DataTrigger Binding="{Binding UseLogMessage}" Value="False"><Setter Property="Opacity" Value="0.55" /></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="PartToggle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- Inserts its text into the message. It never takes focus, so the caret stays where it was in the message. -->
    <Style x:Key="TokenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="MinHeight" Value="22" />
      <Setter Property="Padding" Value="7,1" />
      <Setter Property="Margin" Value="0,0,4,4" />
      <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
    <DataTemplate DataType="{x:Type local:TracepointPart}">
      <Border x:Name="Chip" CornerRadius="3" Margin="0,1" Background="Transparent">
        <TextBlock x:Name="Label" Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="Expression">
          <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
          <Setter TargetName="Chip" Property="Padding" Value="4,0" />
          <Setter TargetName="Chip" Property="Margin" Value="1,1" />
          <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentBrush}" />
          <Setter TargetName="Label" Property="FontFamily" Value="{StaticResource CodeFont}" />
          <Setter TargetName="Label" Property="ToolTip" Value="Evaluated in the stopped frame" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="Keyword">
          <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WarningSoftBrush}" />
          <Setter TargetName="Chip" Property="Padding" Value="4,0" />
          <Setter TargetName="Chip" Property="Margin" Value="1,1" />
          <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource WarningBrush}" />
          <Setter TargetName="Label" Property="FontFamily" Value="{StaticResource CodeFont}" />
          <Setter TargetName="Label" Property="ToolTip" Value="Replaced by the debugger when the breakpoint is hit" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Background="{DynamicResource OverlayBrush}">
    <Grid.InputBindings>
      <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
      <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
    </Grid.InputBindings>
    <Border Style="{StaticResource OverlayCard}" Width="620" VerticalAlignment="Center" Margin="0,16" Padding="28,24" AutomationProperties.Name="Breakpoint settings">
      <!-- Scrolls only when the window is too short for the whole form. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <StackPanel>
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Close" Command="{Binding CancelCommand}" ToolTip="Cancel (Esc)" />
          <c:Glyph DockPanel.Dock="Left" Kind="Bug" Width="18" Height="18" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Breakpoint settings" FontSize="20" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center" />
        </DockPanel>
        <WrapPanel Margin="0,0,0,18">
          <TextBlock Text="{Binding Location}" Style="{StaticResource Caption}" FontSize="12" />
          <TextBlock Text=" · saving adds a breakpoint on this line" Style="{StaticResource Caption}" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                     Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibility}}" />
        </WrapPanel>

        <TextBlock Text="CONDITIONS" Style="{StaticResource SectionLabel}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
          <StackPanel>
            <CheckBox Style="{StaticResource PartToggle}" Content="Condition" IsChecked="{Binding UseCondition}" ToolTip="Only when a C# expression is true" />
            <DockPanel Style="{StaticResource ConditionBody}">
              <TextBlock DockPanel.Dock="Left" Text="When" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock DockPanel.Dock="Right" Text="is true" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource MutedBrush}" />
              <TextBox Text="{Binding Condition, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" c:Ui.Placeholder="order.Total &gt; 100"
                       b:Interaction.FocusWhenTrue="{Binding FocusCondition}" AutomationProperties.Name="Condition expression" ToolTip="A C# expression, evaluated in the frame that hits the breakpoint" />
            </DockPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,16">
          <StackPanel>
            <CheckBox Style="{StaticResource PartToggle}" Content="Hit count" IsChecked="{Binding UseHitCount}" ToolTip="Only on some of the hits, counted after the condition is true" />
            <StackPanel Orientation="Horizontal" Style="{StaticResource HitCountBody}">
              <TextBlock Text="When the hit count" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}" />
              <ComboBox ItemsSource="{Binding HitKinds}" SelectedItem="{Binding HitKind}" DisplayMemberPath="Text" Width="150" AutomationProperties.Name="Hit count comparison" />
              <c:NumberBox Value="{Binding HitTarget}" Minimum="1" Maximum="1000000" Width="104" Margin="8,0,0,0"
                           b:Interaction.FocusWhenTrue="{Binding FocusHitCount}" AutomationProperties.Name="Hit count" />
            </StackPanel>
          </StackPanel>
        </Border>

        <TextBlock Text="ACTIONS" Style="{StaticResource SectionLabel}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
          <StackPanel>
            <CheckBox Style="{StaticResource PartToggle}" Content="Log a message to Debugger &gt; Output and continue (tracepoint)" IsChecked="{Binding UseLogMessage}" ToolTip="Off, the breakpoint breaks" />
            <StackPanel Style="{StaticResource LogMessageBody}">
              <TextBox x:Name="MessageText" Text="{Binding LogMessage, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" c:Ui.Placeholder="Total is {order.Total} in $FUNCTION"
                       b:Interaction.FocusWhenTrue="{Binding FocusLogMessage}" AutomationProperties.Name="Log message" />
              <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="Insert" Style="{StaticResource Caption}" Margin="0,4,8,0" />
                <ItemsControl ItemsSource="{Binding Tokens}" Focusable="False">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TracepointToken}">
                      <Button Style="{StaticResource TokenButton}" Content="{Binding Label}" ToolTip="{Binding Description}" Click="InsertToken" AutomationProperties.Name="{Binding Label, StringFormat='Insert {0}'}" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
              <DockPanel Margin="0,4,0,0" Visibility="{Binding LogMessage, Converter={StaticResource Presence}}">
                <TextBlock DockPanel.Dock="Left" Text="Reads as" Style="{StaticResource Caption}" Margin="0,2,8,0" />
                <ItemsControl ItemsSource="{Binding MessagePreview}" Focusable="False" AutomationProperties.Name="How the message is read">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
              </DockPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="10,7">
          <DockPanel>
            <c:Glyph DockPanel.Dock="Left" Kind="Info" Width="14" Height="14" Margin="0,1,8,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </DockPanel>
        </Border>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Error, Converter={StaticResource Presence}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Content="Save" c:Ui.Icon="Check" Command="{Binding SaveCommand}" Style="{StaticResource AccentButton}" Margin="8,2,0,2" ToolTip="Save and apply to the running program (Enter)" />
        </StackPanel>
      </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
