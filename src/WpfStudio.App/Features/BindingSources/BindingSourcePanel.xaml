<UserControl x:Class="WpfStudio.App.Features.BindingSources.BindingSourcePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="8,4,8,8">
  <DockPanel>
   <Button DockPanel.Dock="Right" Content="Show binding XAML" Command="{Binding ShowBindingSourceCommand}"
           CommandParameter="{Binding SelectedBindingDeclaration}" Margin="6,0,0,0" AutomationProperties.Name="Show binding XAML"/>
   <ComboBox ItemsSource="{Binding BindingDeclarations}" SelectedItem="{Binding SelectedBindingDeclaration,Mode=TwoWay}"
             DisplayMemberPath="Label" ToolTip="{Binding SelectedBindingDeclaration.Label}" AutomationProperties.Name="Binding declaration"/>
  </DockPanel>
  <TextBlock Text="{Binding BindingSourceStatus}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"
             Margin="0,4,0,0" AutomationProperties.Name="Binding source status"/>
  <TextBlock Text="{Binding BindingDeclarationCoverage}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"
             AutomationProperties.Name="Binding declaration coverage">
   <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
    <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
   </Style.Triggers></Style></TextBlock.Style>
  </TextBlock>
 </StackPanel>
</UserControl>
