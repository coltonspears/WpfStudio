<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:WpfStudio.App.Controls"
                    xmlns:api="clr-namespace:WpfStudio.App.Features.Api"
                    xmlns:editor="http://icsharpcode.net/sharpdevelop/avalonedit">
  <!-- Shared by the API client's pane and its model generator. -->
  <api:ChoiceConverter x:Key="Choice" />
  <api:MethodBrushConverter x:Key="MethodBrush" />
  <api:ToneBrushConverter x:Key="ToneBrush" />
  <api:HiddenWhenTrueConverter x:Key="Hidden" />

  <Style x:Key="RowName" TargetType="TextBlock">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="Margin" Value="0,12,0,4" />
  </Style>
  <Style x:Key="DialogTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style x:Key="GroupHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionLabel}">
    <Setter Property="Margin" Value="0,16,0,6" />
  </Style>
  <!-- A heading that can be edited in place: a request's or collection's name. -->
  <Style x:Key="TitleBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="3,1" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource EditorBrush}" /></Trigger>
    </Style.Triggers>
  </Style>
  <!-- Text that can be selected and copied but not edited. -->
  <Style x:Key="SelectableText" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" /></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="EditorFrame" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="1" />
    <Setter Property="Background" Value="{DynamicResource EditorBrush}" />
  </Style>
  <Style x:Key="CodeEditor" TargetType="editor:TextEditor">
    <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Background" Value="{DynamicResource EditorBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    <Setter Property="LineNumbersForeground" Value="{DynamicResource GutterTextBrush}" />
    <Setter Property="ShowLineNumbers" Value="True" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <!-- A section switch: its name, a count beside it from Tag, and a line under the chosen one. -->
  <Style x:Key="SectionTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="11,5,11,4" Margin="1,0">
            <StackPanel Orientation="Horizontal">
              <ContentPresenter VerticalAlignment="Center" />
              <Border x:Name="Count" Style="{StaticResource Badge}" Margin="6,0,0,0" Padding="5,0">
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}" />
              </Border>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="{x:Null}"><Setter TargetName="Count" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="Tag" Value=""><Setter TargetName="Count" Property="Visibility" Value="Collapsed" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Open requests as tabs: method, name, and a close button. -->
  <Style x:Key="RequestTabs" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,0,0,0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter.Value></Setter>
    <Setter Property="ItemContainerStyle">
      <Setter.Value>
        <Style TargetType="ListBoxItem">
          <Setter Property="FocusVisualStyle" Value="{x:Null}" />
          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,2,0,0" Padding="10,5,4,5" Margin="0,0,1,0" MaxWidth="260">
                  <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                  <Trigger Property="IsSelected" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate DataType="{x:Type api:ApiRequestTabViewModel}">
          <DockPanel ToolTip="{Binding UrlText}">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Close" Width="20" Height="20" Margin="6,0,0,0" ToolTip="Close"
                    Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding Method}" FontSize="10.5" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{Binding Method, Converter={StaticResource MethodBrush}}" />
            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A table of name and value rows, always with a blank row at the end for the next one. -->
  <DataTemplate x:Key="KeyValueTable" DataType="{x:Type api:KeyValueTableViewModel}">
    <StackPanel>
      <Grid Margin="0,0,0,3">
        <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
        <TextBlock Grid.Column="1" Text="{Binding KeyPlaceholder}" Style="{StaticResource Caption}" Margin="4,0" />
        <TextBlock Grid.Column="2" Text="{Binding ValuePlaceholder}" Style="{StaticResource Caption}" Margin="4,0" />
        <TextBlock Grid.Column="3" Text="Description" Style="{StaticResource Caption}" Margin="4,0" />
      </Grid>
      <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type api:KeyValueRowViewModel}">
            <Grid x:Name="Row" Margin="0,1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
              <CheckBox IsChecked="{Binding Enabled}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Send this row" AutomationProperties.Name="Enabled" />
              <TextBox x:Name="KeyBox" Grid.Column="1" Margin="0,0,4,0" Text="{Binding Key, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}"
                       c:Ui.Placeholder="{Binding DataContext.KeyPlaceholder, RelativeSource={RelativeSource AncestorType=ItemsControl}}" AutomationProperties.Name="Name" />
              <Grid Grid.Column="2" Margin="0,0,4,0">
                <TextBox x:Name="ValueBox" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}"
                         c:Ui.Placeholder="{Binding DataContext.ValuePlaceholder, RelativeSource={RelativeSource AncestorType=ItemsControl}}" AutomationProperties.Name="Value" />
                <Border x:Name="Mask" Background="{DynamicResource EditorBrush}" Margin="1" CornerRadius="5" IsHitTestVisible="False" Visibility="Collapsed">
                  <TextBlock Text="••••••••" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                </Border>
              </Grid>
              <TextBox Grid.Column="3" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource MutedBrush}" AutomationProperties.Name="Description" />
              <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="4,0,0,0">
                <ToggleButton Style="{StaticResource IconButton}" c:Ui.Icon="File" IsChecked="{Binding IsFile}" ToolTip="Upload a file: the value is its path"
                              Visibility="{Binding DataContext.AllowFiles, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibility}}" />
                <Button Style="{StaticResource IconButton}" c:Ui.Icon="FolderOpen" ToolTip="Choose a file" CommandParameter="{Binding}"
                        Command="{Binding DataContext.BrowseFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Visibility="{Binding DataContext.AllowFiles, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibility}}" />
                <ToggleButton Style="{StaticResource IconButton}" c:Ui.Icon="Eye" IsChecked="{Binding Secret}" ToolTip="Secret: hidden on screen, protected for your Windows account on disk, and left out of exports"
                              Visibility="{Binding DataContext.AllowSecrets, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BooleanToVisibility}}" />
                <Button Style="{StaticResource IconButton}" c:Ui.Icon="Close" ToolTip="Remove this row" CommandParameter="{Binding}"
                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
              </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding Secret}" Value="True" />
                  <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ValueBox}" Value="False" />
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Mask" Property="Visibility" Value="Visible" />
              </MultiDataTrigger>
              <DataTrigger Binding="{Binding Enabled}" Value="False">
                <Setter TargetName="KeyBox" Property="Opacity" Value="0.5" />
                <Setter TargetName="ValueBox" Property="Opacity" Value="0.5" />
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DataTemplate>

  <!-- A header or cookie of a response. -->
  <DataTemplate x:Key="ReadOnlyPair">
    <Grid Margin="0,3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Key}" Margin="0,0,12,0" />
      <StackPanel Grid.Column="1">
        <TextBox Text="{Binding Value, Mode=OneWay}" Style="{StaticResource SelectableText}" FontFamily="{StaticResource CodeFont}" />
        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Visibility="{Binding Description, Converter={StaticResource Presence}}" />
      </StackPanel>
    </Grid>
  </DataTemplate>

  <!-- Sign-in: a kind, and the fields that kind needs. -->
  <DataTemplate x:Key="AuthEditor" DataType="{x:Type api:AuthEditorViewModel}">
    <StackPanel>
      <TextBlock Text="Type" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding Kinds}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Kind}" Width="260" HorizontalAlignment="Left" AutomationProperties.Name="Authorization type" />
      <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
      <StackPanel Visibility="{Binding Kind, Converter={StaticResource EqualsVisibility}, ConverterParameter=Bearer}">
        <TextBlock Text="Token" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" c:Ui.Placeholder="{}{{bearerToken}} or the token itself" AutomationProperties.Name="Bearer token" />
      </StackPanel>
      <StackPanel Visibility="{Binding Kind, Converter={StaticResource EqualsVisibility}, ConverterParameter=Basic}">
        <TextBlock Text="User name" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="User name" />
        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
        <PasswordBox api:ApiPassword.Value="{Binding Password, Mode=TwoWay}" AutomationProperties.Name="Password" />
      </StackPanel>
      <StackPanel Visibility="{Binding Kind, Converter={StaticResource EqualsVisibility}, ConverterParameter=ApiKey}">
        <TextBlock Text="Key name" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding KeyName, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" AutomationProperties.Name="API key name" />
        <TextBlock Text="Value" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding KeyValue, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" c:Ui.Placeholder="{}{{apiKey}} or the key itself" AutomationProperties.Name="API key value" />
        <TextBlock Text="Add to" Style="{StaticResource FieldLabel}" />
        <ComboBox ItemsSource="{Binding KeyLocations}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding KeyLocation}" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="API key location" />
      </StackPanel>
      <TextBlock Text="Credentials typed here are protected for your Windows account when saved, and left out when a collection is exported." Style="{StaticResource Caption}" Margin="0,12,0,0" />
    </StackPanel>
  </DataTemplate>

  <!-- A proxy chosen instead of the one in Settings. -->
  <DataTemplate x:Key="ProxyEditor" DataType="{x:Type api:ProxyEditorViewModel}">
    <StackPanel>
      <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4"><Run Text="Proxy for " /><Run Text="{Binding Scope, Mode=OneWay}" /></TextBlock>
      <ComboBox ItemsSource="{Binding Modes}" SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Mode}" Width="300" HorizontalAlignment="Left" AutomationProperties.Name="Proxy" />
      <TextBlock Text="{Binding Explanation}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
      <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource BooleanToVisibility}}">
        <TextBlock Text="Proxy server" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" c:Ui.Placeholder="http://proxy.example.com:8080" AutomationProperties.Name="Proxy address" />
        <TextBlock Text="{Binding AddressError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0" Visibility="{Binding AddressError, Converter={StaticResource Presence}}" />
        <TextBlock Text="Skip the proxy for" Style="{StaticResource FieldLabel}" />
        <TextBox Text="{Binding Bypass, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" c:Ui.Placeholder="*.internal.example.com; 10.*; build-server:8080" AutomationProperties.Name="Proxy bypass list" />
        <TextBlock Text="Hosts separated by semicolons. * matches any characters; &lt;local&gt; matches names without a dot." Style="{StaticResource Caption}" Margin="0,4,0,0" />
        <CheckBox IsChecked="{Binding BypassLocalAddresses}" Content="Skip the proxy for local addresses (localhost, 127.0.0.1 and single-label names)" Margin="0,10,0,0" />
      </StackPanel>
      <StackPanel Visibility="{Binding HasCredentials, Converter={StaticResource BooleanToVisibility}}">
        <CheckBox IsChecked="{Binding UseDefaultCredentials}" Content="Sign in to the proxy as the Windows user" Margin="0,12,0,0" ToolTip="NTLM or Kerberos, with the account WpfStudio runs as" />
        <StackPanel IsEnabled="{Binding UseDefaultCredentials, Converter={StaticResource Not}}">
          <TextBlock Text="Proxy user name" Style="{StaticResource FieldLabel}" />
          <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="user or DOMAIN\user; empty when the proxy needs no sign-in" AutomationProperties.Name="Proxy user name" />
          <TextBlock Text="Proxy password" Style="{StaticResource FieldLabel}" />
          <PasswordBox api:ApiPassword.Value="{Binding Password, Mode=TwoWay}" AutomationProperties.Name="Proxy password" />
        </StackPanel>
      </StackPanel>
      <Border Style="{StaticResource Card}" Background="{DynamicResource AccentSoftBrush}" BorderThickness="0" Margin="0,16,0,0">
        <DockPanel>
          <c:Glyph DockPanel.Dock="Left" Kind="Globe" Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentBrush}" />
          <TextBlock TextWrapping="Wrap"><Run Text="Requests go through: " /><Run Text="{Binding Effective, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
        </DockPanel>
      </Border>
    </StackPanel>
  </DataTemplate>

  <!-- What can be done with a collection, folder or request in the sidebar. -->
  <ContextMenu x:Key="NodeMenu" x:Shared="False" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
    <MenuItem Header="Open" c:Ui.Icon="File" Command="{Binding OpenNodeCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              Visibility="{Binding PlacementTarget.DataContext.IsRequest, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibility}}" />
    <MenuItem Header="New request" c:Ui.Icon="Plus" Command="{Binding NewRequestInCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              Visibility="{Binding PlacementTarget.DataContext.CanContain, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibility}}" />
    <MenuItem Header="New folder" c:Ui.Icon="Folder" Command="{Binding NewFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              Visibility="{Binding PlacementTarget.DataContext.CanContain, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibility}}" />
    <MenuItem Header="Duplicate" c:Ui.Icon="Copy" Command="{Binding DuplicateNodeCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              Visibility="{Binding PlacementTarget.DataContext.IsRequest, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibility}}" />
    <MenuItem Header="Rename…" Command="{Binding RenameNodeCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
    <Separator />
    <MenuItem Header="Collection settings…" c:Ui.Icon="Settings" Command="{Binding EditCollectionCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              Visibility="{Binding PlacementTarget.DataContext.IsCollection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibility}}" />
    <MenuItem Header="Generate C# models…" c:Ui.Icon="Braces" Command="{Binding GenerateFromCollectionCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              Visibility="{Binding PlacementTarget.DataContext.IsCollection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibility}}" />
    <MenuItem Header="Export…" c:Ui.Icon="Export" Command="{Binding ExportCollectionCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
              Visibility="{Binding PlacementTarget.DataContext.IsCollection, RelativeSource={RelativeSource AncestorType=ContextMenu}, Converter={StaticResource BooleanToVisibility}}" />
    <Separator />
    <MenuItem Header="Delete…" c:Ui.Icon="Trash" Command="{Binding DeleteNodeCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
  </ContextMenu>
</ResourceDictionary>
