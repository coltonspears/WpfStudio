<UserControl x:Class="WpfStudio.App.Features.DevOps.PullRequestsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:WpfStudio.App.Features.DevOps" xmlns:c="clr-namespace:WpfStudio.App.Controls" xmlns:diff="clr-namespace:WpfStudio.App.Controls.Diff"
 xmlns:b="clr-namespace:WpfStudio.App.Behaviors" xmlns:core="clr-namespace:WpfStudio.Core.DevOps;assembly=WpfStudio.Core">
 <!-- DataContext: DevOpsViewModel. The list and details use its PullRequests; the form uses its NewPullRequest. -->
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DevOpsStyles.xaml"/></ResourceDictionary.MergedDictionaries>
   <DataTemplate x:Key="FileTemplate" DataType="{x:Type core:DevOpsPullRequestFile}">
    <DockPanel ToolTip="{Binding Path}" Background="Transparent" MinHeight="22">
     <TextBlock DockPanel.Dock="Left" Text="{Binding Letter}" Width="14" FontFamily="{StaticResource CodeFont}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
      <TextBlock Text="{Binding AddedText}" Foreground="{DynamicResource SuccessBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
      <TextBlock Text="{Binding RemovedText}" Foreground="{DynamicResource DangerBrush}" FontSize="11" FontWeight="SemiBold"/>
     </StackPanel>
     <c:StudioIcon DockPanel.Dock="Left" Kind="{Binding Path, Converter={StaticResource FileIconKind}}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
     <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center"><Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource SubtleBrush}" FontSize="11"/></TextBlock>
    </DockPanel>
   </DataTemplate>
   <Style x:Key="PullRequestItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
    <Setter Property="ContextMenu"><Setter.Value>
     <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Open on the web" c:Ui.Icon="Link" Command="{Binding OpenInBrowserCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
      <MenuItem Header="Copy link" c:Ui.Icon="Copy" Command="{Binding CopyLinkCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
      <MenuItem Header="Copy source branch" Command="{x:Static b:Interaction.CopyCommand}" CommandParameter="{Binding PlacementTarget.DataContext.SourceBranch, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
     </ContextMenu>
    </Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="360" MinWidth="260"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="420"/></Grid.ColumnDefinitions>

  <!-- The lists. -->
  <DockPanel DataContext="{Binding PullRequests}" Margin="10,10,8,8">
   <DockPanel DockPanel.Dock="Top">
    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="New" c:Ui.Icon="Plus" Command="{Binding StartCreateCommand}" Margin="8,0,0,0"
            ToolTip="Create a pull request from the Git pane's current branch"/>
    <ComboBox ItemsSource="{Binding Lists}" SelectedItem="{Binding SelectedList}" DisplayMemberPath="Label" AutomationProperties.Name="Pull request list"/>
   </DockPanel>
   <TextBlock DockPanel.Dock="Top" Style="{StaticResource Meta}" Margin="2,8,0,6">
    <Run Text="{Binding Items.Count, Mode=OneWay}"/><Run Text=" pull requests"/>
   </TextBlock>
   <Grid>
    <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" ItemTemplate="{StaticResource PullRequestTemplate}"
             ItemContainerStyle="{StaticResource PullRequestItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Pull requests"
             b:Interaction.ActivateCommand="{Binding OpenInBrowserCommand}"/>
    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource EmptyHint}" Visibility="{Binding Items.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>
   </Grid>
  </DockPanel>
  <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
  <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}" IsHitTestVisible="False"/>

  <!-- The selected pull request. -->
  <Grid Grid.Column="2" DataContext="{Binding PullRequests}">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Current, Converter={StaticResource Presence}, ConverterParameter=Invert}">
    <c:Glyph Kind="PullRequest" Width="28" Height="28" Foreground="{DynamicResource SubtleBrush}"/>
    <TextBlock Text="Select a pull request to review it." Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
   </StackPanel>
   <DockPanel Visibility="{Binding Current, Converter={StaticResource Presence}}">
    <Border DockPanel.Dock="Top" Padding="18,14,16,10" Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
     <StackPanel>
      <TextBlock Text="{Binding Current.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding Current.Title}"/>
      <WrapPanel Margin="0,6,0,0">
       <Border DataContext="{Binding Current}" Style="{StaticResource StateChip}"><TextBlock Style="{StaticResource ChipText}" Text="{Binding StatusText}"/></Border>
       <Border Style="{StaticResource Chip}" Visibility="{Binding Current.AutoComplete, Converter={StaticResource BooleanToVisibility}}" BorderBrush="{DynamicResource AccentBrush}" TextElement.Foreground="{DynamicResource AccentBrush}">
        <TextBlock Style="{StaticResource ChipText}" Text="auto-complete"/>
       </Border>
       <Border Style="{StaticResource Chip}" Visibility="{Binding Current.IsFromFork, Converter={StaticResource BooleanToVisibility}}"><TextBlock Style="{StaticResource ChipText}" Text="from a fork"/></Border>
       <Border Style="{StaticResource Chip}" BorderBrush="{DynamicResource DangerBrush}" TextElement.Foreground="{DynamicResource DangerBrush}">
        <Border.Visibility><Binding Path="Current.MergeState" Converter="{StaticResource EqualsVisibility}" ConverterParameter="Conflicts"/></Border.Visibility>
        <TextBlock Style="{StaticResource ChipText}" Text="merge conflicts"/>
       </Border>
       <ItemsControl ItemsSource="{Binding Current.LabelList}" Focusable="False">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Chip}"><TextBlock Style="{StaticResource ChipText}" Text="{Binding}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
       <TextBlock Style="{StaticResource Meta}">
        <Run Text="!"/><Run Text="{Binding Current.Number, Mode=OneWay}"/><Run Text=" by "/><Run Text="{Binding Current.Author.DisplayName, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/>
        <Run Text=" · "/><Run Text="{Binding Current.SourceBranch, Mode=OneWay}" FontFamily="{StaticResource CodeFont}"/><Run Text=" → "/><Run Text="{Binding Current.TargetBranch, Mode=OneWay}" FontFamily="{StaticResource CodeFont}"/>
        <Run Text=" · "/><Run Text="{Binding Current.CreatedText, Mode=OneWay}"/>
       </TextBlock>
      </WrapPanel>
      <!-- What can be done: votes or a review, completion, and the request's state. -->
      <WrapPanel Margin="0,10,0,0">
       <Button Style="{StaticResource AccentButton}" Content="Approve" c:Ui.Icon="Check" Margin="0,0,4,4" Command="{Binding VoteCommand}" CommandParameter="{x:Static core:ReviewVote.Approved}"/>
       <Button Style="{StaticResource ActionButton}" Content="Approve with suggestions" Command="{Binding VoteCommand}" CommandParameter="{x:Static core:ReviewVote.ApprovedWithSuggestions}"
               Visibility="{Binding CanVoteOnService, Converter={StaticResource BooleanToVisibility}}"/>
       <Button Style="{StaticResource ActionButton}" Content="Wait for author" Command="{Binding VoteCommand}" CommandParameter="{x:Static core:ReviewVote.WaitingForAuthor}"
               Visibility="{Binding CanVoteOnService, Converter={StaticResource BooleanToVisibility}}"/>
       <Button Style="{StaticResource ActionButton}" Content="Reject" Command="{Binding VoteCommand}" CommandParameter="{x:Static core:ReviewVote.Rejected}"
               Visibility="{Binding CanVoteOnService, Converter={StaticResource BooleanToVisibility}}"/>
       <Button Style="{StaticResource ActionButton}" Content="Reset vote" Command="{Binding VoteCommand}" CommandParameter="{x:Static core:ReviewVote.None}"
               Visibility="{Binding CanVoteOnService, Converter={StaticResource BooleanToVisibility}}"/>
       <Button Style="{StaticResource ActionButton}" Content="Request changes" Command="{Binding VoteCommand}" CommandParameter="{x:Static core:ReviewVote.ChangesRequested}"
               Visibility="{Binding CanVoteOnService, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>
       <Border Width="1" Height="18" Background="{DynamicResource BorderBrush}" Margin="4,0,8,4"/>
       <ToggleButton x:Name="CompleteToggle" Style="{StaticResource ToolbarToggle}" IsChecked="{Binding IsCompleteOpen}" IsEnabled="{Binding CanCompleteNow}" Margin="0,0,4,4" c:Ui.Icon="Commit"
                     Content="{Binding CompleteVerb}" ToolTip="Choose how to merge, then complete"/>
       <Popup PlacementTarget="{Binding ElementName=CompleteToggle}" Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=CompleteToggle}" PopupAnimation="Fade">
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,8,12" Width="340" Effect="{StaticResource PopupShadow}">
         <StackPanel>
          <TextBlock Text="MERGE TYPE" Style="{StaticResource SectionLabel}"/>
          <ComboBox ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}" AutomationProperties.Name="Merge type">
           <ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Label}"/><TextBlock Text="{Binding Description}" Style="{StaticResource Meta}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
          <CheckBox Content="Delete the source branch afterwards" IsChecked="{Binding DeleteSourceBranch}" Margin="0,10,0,0"/>
          <CheckBox Content="Complete linked work items" IsChecked="{Binding CompleteWorkItems}" Margin="0,6,0,0" Visibility="{Binding HasCompleteWorkItems, Converter={StaticResource BooleanToVisibility}}"/>
          <TextBlock Text="{Binding ChecksSummary}" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
          <Button Style="{StaticResource AccentButton}" Content="{Binding CompleteVerb}" c:Ui.Icon="Check" Command="{Binding CompleteCommand}" HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
         </StackPanel>
        </Border>
       </Popup>
       <Button Style="{StaticResource ActionButton}" Content="{Binding AutoCompleteText}" Command="{Binding ToggleAutoCompleteCommand}" Visibility="{Binding HasAutoComplete, Converter={StaticResource BooleanToVisibility}}"
               ToolTip="Complete automatically once every required policy passes, with the merge type chosen under Complete"/>
       <Button Style="{StaticResource ActionButton}" Content="Publish" c:Ui.Icon="ArrowUp" Command="{Binding PublishCommand}" Visibility="{Binding Current.IsDraft, Converter={StaticResource BooleanToVisibility}}" ToolTip="Mark as ready for review"/>
       <Button Style="{StaticResource ActionButton}" Content="Check out" c:Ui.Icon="Git" Command="{Binding CheckOutCommand}" ToolTip="Fetch the source branch and switch to it in the Git pane. Needs a clean working tree."/>
       <Button Style="{StaticResource IconButton}" c:Ui.Icon="More" Margin="0,0,4,4" ToolTip="More actions" AutomationProperties.Name="More pull request actions" Click="ShowMore">
        <Button.ContextMenu>
         <ContextMenu>
          <MenuItem Header="Rename…" Command="{Binding EditCommand}"/>
          <MenuItem Header="Mark as draft" Command="{Binding MarkDraftCommand}"/>
          <MenuItem Header="{Binding AbandonVerb}" HeaderStringFormat="{}{0}…" c:Ui.Icon="Close" Command="{Binding AbandonCommand}"/>
          <MenuItem Header="{Binding ReactivateVerb}" Command="{Binding ReactivateCommand}"/>
          <Separator/>
          <MenuItem Header="Open on the web" c:Ui.Icon="Link" Command="{Binding OpenInBrowserCommand}"/>
          <MenuItem Header="Copy link" c:Ui.Icon="Copy" Command="{Binding CopyLinkCommand}"/>
         </ContextMenu>
        </Button.ContextMenu>
       </Button>
       <TextBlock Text="{Binding MyVoteText}" Style="{StaticResource Meta}" Margin="6,0,0,4"/>
      </WrapPanel>
     </StackPanel>
    </Border>

    <TabControl SelectedIndex="{Binding DetailTab}">
     <TabItem Header="Overview" AutomationProperties.Name="Overview">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <StackPanel Margin="18,8,18,18" MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="DESCRIPTION" Style="{StaticResource Heading}" Margin="0,8,0,8"/>
        <TextBox Text="{Binding Current.Description, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0"
                 AutomationProperties.Name="Description" Visibility="{Binding Current.Description, Converter={StaticResource Presence}}"/>
        <TextBlock Text="No description." Style="{StaticResource Caption}" Visibility="{Binding Current.Description, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>

        <TextBlock Text="REVIEWERS" Style="{StaticResource Heading}"/>
        <ItemsControl ItemsSource="{Binding Reviewers}" Focusable="False">
         <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type core:DevOpsReviewer}">
           <DockPanel Margin="0,3">
            <ContentPresenter DockPanel.Dock="Left" Content="{Binding Identity}" ContentTemplate="{StaticResource Avatar}" Margin="0,0,8,0"/>
            <TextBlock DockPanel.Dock="Right" Text="{Binding VoteText}" Style="{StaticResource VoteText}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right" Text="required" Style="{StaticResource Meta}" Margin="8,0,0,0" Visibility="{Binding IsRequired, Converter={StaticResource BooleanToVisibility}}"/>
            <TextBlock Text="{Binding Identity.DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
           </DockPanel>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="No reviewers yet." Style="{StaticResource Caption}" Visibility="{Binding Reviewers.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>

        <TextBlock Style="{StaticResource Heading}"><Run Text="CHECKS · "/><Run Text="{Binding ChecksSummary, Mode=OneWay}"/></TextBlock>
        <ListBox ItemsSource="{Binding Details.Checks}" ItemTemplate="{StaticResource CheckTemplate}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Checks"
                 b:Interaction.ActivateCommand="{Binding OpenCheckCommand}" Visibility="{Binding HasChecks, Converter={StaticResource BooleanToVisibility}}" ToolTip="Double-click a check to open its results"/>

        <StackPanel Visibility="{Binding HasWorkItems, Converter={StaticResource BooleanToVisibility}}">
         <TextBlock Text="LINKED WORK ITEMS" Style="{StaticResource Heading}"/>
         <ItemsControl ItemsSource="{Binding Details.WorkItemIds}" Focusable="False">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <Button Style="{StaticResource QuietButton}" Content="{Binding}" ContentStringFormat="#{0}" c:Ui.Icon="WorkItem" Margin="0,0,6,4"
                    Command="{Binding DataContext.OpenWorkItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>

        <TextBlock Text="DISCUSSION" Style="{StaticResource Heading}"/>
        <ItemsControl ItemsSource="{Binding Threads}" Focusable="False">
         <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:PullRequestThreadViewModel}">
           <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="12,8">
            <StackPanel>
             <DockPanel Visibility="{Binding HasLocation, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,2">
              <TextBlock DockPanel.Dock="Right" Text="{Binding Thread.StatusText}" Style="{StaticResource Meta}"/>
              <TextBlock Text="{Binding Thread.Location}" FontFamily="{StaticResource CodeFont}" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
             </DockPanel>
             <TextBlock Text="{Binding Thread.StatusText}" Style="{StaticResource Meta}" HorizontalAlignment="Right"
                        Visibility="{Binding HasLocation, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>
             <ContentPresenter Content="{Binding First}" ContentTemplate="{StaticResource CommentTemplate}"/>
             <ItemsControl ItemsSource="{Binding Replies}" ItemTemplate="{StaticResource CommentTemplate}" Margin="30,0,0,0" Focusable="False"/>
             <WrapPanel Margin="28,6,0,0">
              <Button Style="{StaticResource QuietButton}" Content="Reply" Command="{Binding StartReplyCommand}" Padding="6,2"/>
              <Button Style="{StaticResource QuietButton}" Content="Resolve" c:Ui.Icon="Check" Command="{Binding ResolveCommand}" Padding="6,2"
                      Visibility="{Binding CanResolveHere, Converter={StaticResource BooleanToVisibility}}"/>
              <Button Style="{StaticResource QuietButton}" Content="Reactivate" Command="{Binding ReactivateCommand}" Padding="6,2"
                      Visibility="{Binding CanResolveHere, Converter={StaticResource BooleanToVisibility}}"/>
             </WrapPanel>
             <DockPanel Margin="28,6,0,0" Visibility="{Binding IsReplying, Converter={StaticResource BooleanToVisibility}}">
              <Button DockPanel.Dock="Right" Content="Reply" Style="{StaticResource AccentButton}" Command="{Binding ReplyCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
              <TextBox Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                       c:Ui.Placeholder="Write a reply" AutomationProperties.Name="Reply"/>
             </DockPanel>
            </StackPanel>
           </Border>
          </DataTemplate>
         </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="No comments yet." Style="{StaticResource Caption}" Visibility="{Binding Threads.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>
        <DockPanel Margin="0,8,0,0">
         <Button DockPanel.Dock="Right" Content="Comment" Style="{StaticResource AccentButton}" Command="{Binding AddCommentCommand}" Margin="8,0,0,0" VerticalAlignment="Bottom"/>
         <TextBox Text="{Binding NewComment, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="200" VerticalScrollBarVisibility="Auto"
                  c:Ui.Placeholder="Add a comment" AutomationProperties.Name="New comment"/>
        </DockPanel>
       </StackPanel>
      </ScrollViewer>
     </TabItem>

     <TabItem AutomationProperties.Name="Files">
      <TabItem.Header>
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="Files" VerticalAlignment="Center"/>
        <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Padding="5,0" Visibility="{Binding Files.Count, Converter={StaticResource Presence}}">
         <TextBlock Text="{Binding Files.Count}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"/>
        </Border>
       </StackPanel>
      </TabItem.Header>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="280" MinWidth="180"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" ItemTemplate="{StaticResource FileTemplate}" Margin="8" AutomationProperties.Name="Changed files"
                b:Interaction.ActivateCommand="{Binding OpenFileCommand}" ToolTip="Double-click to open your working copy of the file"/>
       <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
       <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}" IsHitTestVisible="False"/>
       <diff:DiffView Grid.Column="2" Before="{Binding FileDiff.Before}" After="{Binding FileDiff.After}" Message="{Binding FileDiff.Message}" FilePath="{Binding FileDiff.Path}"
                      OldLabel="{Binding FileDiff.OldLabel, TargetNullValue=Before, FallbackValue=Before}" NewLabel="{Binding FileDiff.NewLabel, TargetNullValue=After, FallbackValue=After}"
                      EmptyText="Select a file to see what the pull request changes in it." AutomationProperties.Name="Pull request file diff"/>
      </Grid>
     </TabItem>

     <TabItem AutomationProperties.Name="Commits">
      <TabItem.Header>
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="Commits" VerticalAlignment="Center"/>
        <Border Style="{StaticResource Badge}" Margin="6,0,0,0" Padding="5,0" Visibility="{Binding Details.Commits.Count, Converter={StaticResource Presence}, FallbackValue=Collapsed}">
         <TextBlock Text="{Binding Details.Commits.Count}" FontSize="10.5" Foreground="{DynamicResource AccentBrush}"/>
        </Border>
       </StackPanel>
      </TabItem.Header>
      <ListBox ItemsSource="{Binding Details.Commits}" Margin="10" AutomationProperties.Name="Commits" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.ItemTemplate>
        <DataTemplate DataType="{x:Type core:DevOpsCommit}">
         <DockPanel Margin="0,3">
          <TextBlock DockPanel.Dock="Right" Text="{Binding ShortId}" FontFamily="{StaticResource CodeFont}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="8,0,0,0"/>
          <StackPanel>
           <TextBlock Text="{Binding Subject}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
           <TextBlock Text="{Binding Author}" Style="{StaticResource Meta}"/>
          </StackPanel>
         </DockPanel>
        </DataTemplate>
       </ListBox.ItemTemplate>
       <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
         <Setter Property="ContextMenu"><Setter.Value>
          <ContextMenu>
           <MenuItem Header="Copy commit ID" c:Ui.Icon="Copy" Command="{x:Static b:Interaction.CopyCommand}" CommandParameter="{Binding Id}"/>
           <MenuItem Header="Copy message" Command="{x:Static b:Interaction.CopyCommand}" CommandParameter="{Binding Message}"/>
          </ContextMenu>
         </Setter.Value></Setter>
        </Style>
       </ListBox.ItemContainerStyle>
      </ListBox>
     </TabItem>
    </TabControl>
   </DockPanel>
   <TextBlock Text="Loading…" Foreground="{DynamicResource AccentBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,12,0"
              Visibility="{Binding IsDetailLoading, Converter={StaticResource BooleanToVisibility}}"/>
  </Grid>

  <!-- Create a pull request: in place of the details while it is open. -->
  <Border Grid.Column="2" DataContext="{Binding NewPullRequest}" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibility}}">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22,16,22,22" MaxWidth="760" HorizontalAlignment="Left">
     <DockPanel>
      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Close" Command="{Binding CancelCommand}" ToolTip="Close without creating" AutomationProperties.Name="Close the form"/>
      <TextBlock Text="New pull request" Style="{StaticResource PaneHeading}"/>
     </DockPanel>
     <TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0"><Run Text="From "/><Run Text="{Binding SourceBranch, Mode=OneWay}" FontFamily="{StaticResource CodeFont}" Foreground="{DynamicResource TextBrush}"/><Run Text=", the branch in the Git pane"/></TextBlock>

     <Border Style="{StaticResource Card}" Margin="0,12,0,0" Background="{DynamicResource WarningSoftBrush}" Visibility="{Binding HasExisting, Converter={StaticResource BooleanToVisibility}}">
      <DockPanel>
       <Button DockPanel.Dock="Right" Content="Open it" Command="{Binding OpenExistingCommand}" Margin="8,0,0,0"/>
       <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"><Run Text="This branch already has an active pull request: !"/><Run Text="{Binding Existing.Number, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding Existing.Title, Mode=OneWay}"/></TextBlock>
      </DockPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding NeedsPublish, Converter={StaticResource BooleanToVisibility}}">
      <DockPanel>
       <Button DockPanel.Dock="Right" Content="{Binding PublishButtonText}" c:Ui.Icon="ArrowUp" Command="{Binding PublishCommand}" Margin="8,0,0,0"/>
       <TextBlock Text="{Binding PublishText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>

     <TextBlock Text="INTO" Style="{StaticResource Heading}"/>
     <ComboBox ItemsSource="{Binding TargetBranches}" IsEditable="True" Text="{Binding TargetBranch, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Target branch" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240"/>
     <TextBlock Text="TITLE" Style="{StaticResource Heading}"/>
     <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Title"/>
     <TextBlock Text="DESCRIPTION" Style="{StaticResource Heading}"/>
     <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="320" VerticalScrollBarVisibility="Auto"
              VerticalContentAlignment="Top" c:Ui.Placeholder="What changes, and why. Filled in from the branch's commits." AutomationProperties.Name="Description"/>
     <TextBlock Style="{StaticResource Heading}"><Run Text="{Binding WorkItemsLabel, Mode=OneWay}"/><Run Text=" (numbers, from the branch name and commits)"/></TextBlock>
     <TextBox Text="{Binding WorkItems, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="12, 34" AutomationProperties.Name="Linked work items" MaxWidth="360" HorizontalAlignment="Left" MinWidth="240"/>
     <CheckBox Content="Create as a draft" IsChecked="{Binding IsDraft}" Margin="0,14,0,0"/>
     <CheckBox Content="Set auto-complete (complete once every required policy passes)" IsChecked="{Binding AutoComplete}" Margin="0,6,0,0" Visibility="{Binding HasAutoComplete, Converter={StaticResource BooleanToVisibility}}"/>
     <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
      <Button Style="{StaticResource AccentButton}" Content="Create pull request" c:Ui.Icon="PullRequest" Command="{Binding CreateCommand}"/>
      <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,0,0"/>
      <TextBlock Text="Reading branches and commits…" Style="{StaticResource Meta}" Margin="12,0,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibility}}"/>
     </StackPanel>
    </StackPanel>
   </ScrollViewer>
  </Border>
 </Grid>
</UserControl>
