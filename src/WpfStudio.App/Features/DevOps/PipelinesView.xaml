<UserControl x:Class="WpfStudio.App.Features.DevOps.PipelinesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:WpfStudio.App.Features.DevOps" xmlns:c="clr-namespace:WpfStudio.App.Controls" xmlns:b="clr-namespace:WpfStudio.App.Behaviors"
 xmlns:core="clr-namespace:WpfStudio.Core.DevOps;assembly=WpfStudio.Core">
 <!-- DataContext: PipelinesViewModel. -->
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DevOpsStyles.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="RunItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
    <Setter Property="ContextMenu"><Setter.Value>
     <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
      <MenuItem Header="Open on the web" c:Ui.Icon="Link" Command="{Binding OpenInBrowserCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
      <MenuItem Header="Copy commit ID" c:Ui.Icon="Copy" Command="{x:Static b:Interaction.CopyCommand}" CommandParameter="{Binding PlacementTarget.DataContext.Commit, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
     </ContextMenu>
    </Setter.Value></Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>

 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="340" MinWidth="250"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*" MinWidth="460"/></Grid.ColumnDefinitions>

  <DockPanel Margin="10,10,8,8">
   <DockPanel DockPanel.Dock="Top">
    <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Run" c:Ui.Icon="Play" Command="{Binding RunPipelineCommand}" Margin="8,0,0,0"
            ToolTip="Run the selected pipeline on a branch you choose"/>
    <ComboBox ItemsSource="{Binding Views}" SelectedItem="{Binding SelectedView}" DisplayMemberPath="Label" AutomationProperties.Name="Pipeline list"/>
   </DockPanel>
   <DockPanel DockPanel.Dock="Top" Margin="2,8,0,6">
    <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="All runs" c:Ui.Icon="Close" Padding="4,0" Command="{Binding ClearPipelineFilterCommand}"
            Visibility="{Binding HasPipelineFilter, Converter={StaticResource BooleanToVisibility}}" ToolTip="Back to the list"/>
    <TextBlock Text="{Binding ListHeading}" Style="{StaticResource Meta}"/>
   </DockPanel>
   <Grid>
    <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" ItemTemplate="{StaticResource RunTemplate}" ItemContainerStyle="{StaticResource RunItem}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Runs" b:Interaction.ActivateCommand="{Binding OpenInBrowserCommand}"
             Visibility="{Binding ShowsRuns, Converter={StaticResource BooleanToVisibility}}"/>
    <ListBox ItemsSource="{Binding Definitions}" SelectedItem="{Binding SelectedDefinition}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Pipelines"
             b:Interaction.ActivateCommand="{Binding ShowRunsCommand}" Visibility="{Binding ShowsDefinitions, Converter={StaticResource BooleanToVisibility}}">
     <ListBox.ItemTemplate>
      <DataTemplate DataType="{x:Type core:DevOpsPipeline}">
       <Grid Margin="0,4">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <c:Glyph DataContext="{Binding LatestRun}" Style="{StaticResource StatusGlyph}" VerticalAlignment="Top" Margin="2,2,10,0"/>
        <StackPanel Grid.Column="1">
         <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder}"/>
         <TextBlock Text="{Binding Summary}" Style="{StaticResource Meta}" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
         <Button Style="{StaticResource IconButton}" c:Ui.Icon="List" Width="24" Height="24" ToolTip="Show its runs" AutomationProperties.Name="Show runs"
                 Command="{Binding DataContext.ShowRunsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
         <Button Style="{StaticResource IconButton}" c:Ui.Icon="Play" Width="24" Height="24" ToolTip="Run it" AutomationProperties.Name="Run pipeline"
                 Command="{Binding DataContext.RunPipelineCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
        </StackPanel>
       </Grid>
      </DataTemplate>
     </ListBox.ItemTemplate>
    </ListBox>
    <ItemsControl ItemsSource="{Binding Approvals}" Visibility="{Binding ShowsApprovals, Converter={StaticResource BooleanToVisibility}}" Focusable="False">
     <ItemsControl.Template><ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></ItemsControl.Template>
     <ItemsControl.ItemTemplate>
      <DataTemplate DataType="{x:Type core:DevOpsApproval}">
       <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="10">
        <StackPanel>
         <TextBlock Text="{Binding PipelineName}" FontWeight="SemiBold" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding Summary}" Style="{StaticResource Meta}" TextWrapping="Wrap" Margin="0,2,0,0"/>
         <TextBlock Text="{Binding Instructions}" Style="{StaticResource Caption}" Margin="0,6,0,0" Visibility="{Binding Instructions, Converter={StaticResource Presence}}"/>
         <WrapPanel Margin="0,8,0,0">
          <Button Style="{StaticResource AccentButton}" Content="Approve" c:Ui.Icon="Check" Margin="0,0,6,0"
                  Command="{Binding DataContext.ApproveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
          <Button Content="Reject" Margin="0,0,6,0" Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
          <Button Style="{StaticResource IconButton}" c:Ui.Icon="Link" ToolTip="Open the run on the web" AutomationProperties.Name="Open the run on the web"
                  Command="{Binding DataContext.OpenInBrowserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
         </WrapPanel>
        </StackPanel>
       </Border>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{Binding EmptyText}" Style="{StaticResource EmptyHint}">
     <TextBlock.Visibility>
      <MultiBinding Converter="{x:Static local:PipelinesView.EmptyListVisibility}">
       <Binding Path="ShowsRuns"/><Binding Path="Runs.Count"/><Binding Path="ShowsDefinitions"/><Binding Path="Definitions.Count"/><Binding Path="ShowsApprovals"/><Binding Path="Approvals.Count"/>
      </MultiBinding>
     </TextBlock.Visibility>
    </TextBlock>
   </Grid>
  </DockPanel>
  <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
  <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}" IsHitTestVisible="False"/>

  <Grid Grid.Column="2">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasRun, Converter={StaticResource Presence}, ConverterParameter=Invert}">
    <c:Glyph Kind="Pipeline" Width="28" Height="28" Foreground="{DynamicResource SubtleBrush}"/>
    <TextBlock Text="Select a run to see its stages, jobs and logs." Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0"/>
   </StackPanel>
   <DockPanel Visibility="{Binding HasRun, Converter={StaticResource BooleanToVisibility}}">
    <Border DockPanel.Dock="Top" Padding="18,12,16,10" Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
     <DockPanel>
      <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
       <Button Style="{StaticResource ActionButton}" Content="Run again" c:Ui.Icon="Restart" Command="{Binding RunAgainCommand}" ToolTip="Queue a new run of this pipeline on the same branch"/>
       <Button Style="{StaticResource ActionButton}" Content="Re-run failed jobs" Command="{Binding RetryRunCommand}" Visibility="{Binding CanRetryFailedJobs, Converter={StaticResource BooleanToVisibility}}"/>
       <Button Style="{StaticResource ActionButton}" Content="Cancel run" c:Ui.Icon="Stop" Command="{Binding CancelRunCommand}"/>
       <Button Style="{StaticResource IconButton}" c:Ui.Icon="Link" Command="{Binding OpenInBrowserCommand}" ToolTip="Open on the web" AutomationProperties.Name="Open the run on the web" Margin="0,0,0,4"/>
      </WrapPanel>
      <c:Glyph DockPanel.Dock="Left" DataContext="{Binding SelectedRun}" Style="{StaticResource StatusGlyph}" Width="18" Height="18" Margin="0,0,10,0"/>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{Binding SelectedRun.Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
       <TextBlock Style="{StaticResource Meta}" Margin="0,3,0,0">
        <Run Text="{Binding SelectedRun.StatusText, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/><Run Text=" · "/><Run Text="{Binding SelectedRun.Branch, Mode=OneWay}" FontFamily="{StaticResource CodeFont}"/>
        <Run Text=" · "/><Run Text="{Binding SelectedRun.Reason, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SelectedRun.RequestedFor, Mode=OneWay}"/>
        <Run Text=" · "/><Run Text="{Binding SelectedRun.DurationText, Mode=OneWay}"/>
       </TextBlock>
      </StackPanel>
     </DockPanel>
    </Border>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="300" MinWidth="200"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TreeView ItemsSource="{Binding Timeline}" Margin="8" BorderThickness="0" Background="Transparent" AutomationProperties.Name="Stages, jobs and tasks">
      <TreeView.ItemContainerStyle>
       <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
       </Style>
      </TreeView.ItemContainerStyle>
      <TreeView.ItemTemplate>
       <HierarchicalDataTemplate DataType="{x:Type local:TimelineNodeViewModel}" ItemsSource="{Binding Children}">
        <DockPanel Margin="0,2" ToolTip="{Binding Record.StatusText}">
         <c:Glyph DockPanel.Dock="Left" DataContext="{Binding Record}" Style="{StaticResource StatusGlyph}" Width="13" Height="13" Margin="0,0,7,0"/>
         <TextBlock DockPanel.Dock="Right" Text="{Binding Record.Detail}" Style="{StaticResource Meta}" Margin="10,0,0,0"/>
         <TextBlock Text="{Binding Record.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>
       </HierarchicalDataTemplate>
      </TreeView.ItemTemplate>
     </TreeView>
     <TextBlock Text="Reading the run…" Style="{StaticResource EmptyHint}" Visibility="{Binding IsRunLoading, Converter={StaticResource BooleanToVisibility}}"/>
     <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext"/>
     <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource BorderBrush}" IsHitTestVisible="False"/>
     <DockPanel Grid.Column="2" Margin="8,8,10,8">
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <CheckBox Content="Timestamps" IsChecked="{Binding KeepTimestamps}" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button Style="{StaticResource IconButton}" c:Ui.Icon="Copy" Command="{Binding CopyLogCommand}" ToolTip="Copy the log" AutomationProperties.Name="Copy the log"/>
       </StackPanel>
       <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
        <Run Text="{Binding SelectedNode.Record.Type, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/><Run Text=" "/><Run Text="{Binding SelectedNode.Record.Name, Mode=OneWay}" FontWeight="SemiBold"/>
        <Run Text="  "/><Run Text="{Binding SelectedNode.Record.StatusText, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
       </TextBlock>
      </DockPanel>
      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding SelectedNode.Record.IssueList}" Focusable="False" Margin="0,0,0,6">
       <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type core:DevOpsIssue}">
         <DockPanel Margin="0,1">
          <c:Glyph x:Name="Icon" DockPanel.Dock="Left" Kind="Warning" Width="13" Height="13" Foreground="{DynamicResource WarningBrush}" Margin="0,1,6,0" VerticalAlignment="Top"/>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11.5"/>
         </DockPanel>
         <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding IsError}" Value="True"><Setter TargetName="Icon" Property="Kind" Value="Error"/><Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
         </DataTemplate.Triggers>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid>
       <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource CodeFont}" FontSize="11.5" TextWrapping="NoWrap" AcceptsReturn="True"
                HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" AutomationProperties.Name="Log"/>
       <TextBlock Text="Select a stage, job or step to read its log." Style="{StaticResource EmptyHint}" Visibility="{Binding HasRecord, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>
       <TextBlock Text="Reading the log…" Foreground="{DynamicResource AccentBrush}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,22,0"
                  Visibility="{Binding IsLogLoading, Converter={StaticResource BooleanToVisibility}}"/>
      </Grid>
     </DockPanel>
    </Grid>
   </DockPanel>
  </Grid>
 </Grid>
</UserControl>
