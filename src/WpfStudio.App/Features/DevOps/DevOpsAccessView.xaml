<UserControl x:Class="WpfStudio.App.Features.DevOps.DevOpsAccessView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:WpfStudio.App.Features.DevOps" xmlns:c="clr-namespace:WpfStudio.App.Controls" xmlns:core="clr-namespace:WpfStudio.Core.DevOps;assembly=WpfStudio.Core">
 <!-- DataContext: DevOpsViewModel; the access list and preferences use its Access. -->
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="DevOpsStyles.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="AccessGlyph" TargetType="c:Glyph">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="StrokeWeight" Value="1.8"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Kind" Value="Info"/>
    <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding State}" Value="Granted"><Setter Property="Kind" Value="Check"/><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/></DataTrigger>
     <DataTrigger Binding="{Binding State}" Value="Denied"><Setter Property="Kind" Value="Warning"/><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
    </Style.Triggers>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>

 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="22,16,22,22" MaxWidth="860" HorizontalAlignment="Left">
   <!-- Who is signed in, how, and how to change it. -->
   <Border Style="{StaticResource Card}" Padding="16,12">
    <DockPanel>
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="Sign out" Command="{Binding SignOutCommand}" ToolTip="Forget the saved token, or stop using Git's sign-in in WpfStudio. Git keeps its own."/>
     </StackPanel>
     <ContentPresenter DockPanel.Dock="Left" Content="{Binding User}" ContentTemplate="{StaticResource Avatar}" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <StackPanel VerticalAlignment="Center">
      <TextBlock FontWeight="SemiBold"><Run Text="{Binding User.DisplayName, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding User.UniqueName, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal"/></TextBlock>
      <TextBlock Style="{StaticResource Meta}" Margin="0,2,0,0"><Run Text="{Binding SignInText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TokenHost, Mode=OneWay}"/></TextBlock>
     </StackPanel>
    </DockPanel>
   </Border>
   <Expander Header="Sign in another way" Margin="0,10,0,0">
    <local:DevOpsSignInView Margin="4,10,0,0"/>
   </Expander>

   <!-- What the sign-in can do. -->
   <DockPanel Margin="0,20,0,8" DataContext="{Binding Access}">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Content="Check again" c:Ui.Icon="Restart" Command="{Binding CheckCommand}" Margin="0,0,6,0"/>
     <Button Content="Token page" c:Ui.Icon="Link" Command="{Binding OpenTokenPageCommand}" ToolTip="Where tokens with more access are created"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="ACCESS" Style="{StaticResource SectionLabel}" Margin="0"/>
     <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
    </StackPanel>
   </DockPanel>
   <ItemsControl ItemsSource="{Binding Access.Entries}" Focusable="False">
    <ItemsControl.ItemTemplate>
     <DataTemplate DataType="{x:Type core:DevOpsAccessEntry}">
      <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <c:Glyph Style="{StaticResource AccessGlyph}" Margin="0,2,10,0"/>
        <StackPanel Grid.Column="1">
         <TextBlock Text="{Binding Feature}" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource Meta}" Margin="16,0,0,0" MaxWidth="300" TextWrapping="Wrap" TextAlignment="Right" ToolTip="{Binding Detail}"/>
       </Grid>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>
   <TextBlock Text="Checking…" Style="{StaticResource Caption}" Visibility="{Binding Access.IsChecking, Converter={StaticResource BooleanToVisibility}}"/>
   <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding Access.IsAzureDevOps, Converter={StaticResource BooleanToVisibility}}"
              Text="Azure DevOps cannot tell a token its own scopes, so each one is checked with a request that cannot change anything: work item 0 with validateOnly, build 0 and the all-zero repository."/>

   <!-- Preferences. -->
   <StackPanel DataContext="{Binding Access}">
    <TextBlock Text="SETTINGS" Style="{StaticResource SectionLabel}" Margin="0,24,0,8"/>
    <TextBlock Text="Branch name for a work item" FontWeight="SemiBold"/>
    <TextBlock Style="{StaticResource Caption}" Text="{}{id}, {title} and {type} are replaced; the title becomes a short lower-case slug."/>
    <TextBox Text="{Binding BranchTemplate, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320" AutomationProperties.Name="Branch name template"/>
    <TextBlock Style="{StaticResource Meta}" Margin="0,4,0,0"><Run Text="Example: "/><Run Text="{Binding BranchPreview, Mode=OneWay}" FontFamily="{StaticResource CodeFont}"/></TextBlock>

    <StackPanel Visibility="{Binding IsAzureDevOps, Converter={StaticResource BooleanToVisibility}}">
     <TextBlock Text="States left out of my work items" FontWeight="SemiBold" Margin="0,14,0,0"/>
     <TextBlock Style="{StaticResource Caption}" Text="Assigned to me, Created by me and Current iteration hide these, separated by commas."/>
     <TextBox Text="{Binding HiddenStates, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" MaxWidth="420" HorizontalAlignment="Left" MinWidth="320" AutomationProperties.Name="Hidden states"/>
    </StackPanel>

    <TextBlock Text="Refresh running pipelines every (seconds)" FontWeight="SemiBold" Margin="0,14,0,0"/>
    <TextBox Text="{Binding RefreshSeconds, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Width="80" HorizontalAlignment="Left" AutomationProperties.Name="Refresh interval in seconds"/>
    <TextBlock Style="{StaticResource Caption}" Text="0 turns it off. Five seconds is the shortest interval used."/>
    <CheckBox Content="Show timestamps in pipeline logs" IsChecked="{Binding KeepLogTimestamps}" Margin="0,12,0,0"/>
    <CheckBox Content="Delete the source branch when completing a pull request" IsChecked="{Binding DeleteSourceBranch}" Margin="0,6,0,0"/>
    <CheckBox Content="Complete linked work items when completing a pull request" IsChecked="{Binding CompleteWorkItems}" Margin="0,6,0,0" Visibility="{Binding IsAzureDevOps, Converter={StaticResource BooleanToVisibility}}"/>
    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
     <Button Style="{StaticResource AccentButton}" Content="Save settings" c:Ui.Icon="Save" Command="{Binding SaveSettingsCommand}"/>
     <Button Content="Revert" Command="{Binding RevertSettingsCommand}" Margin="8,0,0,0"/>
    </StackPanel>
   </StackPanel>
  </StackPanel>
 </ScrollViewer>
</UserControl>
