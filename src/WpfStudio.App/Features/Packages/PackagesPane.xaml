<UserControl x:Class="WpfStudio.App.Features.Packages.PackagesPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="480">
 <UserControl.Resources><Style x:Key="OptionalText" TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></UserControl.Resources>
 <Grid Margin="12" Background="{DynamicResource SurfaceBrush}">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="NuGet packages" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Dependencies for the selected project" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,10"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button Content="Refresh" Command="{Binding RefreshCommand}" ToolTip="Read installed packages and configured sources"/><Button Content="Cancel" Command="{Binding CancelCommand}"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel>
   <TextBlock Text="Project" Foreground="{DynamicResource MutedBrush}"/>
   <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" IsEnabled="{Binding IsNotBusy}" ToolTip="{Binding SelectedProject.ProjectPath}" Margin="0,4,0,0" AutomationProperties.Name="Package target project"/>
  </StackPanel><StackPanel Grid.Column="2">
   <TextBlock Text="Browse source" Foreground="{DynamicResource MutedBrush}"/>
   <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name" IsEnabled="{Binding IsNotBusy}" ToolTip="{Binding SelectedSource.Address}" Margin="0,4,0,0" AutomationProperties.Name="NuGet package source"/>
  </StackPanel></Grid>
  <StackPanel Grid.Row="2" Margin="0,3,0,8">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
   <TextBlock Text="{Binding Warning}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding Warning}" Margin="0,4,0,0"/>
  </StackPanel>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <TabControl>
   <TabItem Header="Installed">
    <Grid>
     <ListBox ItemsSource="{Binding Installed}" SelectedItem="{Binding SelectedInstalled}" IsEnabled="{Binding IsNotBusy}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="Installed NuGet packages">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}"/><Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"><MenuItem Header="Package details" Command="{Binding InspectInstalledCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/><MenuItem Header="Remove package…" Command="{Binding RemovePackageCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/></ContextMenu></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,6"><TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ResolvedVersion}" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,0"/><TextBlock Text="{Binding Frameworks}" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <TextBlock Text="No package references to show.&#x0a;Select a project and refresh, or browse to add a package." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="12" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Installed.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
   </TabItem>
   <TabItem Header="Browse">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="0,7,0,5">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNotBusy}" ToolTip="Search by package ID or description" AutomationProperties.Name="Search NuGet packages"><TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox><Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" Margin="5,0,0,0"/></Grid>
      <CheckBox Content="Include prerelease versions" IsChecked="{Binding IncludePrerelease}" IsEnabled="{Binding IsNotBusy}" Foreground="{DynamicResource TextBrush}" Margin="0,7,0,0"/>
     </StackPanel>
     <ListBox ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedSearchResult}" IsEnabled="{Binding IsNotBusy}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="{DynamicResource EditorBrush}" Foreground="{DynamicResource TextBrush}" AutomationProperties.Name="NuGet search results">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,6"><TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Version}" Foreground="{DynamicResource AccentBrush}" Margin="0,3,0,3"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </TabItem>
  </TabControl>
  <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="{DynamicResource EditorBrush}" Padding="11">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0"><StackPanel>
    <TextBlock Text="Package details" FontWeight="SemiBold" Margin="0,0,0,9"/>
    <TextBlock Text="Package ID" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,4"/>
    <TextBox Text="{Binding PackageId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNotBusy}" ToolTip="Exact package ID; can also be entered manually for private or local feeds" AutomationProperties.Name="Package ID"/>
    <TextBlock Text="Version" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,9,0,4"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding Versions}" Text="{Binding SelectedVersion, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" IsEnabled="{Binding IsNotBusy}" Margin="0" AutomationProperties.Name="Package version"/><Button Grid.Column="1" Content="Load versions" Command="{Binding LoadVersionsCommand}" Margin="5,0,0,0" Padding="7,4"/></Grid>
    <WrapPanel Margin="0,8,0,0"><Button x:Name="InstallPackageButton" Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" Style="{DynamicResource AccentButton}" Margin="0,0,6,0"/><Button x:Name="RemovePackageButton" Content="Remove" Command="{Binding RemoveCommand}" Margin="0"/></WrapPanel>
    <TextBlock Text="{Binding InstalledVersionLabel}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <TextBlock Text="{Binding Authors}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0"/>
    <TextBlock Text="{Binding DownloadLabel}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
    <Expander Header="Package output" Foreground="{DynamicResource TextBrush}" Margin="0,12,0,0"><TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Cascadia Code, Consolas" FontSize="11" Height="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Package restore output"/></Expander>
    <TextBlock Text="Install and restore use configured sources and package mappings. Modified documents are saved first." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0"/>
    <TextBlock Text="{Binding CentralVersionNotice}" Style="{StaticResource OptionalText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0"/>
   </StackPanel></ScrollViewer>
  </Border>
  </Grid>
  <TextBlock Grid.Row="4" Text="{Binding ConfigurationSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigurationSummary}" Margin="0,7,0,0"/>
 </Grid>
</UserControl>
