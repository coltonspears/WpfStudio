<UserControl x:Class="WpfStudio.App.Features.Profiling.MemoryProfilerPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:WpfStudio.App.Features.Profiling" xmlns:c="clr-namespace:WpfStudio.App.Controls"
 Background="{DynamicResource SurfaceBrush}">
 <UserControl.InputBindings>
  <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="0"/>
  <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="1"/>
  <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="2"/>
  <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ShowViewCommand}" CommandParameter="3"/>
 </UserControl.InputBindings>
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="MemoryStyles.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="CaptureOnly" TargetType="FrameworkElement">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers><DataTrigger Binding="{Binding HasCapture}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
   </Style>
   <Style x:Key="ViewHost" TargetType="ContentControl">
    <Setter Property="Visibility" Value="Collapsed"/>
    <Setter Property="Focusable" Value="False"/>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <!-- Capture toolbar -->
  <Border Style="{StaticResource PaneToolbar}" Padding="10,6">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MaxWidth="380"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
     <Border Width="26" Height="26" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,9,0">
      <c:Glyph Kind="Chip" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
     </Border>
     <TextBlock Text="Memory profiler" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
    </StackPanel>
    <TextBlock Grid.Column="1" Text="Choose a running .NET process…" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="10,0,30,0" IsHitTestVisible="False" Panel.ZIndex="1"
     Visibility="{Binding SelectedProcess, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>
    <ComboBox Grid.Column="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" IsEnabled="{Binding IsIdle}" MinWidth="170" DropDownOpened="ProcessesOpened"
     AutomationProperties.Name="Memory profiling process" ToolTip="Running .NET processes. The list refreshes when you open it." VerticalAlignment="Center">
     <ComboBox.ItemTemplate>
      <DataTemplate>
       <DockPanel>
        <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"><Run Text="{Binding RuntimeHint, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding WorkingSetBytes, Mode=OneWay, Converter={StaticResource Bytes}}"/></TextBlock>
        <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Id, Mode=OneWay, StringFormat='PID {0}'}" Foreground="{DynamicResource MutedBrush}"/></TextBlock>
       </DockPanel>
      </DataTemplate>
     </ComboBox.ItemTemplate>
    </ComboBox>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
     <Button Style="{StaticResource IconButton}" c:Ui.Icon="Refresh" Command="{Binding RefreshProcessesCommand}" ToolTip="Refresh processes" AutomationProperties.Name="Refresh processes"/>
     <Button Content="Capture" c:Ui.Icon="Camera" Command="{Binding CaptureCommand}" Style="{StaticResource AccentButton}" Margin="6,0,2,0" ToolTip="Snapshot the selected process's managed heap. The app keeps running; no GC is forced."/>
     <Button Content="Open dump…" c:Ui.Icon="FolderOpen" Command="{Binding OpenDumpCommand}" AutomationProperties.Name="Open memory dump" ToolTip="Open a full .dmp file"/>
     <Button Content="Cancel" Command="{Binding OpenDumpCancelCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding OpenDumpCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}"/>
     <Button Content="Cancel" Command="{Binding CaptureCancelCommand}" Style="{StaticResource QuietButton}" Visibility="{Binding CaptureCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}"/>
    </StackPanel>
    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
     <Button Style="{StaticResource IconButton}" c:Ui.Icon="Export" Command="{Binding ExportReportCommand}" ToolTip="Export the investigation as JSON" AutomationProperties.Name="Export report"/>
     <ToggleButton Style="{StaticResource IconButton}" c:Ui.Icon="Settings" IsChecked="{Binding ShowOptions}" ToolTip="Capture options: runtime index, analysis budgets and DAC" AutomationProperties.Name="Capture options"/>
     <Button Style="{StaticResource IconButton}" c:Ui.Icon="Close" Command="{Binding CloseCaptureCommand}" ToolTip="Close the capture (the target keeps running)" AutomationProperties.Name="Close capture"/>
    </StackPanel>
   </Grid>
  </Border>

  <!-- View switcher and snapshot context -->
  <Border Grid.Row="1" Style="{StaticResource CaptureOnly}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,5">
   <DockPanel LastChildFill="False">
    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
     <RadioButton Content="Overview" c:Ui.Icon="Dashboard" Style="{StaticResource ViewTab}" GroupName="MemoryView" IsChecked="{Binding SelectedView, Converter={StaticResource EqualsText}, ConverterParameter=0, Mode=OneWay}" Command="{Binding ShowViewCommand}" CommandParameter="0" ToolTip="Findings, heap composition and the biggest owners (Ctrl+1)"/>
     <RadioButton Content="Types" c:Ui.Icon="List" Style="{StaticResource ViewTab}" GroupName="MemoryView" IsChecked="{Binding SelectedView, Converter={StaticResource EqualsText}, ConverterParameter=1, Mode=OneWay}" Command="{Binding ShowViewCommand}" CommandParameter="1" ToolTip="Every type, its instances and what keeps them alive (Ctrl+2)"/>
     <RadioButton Content="Retention" c:Ui.Icon="Tree" Style="{StaticResource ViewTab}" GroupName="MemoryView" IsChecked="{Binding SelectedView, Converter={StaticResource EqualsText}, ConverterParameter=2, Mode=OneWay}" Command="{Binding ShowViewCommand}" CommandParameter="2" ToolTip="Dominator tree: which objects own which memory (Ctrl+3)"/>
     <RadioButton Content="Graph" c:Ui.Icon="Nodes" Style="{StaticResource ViewTab}" GroupName="MemoryView" IsChecked="{Binding SelectedView, Converter={StaticResource EqualsText}, ConverterParameter=3, Mode=OneWay}" Command="{Binding ShowViewCommand}" CommandParameter="3" ToolTip="Retention graph of the inspected object (Ctrl+4)"/>
    </StackPanel>
    <TextBox DockPanel.Dock="Left" Width="230" Margin="12,0,0,0" VerticalAlignment="Center" Padding="7,3" MinHeight="26" Text="{Binding GoToText, UpdateSourceTrigger=PropertyChanged}"
     c:Ui.Placeholder="Go to type or 0x address" ToolTip="Type a name to filter types, or a hexadecimal address to open that object (Ctrl+G)" AutomationProperties.Name="Go to type or address" x:Name="GoToBox">
     <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding GoToCommand}"/></TextBox.InputBindings>
    </TextBox>
    <ToggleButton DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Sidebar" IsChecked="{Binding IsBrowserVisible, Mode=OneWay}" Command="{Binding ToggleBrowserCommand}" ToolTip="Show or hide the object browser" AutomationProperties.Name="Toggle object browser" Margin="6,0,0,0"/>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Style="{StaticResource Pill}" ToolTip="{Binding CoverageDescription}" Margin="0,0,8,0">
      <StackPanel Orientation="Horizontal">
       <c:Glyph Kind="Warning" Width="12" Height="12" Foreground="{DynamicResource WarningBrush}" Margin="0,0,5,0" Visibility="{Binding IsIncomplete, Converter={StaticResource BooleanToVisibility}}"/>
       <TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"><Run Text="{Binding SourceName, Mode=OneWay}" Foreground="{DynamicResource TextBrush}"/><Run Text=" · "/><Run Text="{Binding SourceDescription, Mode=OneWay}"/></TextBlock>
      </StackPanel>
     </Border>
     <Button Content="Set baseline" c:Ui.Icon="Baseline" Style="{StaticResource ToolbarButton}" Command="{Binding SetBaselineCommand}" ToolTip="Pin type totals; capture again after repeating a workload to see what grew"
      Visibility="{Binding HasBaseline, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>
     <Border Style="{StaticResource Pill}" Background="{DynamicResource AccentSoftBrush}" Padding="8,1,2,1" Visibility="{Binding HasBaseline, Converter={StaticResource BooleanToVisibility}}" ToolTip="{Binding ComparisonDescription}">
      <StackPanel Orientation="Horizontal">
       <c:Glyph Kind="Baseline" Width="12" Height="12" Foreground="{DynamicResource AccentBrush}" Margin="0,0,5,0"/>
       <TextBlock Text="{Binding BaselineDescription}" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
       <Button Style="{StaticResource IconButton}" Width="20" Height="20" c:Ui.Icon="Close" Command="{Binding ClearBaselineCommand}" ToolTip="Clear baseline" Margin="4,0,0,0"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </DockPanel>
  </Border>

  <!-- Options -->
  <Border Grid.Row="2" Background="{DynamicResource RaisedBrush}" CornerRadius="6" Padding="12,10" Margin="10,8,10,0" Visibility="{Binding ShowOptions, Converter={StaticResource BooleanToVisibility}}">
   <StackPanel IsEnabled="{Binding IsIdle}">
    <WrapPanel>
     <TextBlock Text="Runtime index" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Text="{Binding RuntimeIndex}" Width="55" Margin="0,0,14,0" AutomationProperties.Name="CLR runtime index"/>
     <TextBlock Text="Object budget" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Text="{Binding MaxObjects}" Width="105" Margin="0,0,14,0" AutomationProperties.Name="Heap object budget"/>
     <TextBlock Text="Reference budget" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Text="{Binding MaxReferences}" Width="105" AutomationProperties.Name="Heap reference budget"/>
    </WrapPanel>
    <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Choose DAC…" Command="{Binding ChooseDacCommand}"/><TextBox Text="{Binding DacPath, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Matching mscordacwks.dll or mscordaccore.dll (optional)" ToolTip="Leave empty for automatic resolution" AutomationProperties.Name="Optional matching runtime DAC"/></DockPanel>
    <TextBlock Text="Defaults allow 1 million objects and 6 million references. Larger budgets use more worker memory. The matching runtime DAC is resolved locally or from Microsoft's symbol server." Style="{StaticResource Note}" Margin="0,6,0,0"/>
   </StackPanel>
  </Border>

  <!-- Coverage warning -->
  <Border Grid.Row="3" Background="{DynamicResource WarningSoftBrush}" CornerRadius="6" Padding="10,7" Margin="10,8,10,0" Visibility="{Binding IsIncomplete, Converter={StaticResource BooleanToVisibility}}">
   <DockPanel>
    <c:Glyph Kind="Warning" Width="16" Height="16" Foreground="{DynamicResource WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Top"/>
    <TextBlock Text="{Binding CoverageDescription}" TextWrapping="Wrap" MaxHeight="52" TextTrimming="CharacterEllipsis" FontSize="11.5" ToolTip="{Binding CoverageDescription}"/>
   </DockPanel>
  </Border>

  <!-- Empty state: a guided start for first-time users -->
  <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasCapture, Converter={StaticResource Presence}, ConverterParameter=Invert}">
   <StackPanel MaxWidth="760" Margin="32,28" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Find what keeps memory alive" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="Snapshot a running .NET app or open a dump. WpfStudio finds likely leaks, shows what each object keeps alive, and lets you follow any object back to the GC roots that hold it." Foreground="{DynamicResource MutedBrush}" FontSize="13.5" TextWrapping="Wrap" Margin="0,10,0,22"/>
    <UniformGrid Columns="3" Margin="0,0,0,18">
     <Border Style="{StaticResource Panel}" Margin="0,0,8,0">
      <StackPanel>
       <TextBlock Text="1" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
       <TextBlock Text="Capture" Style="{StaticResource SectionTitle}" Margin="0,4,0,4"/>
       <TextBlock Text="Pick a process above and choose Capture, or open a full .dmp. The app keeps running and no collection is forced." Style="{StaticResource Note}"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Panel}" Margin="4,0">
      <StackPanel>
       <TextBlock Text="2" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
       <TextBlock Text="Review findings" Style="{StaticResource SectionTitle}" Margin="0,4,0,4"/>
       <TextBlock Text="Closed windows still in memory, event-handler leaks, disposed objects, duplicate strings and more are flagged automatically." Style="{StaticResource Note}"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Panel}" Margin="8,0,0,0">
      <StackPanel>
       <TextBlock Text="3" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
       <TextBlock Text="Follow the chain" Style="{StaticResource SectionTitle}" Margin="0,4,0,4"/>
       <TextBlock Text="Open any object to see its fields, the root paths that hold it, and what would be freed if one reference went away." Style="{StaticResource Note}"/>
      </StackPanel>
     </Border>
    </UniformGrid>
    <Border Style="{StaticResource Panel}" Background="Transparent">
     <DockPanel>
      <c:Glyph Kind="Bulb" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Top" DockPanel.Dock="Left"/>
      <StackPanel>
       <TextBlock Text="Hunting a leak?" Style="{StaticResource SectionTitle}"/>
       <TextBlock Style="{StaticResource Note}" FontSize="12" Margin="0,4,0,0" Text="Capture once and choose Set baseline. Repeat the action you suspect (open and close a window a few times), then capture again. Types that keep growing appear under Findings with the paths that retain them."/>
      </StackPanel>
     </DockPanel>
    </Border>
    <TextBlock Text="Supports modern .NET and .NET Framework, x64 and x86. Fields are read from captured memory; application getters never run." Style="{StaticResource SubtleNote}" Margin="0,16,0,0" HorizontalAlignment="Center" TextAlignment="Center"/>
   </StackPanel>
  </ScrollViewer>

  <!-- Workbench -->
  <Grid Grid.Row="4" Style="{StaticResource CaptureOnly}">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="*" MinWidth="320"/>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition x:Name="BrowserColumn" Width="360" MinWidth="0"/>
   </Grid.ColumnDefinitions>
   <Grid>
    <p:MemoryOverviewView x:Name="OverviewView"/>
    <p:MemoryTypesView x:Name="TypesView" Visibility="Collapsed"/>
    <p:MemoryRetentionView x:Name="RetentionView" Visibility="Collapsed"/>
    <p:MemoryGraphView x:Name="GraphView" Visibility="Collapsed"/>
   </Grid>
   <GridSplitter Grid.Column="1" Style="{StaticResource SplitterH}" x:Name="BrowserSplitter"/>
   <p:MemoryObjectBrowser Grid.Column="2" x:Name="Browser"/>
  </Grid>

  <!-- Status -->
  <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
   <DockPanel>
    <ContentControl DockPanel.Dock="Left" Width="120" Margin="0,0,10,0" VerticalAlignment="Center" Focusable="False">
     <ContentControl.Style>
      <Style TargetType="ContentControl">
       <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding IsBusy}" Value="True">
         <Setter Property="Visibility" Value="Visible"/>
         <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><ProgressBar Style="{StaticResource ActivityBar}" Height="3"/></DataTemplate></Setter.Value></Setter>
        </DataTrigger>
       </Style.Triggers>
      </Style>
     </ContentControl.Style>
    </ContentControl>
    <TextBlock DockPanel.Dock="Left" Text="{Binding BusyMessage}" Style="{StaticResource Note}" Margin="0,0,10,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="11.5" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>
 </Grid>
</UserControl>
