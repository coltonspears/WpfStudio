<UserControl x:Class="WpfStudio.App.Features.Profiling.MemoryProfilerPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:WpfStudio.App.Features.Profiling" xmlns:c="clr-namespace:WpfStudio.App.Controls"
 Background="{DynamicResource SurfaceBrush}">
 <UserControl.Resources>
  <p:MemorySizeConverter x:Key="Bytes"/>
  <Style x:Key="Note" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="11"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,6"/></Style>
  <Style x:Key="CaptureContent" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasCapture}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="EmptyContent" TargetType="StackPanel"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasCapture}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="SidePanel" TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding FocusGraph}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="OverviewPanel" TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding FocusGraph}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="SideSplitter" TargetType="GridSplitter"><Setter Property="Width" Value="5"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="Background" Value="{DynamicResource BorderBrush}"/><Style.Triggers><DataTrigger Binding="{Binding FocusGraph}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
  <DataTemplate x:Key="PathReferences">
   <ItemsControl ItemsSource="{Binding References}">
    <ItemsControl.ItemTemplate><DataTemplate>
     <StackPanel Margin="0,3,0,5">
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" FontSize="11"/>
      <Button Content="{Binding Target}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Margin="0" Padding="4,3"
       Command="{Binding DataContext.OpenReferenceTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Inspect referenced object"/>
     </StackPanel>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
  </DataTemplate>
 </UserControl.Resources>
 <Grid Margin="12,10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel LastChildFill="False">
   <StackPanel DockPanel.Dock="Left" Margin="0,0,20,8"><TextBlock Text="Memory investigations" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SourceDescription}" Style="{StaticResource Note}" Margin="0,3,0,0"/></StackPanel>
   <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top">
    <Button Content="Open dump…" c:Ui.Icon="FolderOpen" Command="{Binding OpenDumpCommand}" AutomationProperties.Name="Open memory dump"/>
    <Button Content="Set baseline" Command="{Binding SetBaselineCommand}" ToolTip="Pin type totals for comparison with the next capture"/>
    <Button Content="Export report…" Command="{Binding ExportReportCommand}"/>
    <Button Content="Options" Command="{Binding ToggleOptionsCommand}"/>
    <Button Content="Close capture" Command="{Binding CloseCaptureCommand}"/>
   </WrapPanel>
  </DockPanel>
  <Grid Grid.Row="1" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ComboBox ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}" IsEnabled="{Binding IsIdle}" AutomationProperties.Name="Memory profiling process" MinWidth="200" Margin="0,0,8,0">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock><Run Text="{Binding Name}"/><Run Text="  PID "/><Run Text="{Binding Id}"/><Run Text="  "/><Run Text="{Binding RuntimeHint}"/><Run Text="  Working set "/><Run Text="{Binding WorkingSetBytes, Converter={StaticResource Bytes}}"/></TextBlock></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Content="Refresh processes" c:Ui.Icon="Refresh" Command="{Binding RefreshProcessesCommand}"/>
    <Button Content="Capture snapshot" Command="{Binding CaptureCommand}" Style="{StaticResource AccentButton}"/>
    <Button Content="Cancel open" Command="{Binding OpenDumpCancelCommand}" Visibility="{Binding OpenDumpCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}"/>
    <Button Content="Cancel capture" Command="{Binding CaptureCancelCommand}" Visibility="{Binding CaptureCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource RaisedBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8" Visibility="{Binding ShowOptions, Converter={StaticResource BooleanToVisibility}}">
   <StackPanel IsEnabled="{Binding IsIdle}">
    <WrapPanel>
     <TextBlock Text="Runtime index" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Text="{Binding RuntimeIndex}" Width="55" Margin="0,0,14,0" AutomationProperties.Name="CLR runtime index"/>
     <TextBlock Text="Object budget" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Text="{Binding MaxObjects}" Width="105" Margin="0,0,14,0" AutomationProperties.Name="Heap object budget"/>
     <TextBlock Text="Reference budget" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox Text="{Binding MaxReferences}" Width="105" AutomationProperties.Name="Heap reference budget"/>
    </WrapPanel>
    <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Choose DAC…" Command="{Binding ChooseDacCommand}"/><TextBox Text="{Binding DacPath, UpdateSourceTrigger=PropertyChanged}" ToolTip="Optional matching mscordacwks.dll or mscordaccore.dll; leave empty for automatic resolution" AutomationProperties.Name="Optional matching runtime DAC"/></DockPanel>
    <TextBlock Text="Defaults allow 1 million objects and 6 million references. Larger budgets use more worker memory. The matching runtime DAC is resolved locally or from Microsoft's symbol server." Style="{StaticResource Note}" Margin="0,6,0,0"/>
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="3" Style="{StaticResource OverviewPanel}">
   <Expander Header="{Binding OverviewHeading}" IsExpanded="{Binding ShowOverview}" Visibility="{Binding HasCapture, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,8" ToolTip="{Binding CoverageDescription}">
   <StackPanel Margin="4,8,4,0">
   <Grid Style="{StaticResource CaptureContent}" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Managed object bytes" Style="{StaticResource Note}"/><TextBlock Text="{Binding ManagedSize}" FontSize="20" FontWeight="SemiBold" ToolTip="{Binding Summary.ManagedBytes, StringFormat={}{0:N0} bytes}"/></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock Text="Reachable from roots" Style="{StaticResource Note}"/><TextBlock Text="{Binding ReachableSize}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="No captured root path" Style="{StaticResource Note}"/><TextBlock Text="{Binding UnreachableSize}" FontSize="20" FontWeight="SemiBold"/></StackPanel>
   </Grid>
   <TextBlock Text="{Binding Summary.Source}" Style="{StaticResource Note}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Summary.Source}"/>
   <TextBlock Text="{Binding CoverageDescription}" Style="{StaticResource Note}" Foreground="{DynamicResource WarningBrush}" Margin="0,3,0,4" MaxHeight="54" TextTrimming="CharacterEllipsis" ToolTip="{Binding CoverageDescription}"/>
   <DockPanel Visibility="{Binding HasCapture, Converter={StaticResource BooleanToVisibility}}" Margin="0,0,0,8"><Button DockPanel.Dock="Right" Content="Clear baseline" Style="{StaticResource QuietButton}" Command="{Binding ClearBaselineCommand}"/><TextBlock Text="{Binding ComparisonDescription}" Style="{StaticResource Note}"/></DockPanel>
   </StackPanel>
   </Expander>
  </StackPanel>
  <StackPanel Grid.Row="4" Style="{StaticResource EmptyContent}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600" Margin="32">
   <TextBlock Text="Find what keeps memory alive." FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"/>
   <TextBlock Text="Follow an object back to its GC roots, inspect its fields, and model which objects could be collected if a reference were removed." Foreground="{DynamicResource MutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,20"/>
   <TextBlock Text="Open a full .dmp file, or refresh the process list and capture a running application. Both modern .NET and .NET Framework are supported. A snapshot observes memory without running your application's getters or forcing a collection." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
   <TextBlock Text="Own bytes, retained bytes, and removable-reference estimates stay linked to the same object graph. Shared references are accounted for." TextWrapping="Wrap" Margin="0,14,0,0" Foreground="{DynamicResource AccentBrush}"/>
  </StackPanel>
  <Grid Grid.Row="4" Style="{StaticResource CaptureContent}">
   <Grid.ColumnDefinitions>
    <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="230"/><Setter Property="MinWidth" Value="170"/><Style.Triggers><DataTrigger Binding="{Binding FocusGraph}" Value="True"><Setter Property="Width" Value="0"/><Setter Property="MinWidth" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="180"/><ColumnDefinition Width="Auto"/>
    <ColumnDefinition><ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="340"/><Setter Property="MinWidth" Value="260"/><Style.Triggers><DataTrigger Binding="{Binding FocusGraph}" Value="True"><Setter Property="Width" Value="0"/><Setter Property="MinWidth" Value="0"/></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style></ColumnDefinition>
   </Grid.ColumnDefinitions>
   <Grid Style="{StaticResource SidePanel}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox Text="{Binding TypeFilter, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Filter types or modules" ToolTip="Filter type or module names. Up to 5,000 matching types are shown." AutomationProperties.Name="Filter memory types" Margin="0,0,0,6"/>
    <ComboBox Grid.Row="1" ItemsSource="{Binding TypeSortOptions}" SelectedItem="{Binding TypeSort}" AutomationProperties.Name="Memory type sort" Margin="0,0,0,6"/>
    <ListBox Grid.Row="2" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Memory types">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,2" ToolTip="{Binding Name}"><TextBlock Text="{Binding ShortName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/><TextBlock Text="{Binding Metrics}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}"/>
    <DockPanel Grid.Row="4" Margin="0,5,0,6"><Button DockPanel.Dock="Right" Content="All types" Style="{StaticResource QuietButton}" Command="{Binding ShowAllTypesCommand}"/><TextBox Text="{Binding ObjectFilter, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Find an object" ToolTip="Filter objects by type or hexadecimal address" AutomationProperties.Name="Filter heap objects"/></DockPanel>
    <ListBox Grid.Row="5" ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObject}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Heap objects">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,2" ToolTip="{Binding Type}"><TextBlock Text="{Binding Address}" FontFamily="{StaticResource CodeFont}" FontSize="11"/><TextBlock FontSize="11" Foreground="{DynamicResource MutedBrush}"><Run Text="Own "/><Run Text="{Binding ShallowBytes, Converter={StaticResource Bytes}}"/><Run Text=" · retains "/><Run Text="{Binding RetainedBytes, Converter={StaticResource Bytes}}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="6"><TextBlock Text="{Binding ObjectPageDescription}" Style="{StaticResource Note}" Margin="0,4,0,0"/><WrapPanel><Button Content="Previous" Command="{Binding PreviousObjectsCommand}" Style="{StaticResource QuietButton}"/><Button Content="Next" Command="{Binding NextObjectsCommand}" Style="{StaticResource QuietButton}"/></WrapPanel></StackPanel>
   </Grid>
   <GridSplitter Grid.Column="1" Style="{StaticResource SideSplitter}"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="6,0,6,4"><Button DockPanel.Dock="Right" Content="{Binding GraphFocusLabel}" Command="{Binding ToggleGraphFocusCommand}" Style="{StaticResource QuietButton}"/><TextBlock Text="Relationships" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
    <p:MemoryGraphSurface x:Name="ObjectGraph" Grid.Row="1" Graph="{Binding Graph}" FocusMode="{Binding FocusGraph}" InspectObjectCommand="{Binding InspectObjectCommand}" SelectedReference="{Binding SelectedReference}" ReleasedObjects="{Binding ReleasedObjects}"/>
    <WrapPanel Grid.Row="2" Margin="4,3,4,0">
     <Button Content="Back" Command="{Binding BackCommand}" Style="{StaticResource QuietButton}"/>
     <Button Content="−" Command="{x:Static p:MemoryGraphSurface.ZoomOutCommand}" CommandTarget="{Binding ElementName=ObjectGraph}" Style="{StaticResource QuietButton}" AutomationProperties.Name="Zoom object graph out"/>
     <TextBlock Text="{Binding ElementName=ObjectGraph, Path=Zoom, StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="4,0"/>
     <Button Content="+" Command="{x:Static p:MemoryGraphSurface.ZoomInCommand}" CommandTarget="{Binding ElementName=ObjectGraph}" Style="{StaticResource QuietButton}" AutomationProperties.Name="Zoom object graph in"/>
     <Button Content="Fit" Command="{x:Static p:MemoryGraphSurface.FitGraphCommand}" CommandTarget="{Binding ElementName=ObjectGraph}" Style="{StaticResource QuietButton}"/>
    </WrapPanel>
    <TextBlock Grid.Row="3" ToolTip="{Binding Graph.Description}" Margin="8,4,8,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Note}"><Setter Property="Text" Value="Drag to pan · wheel to zoom · double-click to inspect"/><Style.Triggers><DataTrigger Binding="{Binding Graph.IsTruncated}" Value="True"><Setter Property="Text" Value="Map limited · double-click objects to explore further"/><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
   <GridSplitter Grid.Column="3" Style="{StaticResource SideSplitter}"/>
   <Grid Grid.Column="4" Style="{StaticResource SidePanel}" Margin="10,0,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel>
     <TextBlock Text="{Binding Details.Object.Type}" FontWeight="SemiBold" FontSize="14" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details.Object.Type}"/>
     <TextBlock Style="{StaticResource Note}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,7"><Run Text="{Binding Details.Object.Address, Mode=OneWay}" FontFamily="{StaticResource CodeFont}"/><Run Text=" · "/><Run Text="{Binding ObjectState, Mode=OneWay}"/></TextBlock>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock ToolTip="{Binding Details.Object.ShallowBytes, StringFormat={}{0:N0} own bytes}"><Run Text="Own " Foreground="{DynamicResource MutedBrush}" FontSize="11"/><Run Text="{Binding OwnSize, Mode=OneWay}" FontSize="16"/></TextBlock><TextBlock Grid.Column="1" ToolTip="{Binding Details.Object.RetainedBytes, StringFormat={}{0:N0} retained bytes}"><Run Text="Retained " Foreground="{DynamicResource MutedBrush}" FontSize="11"/><Run Text="{Binding RetainedSize, Mode=OneWay}" FontSize="16" Foreground="{DynamicResource AccentBrush}"/></TextBlock></Grid>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,8,0,6">
     <WrapPanel><Button Content="Estimate all owners" Command="{Binding EstimateObjectCommand}" ToolTip="Model removing every owner and root to this object, without changing the app"/><Button Content="Estimate slot" Command="{Binding EstimateReferenceCommand}" ToolTip="Model removing just the selected reference slot"/></WrapPanel>
     <TextBlock Text="{Binding SelectedReference.Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding SelectedReference.Owner}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Note}"><Style.Triggers><DataTrigger Binding="{Binding SelectedReference}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
     <TextBlock Text="Reading fields and root paths…" Style="{StaticResource Note}" Visibility="{Binding IsInspecting, Converter={StaticResource BooleanToVisibility}}"/>
    </StackPanel>
    <TabControl Grid.Row="2" SelectedIndex="{Binding InspectorTab}">
     <TabItem Header="Roots"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,6">
      <TextBlock Text="GC-root examples" Style="{StaticResource Label}"/>
      <TextBlock Text="Follow ownership from each root down to the selected object. These examples do not enumerate every possible path." Style="{StaticResource Note}" Margin="0,0,0,6"/>
      <ItemsControl ItemsSource="{Binding RootPaths}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Label}" IsExpanded="True" Margin="0,0,0,8"><ContentControl Content="{Binding}" ContentTemplate="{StaticResource PathReferences}"/></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Root search reached a display or traversal limit." Style="{StaticResource Note}" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding Details.PathsTruncated, Converter={StaticResource BooleanToVisibility}}"/>
      <TextBlock Text="Dominating owners" Style="{StaticResource Label}"/>
      <ItemsControl ItemsSource="{Binding Details.Dominators}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Type}" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left" Command="{Binding DataContext.InspectObjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}" ToolTip="Every captured root path to the selected object passes through this owner"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Observed retention" Style="{StaticResource Label}"/>
      <ItemsControl ItemsSource="{Binding Details.Evidence}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource Note}" Margin="0,0,0,8"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Fields"><Grid Margin="2,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding Details.Preview}" Style="{StaticResource Note}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details.Preview}" Margin="0,0,0,6"/>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Details.Fields}" IsReadOnly="True" AutoGenerateColumns="False" MinColumnWidth="80" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Object fields"><DataGrid.Columns>
       <DataGridTextColumn Header="Field" Binding="{Binding Name}" Width="100"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
       <DataGridTemplateColumn Header="Object" Width="62"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Inspect" Style="{StaticResource QuietButton}" Command="{Binding DataContext.OpenFieldObjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="3,2" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="160"/>
      </DataGrid.Columns></DataGrid>
      <TextBlock Grid.Row="2" Text="Captured fields · getters are never evaluated" Style="{StaticResource Note}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="Up to 128 fields and 20 delegate targets are displayed. Strings are bounded to 200–256 characters." Margin="0,6,0,0"/>
     </Grid></TabItem>
     <TabItem Header="References"><Grid Margin="2,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding ReferenceCoverage}" Style="{StaticResource Note}"/>
      <TextBlock Grid.Row="1" Text="Incoming owners and roots" Style="{StaticResource Label}"/>
      <DataGrid Grid.Row="2" ItemsSource="{Binding Details.Incoming}" SelectedItem="{Binding SelectedIncomingReference}" IsReadOnly="True" AutoGenerateColumns="False" MinColumnWidth="80" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Incoming memory references"><DataGrid.Columns>
       <DataGridTextColumn Header="Slot" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="180"/><DataGridTemplateColumn Header="Open" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Owner" Style="{StaticResource QuietButton}" Command="{Binding DataContext.OpenReferenceOwnerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="3,2" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="120"/>
      </DataGrid.Columns></DataGrid>
      <TextBlock Grid.Row="3" Text="Outgoing references" Style="{StaticResource Label}"/>
      <DataGrid Grid.Row="4" ItemsSource="{Binding Details.Outgoing}" SelectedItem="{Binding SelectedOutgoingReference}" IsReadOnly="True" AutoGenerateColumns="False" MinColumnWidth="80" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Outgoing memory references"><DataGrid.Columns>
       <DataGridTextColumn Header="Slot" Binding="{Binding Label}" Width="*"/><DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="180"/><DataGridTemplateColumn Header="Open" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="Target" Style="{StaticResource QuietButton}" Command="{Binding DataContext.OpenReferenceTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="3,2" Margin="0"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
      </DataGrid.Columns></DataGrid>
     </Grid></TabItem>
     <TabItem Header="What if"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,8">
      <TextBlock Text="{Binding EstimateHeading}" Style="{StaticResource Note}"/><TextBlock Text="{Binding EstimateSize}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" ToolTip="{Binding ReleaseEstimate.ReclaimableBytes, StringFormat={}{0:N0} bytes}"/>
      <TextBlock Text="{Binding ReleaseEstimate.ReclaimableObjects, StringFormat={}{0:N0} objects}" Style="{StaticResource Note}" Margin="0,4,0,8"/>
      <TextBlock Text="{Binding ReleaseDescription}" Style="{StaticResource Note}"/>
      <TextBlock Text="The selected object still has a root path." Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,10,0,6" Visibility="{Binding ReleaseEstimate.SelectedObjectRemainsReachable, Converter={StaticResource BooleanToVisibility}}"/>
      <ContentControl Content="{Binding ReleaseEstimate.RemainingRootPath}" ContentTemplate="{StaticResource PathReferences}" Margin="0,0,0,8"/>
      <TextBlock Text="Objects that become eligible" Style="{StaticResource Label}"/>
      <ItemsControl ItemsSource="{Binding ReleaseEstimate.Types}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,9"><TextBlock Text="{Binding Type}" TextWrapping="Wrap"/><TextBlock Foreground="{DynamicResource MutedBrush}" FontSize="11"><Run Text="{Binding Count, StringFormat=N0}"/><Run Text=" objects · "/><Run Text="{Binding Bytes, Converter={StaticResource Bytes}}"/></TextBlock></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <TextBlock Text="Green map nodes show a sample of the largest affected objects, up to 200. Values are managed object bytes, not a forecast of OS working-set reduction." Style="{StaticResource Note}" Margin="0,8,0,0"/>
      <Button Content="Cancel estimate" Command="{Binding EstimateObjectCancelCommand}" Visibility="{Binding EstimateObjectCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}"/>
      <Button Content="Cancel slot estimate" Command="{Binding EstimateReferenceCancelCommand}" Visibility="{Binding EstimateReferenceCommand.IsRunning, Converter={StaticResource BooleanToVisibility}}"/>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid>
  </Grid>
  <StackPanel Grid.Row="5" Margin="0,8,0,0">
   <ProgressBar IsIndeterminate="True" Height="3" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibility}}"/>
   <TextBlock Text="{Binding BusyMessage}" Style="{StaticResource Note}"/>
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" MaxHeight="45" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" AutomationProperties.LiveSetting="Polite"/>
  </StackPanel>
 </Grid>
</UserControl>
