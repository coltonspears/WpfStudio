<UserControl x:Class="WpfStudio.App.Features.Profiling.MemoryOverviewView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:p="clr-namespace:WpfStudio.App.Features.Profiling" xmlns:v="clr-namespace:WpfStudio.App.Features.Profiling.Visuals"
 xmlns:c="clr-namespace:WpfStudio.App.Controls">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="MemoryStyles.xaml"/></ResourceDictionary.MergedDictionaries>
   <Style x:Key="SeverityStripe" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding Severity}" Value="High"><Setter Property="Background" Value="{DynamicResource DangerBrush}"/></DataTrigger>
     <DataTrigger Binding="{Binding Severity}" Value="Medium"><Setter Property="Background" Value="{DynamicResource WarningBrush}"/></DataTrigger>
     <DataTrigger Binding="{Binding Severity}" Value="Low"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger>
    </Style.Triggers>
   </Style>
   <Style x:Key="SeverityText" TargetType="TextBlock" BasedOn="{StaticResource Eyebrow}">
    <Style.Triggers>
     <DataTrigger Binding="{Binding Severity}" Value="High"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
     <DataTrigger Binding="{Binding Severity}" Value="Medium"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
     <DataTrigger Binding="{Binding Severity}" Value="Low"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></DataTrigger>
    </Style.Triggers>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="Scroller">
  <StackPanel Margin="14,12,14,16">
   <!-- Headline numbers -->
   <ItemsControl ItemsSource="{Binding Kpis}" Focusable="False">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Loaded="KpiGridLoaded"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
     <DataTemplate>
      <Border Style="{StaticResource Panel}" Margin="0,0,8,8" ToolTip="{Binding ToolTip}">
       <StackPanel>
        <TextBlock Text="{Binding Label}" Style="{StaticResource Eyebrow}"/>
        <TextBlock Text="{Binding Value}" Style="{StaticResource KpiValue}"/>
        <TextBlock Text="{Binding Detail}" Style="{StaticResource Note}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding Delta}" Style="{StaticResource Note}" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding HasDelta, Converter={StaticResource BooleanToVisibility}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
       </StackPanel>
      </Border>
     </DataTemplate>
    </ItemsControl.ItemTemplate>
   </ItemsControl>

   <!-- Generations -->
   <Border Style="{StaticResource Panel}" Margin="0,0,8,8">
    <StackPanel>
     <DockPanel Margin="0,0,0,8">
      <TextBlock Text="Heap by generation" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
      <ItemsControl ItemsSource="{Binding GenerationSegments}" HorizontalAlignment="Right" Focusable="False">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <StackPanel Orientation="Horizontal" Margin="12,0,0,0" ToolTip="{Binding ValueText}">
          <Border Width="10" Height="10" CornerRadius="3" VerticalAlignment="Center" Margin="0,0,5,0" Background="{Binding ColorIndex, Converter={x:Static p:SeriesBrushConverter.Instance}}"/>
          <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
         </StackPanel>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </DockPanel>
     <v:SegmentBar Segments="{Binding GenerationSegments}" Height="12" AutomationProperties.Name="Heap by generation"/>
     <TextBlock Style="{StaticResource SubtleNote}" Margin="0,6,0,0" Text="Long-lived data ends up in generation 2. Objects of 85,000 bytes or more go straight to the large object heap. Hover a segment for its size."/>
    </StackPanel>
   </Border>

   <!-- Findings and composition -->
   <Grid x:Name="MainGrid">
    <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="6*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="FindingsPanel" Style="{StaticResource Panel}" Margin="0,0,8,8" Padding="14,12,14,6">
     <StackPanel>
      <DockPanel Margin="0,0,0,4">
       <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Margin="0"><TextBlock Text="{Binding FindingsHeading}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></Border>
       <TextBlock Text="Findings" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Style="{StaticResource Note}" Margin="0,0,0,10" Text="Patterns that usually mean a leak or wasted memory. Each one is evidence to check, not a verdict."/>
      <TextBlock Text="{Binding FindingsEmptyText}" Style="{StaticResource Note}" FontSize="12" Margin="0,4,0,10" Visibility="{Binding HasFindings, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>
      <ItemsControl ItemsSource="{Binding Findings}" Focusable="False">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Margin="0,0,0,8" Background="{DynamicResource SurfaceBrush}">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Border Style="{StaticResource SeverityStripe}" CornerRadius="7,0,0,7"/>
           <StackPanel Grid.Column="1" Margin="12,9,12,8">
            <DockPanel>
             <TextBlock DockPanel.Dock="Right" Text="{Binding BytesText}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
             <StackPanel Orientation="Horizontal">
              <c:Glyph Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,6,0" Foreground="{Binding Foreground, ElementName=Severity}"/>
              <TextBlock x:Name="Severity" Text="{Binding CategoryText}" Style="{StaticResource SeverityText}" VerticalAlignment="Center"/>
             </StackPanel>
            </DockPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="12.5" Margin="0,4,0,2" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Note}"/>
            <Expander Header="Details and next steps" Margin="-4,6,0,0" Padding="0">
             <StackPanel Margin="4,4,0,4">
              <TextBlock Text="{Binding Guidance}" Style="{StaticResource Note}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
              <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
               <ItemsControl.ItemTemplate>
                <DataTemplate>
                 <Button Style="{StaticResource RowButton}" Padding="6,4" Margin="-6,0,0,0" IsEnabled="{Binding CanOpen}" p:MemoryMenus.Target="{Binding}"
                  Command="{Binding DataContext.OpenFindingItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="Open">
                  <Grid>
                   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                   <StackPanel>
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Note}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                   </StackPanel>
                   <TextBlock Grid.Column="1" Text="{Binding BytesText}" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                  </Grid>
                 </Button>
                </DataTemplate>
               </ItemsControl.ItemTemplate>
              </ItemsControl>
             </StackPanel>
            </Expander>
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>

    <Border x:Name="CompositionPanel" Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,8,8">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel>
       <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <ComboBox ItemsSource="{Binding CompositionGroupings}" SelectedItem="{Binding CompositionGrouping}" Width="110" Margin="0,0,6,0" AutomationProperties.Name="Composition grouping"/>
        <ComboBox ItemsSource="{Binding CompositionMetrics}" SelectedItem="{Binding CompositionMetric}" Width="128" AutomationProperties.Name="Composition size"/>
       </StackPanel>
       <TextBlock Text="Heap composition" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
      </DockPanel>
      <TextBlock Grid.Row="1" Style="{StaticResource Note}" Margin="0,4,0,8" Text="Area is size. Each colour is a namespace (or assembly); the biggest eight get their own colour."/>
      <v:MemoryTreemap Grid.Row="2" Height="330" Items="{Binding CompositionItems}" SelectedKey="{Binding SelectedCompositionKey}"
       SelectCommand="{Binding SelectCompositionCommand}" OpenCommand="{Binding OpenCompositionCommand}" AutomationProperties.Name="Heap composition treemap"/>
      <DockPanel Grid.Row="3" Margin="0,8,0,0">
       <Button DockPanel.Dock="Right" Content="Open type" Style="{StaticResource LinkButton}" Command="{Binding OpenTypeCommand}" CommandParameter="{Binding CompositionSelectedType.Key}"
        Visibility="{Binding CompositionSelectedType, Converter={StaticResource Presence}}"/>
       <TextBlock Text="{Binding CompositionSelection}" Style="{StaticResource Note}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
      </DockPanel>
     </Grid>
    </Border>

    <!-- Biggest owners -->
    <Border x:Name="RetainersPanel" Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,8,8">
     <StackPanel>
      <TextBlock Text="Largest owners" Style="{StaticResource SectionTitle}"/>
      <TextBlock Style="{StaticResource Note}" Margin="0,2,0,8" Text="Objects that exclusively keep the most memory alive. Removing one would free everything it retains."/>
      <ItemsControl ItemsSource="{Binding TopRetainers}" Focusable="False">
       <ItemsControl.ItemTemplate>
        <DataTemplate>
         <Button Style="{StaticResource RowButton}" Margin="-8,0,-8,0" Command="{Binding DataContext.OpenRetainerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Object.Type}" p:MemoryMenus.Target="{Binding}">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Namespace, Mode=OneWay}" Foreground="{DynamicResource SubtleBrush}" FontSize="11"/></TextBlock>
           <TextBlock Grid.Column="1" Text="{Binding RetainedText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="10,0,0,0"/>
           <v:RatioBar Grid.Row="1" Grid.ColumnSpan="2" Value="{Binding Ratio}" Maximum="1" Margin="0,4,0,3"/>
           <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Detail}" Style="{StaticResource SubtleNote}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
          </Grid>
         </Button>
        </DataTemplate>
       </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Border>

    <!-- Growth since baseline, or how to get it -->
    <Border x:Name="GrowthPanel" Grid.Row="1" Grid.Column="1" Style="{StaticResource Panel}" Margin="0,0,8,8">
     <Grid>
      <StackPanel Visibility="{Binding HasGrowth, Converter={StaticResource BooleanToVisibility}}">
       <TextBlock Text="Growth since baseline" Style="{StaticResource SectionTitle}"/>
       <TextBlock Style="{StaticResource Note}" Margin="0,2,0,8" Text="Types that gained memory compared with the baseline snapshot. Repeat the workload: what keeps growing is your leak."/>
       <ItemsControl ItemsSource="{Binding GrowthRows}" Focusable="False">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Button Style="{StaticResource RowButton}" Margin="-8,0,-8,0" Command="{Binding DataContext.OpenGrowthCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="{Binding Type.ToolTipText}" p:MemoryMenus.Target="{Binding}">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Note}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="{Binding DeltaText}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" Margin="10,0,0,0"/>
            <v:RatioBar Grid.Row="1" Grid.ColumnSpan="3" Value="{Binding Ratio}" Maximum="1" Fill="{DynamicResource DangerBrush}" Margin="0,4,0,2"/>
           </Grid>
          </Button>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <StackPanel Visibility="{Binding HasGrowth, Converter={StaticResource Presence}, ConverterParameter=Invert}">
       <TextBlock Text="Find growth" Style="{StaticResource SectionTitle}"/>
       <TextBlock Style="{StaticResource Note}" Margin="0,2,0,10" Text="One snapshot shows what is alive. Two snapshots show what is accumulating."/>
       <Grid Margin="0,0,0,6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="1" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
        <TextBlock Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,6"><Run Text="Choose " /><Run Text="Set baseline" FontWeight="SemiBold"/><Run Text=" above to pin this snapshot's totals."/></TextBlock>
        <TextBlock Grid.Row="1" Text="2" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="0,0,0,6" Text="Repeat the suspect action in the app a few times, for example opening and closing a window."/>
        <TextBlock Grid.Row="2" Text="3" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"><Run Text="Capture again. Growing types appear here and under "/><Run Text="Findings" FontWeight="SemiBold"/><Run Text="."/></TextBlock>
       </Grid>
       <Button Content="Set baseline now" c:Ui.Icon="Baseline" Command="{Binding SetBaselineCommand}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</UserControl>
