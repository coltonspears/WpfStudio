<UserControl x:Class="WpfStudio.App.Features.ColtonGpt.AssistantSettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:WpfStudio.App.Features.ColtonGpt"
 MinWidth="320" MaxWidth="640">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="ColtonGPT" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
  <TextBlock Text="Connect your OpenRouter account" FontSize="14" Margin="0,4,0,16"/>
  <Border Background="{DynamicResource EditorBrush}" CornerRadius="4" Padding="12" Margin="0,0,0,16"><TextBlock Text="Messages and explicitly attached code are sent to OpenRouter and the selected model provider. Model pricing and data policies vary. ColtonGPT starts requests only when you send a message; it cannot run commands or change files." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/></Border>
  <TextBlock Text="OPENROUTER API KEY" Style="{DynamicResource SectionLabel}"/>
  <PasswordBox local:AssistantViewBehavior.Password="{Binding PendingApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="OpenRouter API key" ToolTip="Paste your key from openrouter.ai/settings/keys; leave blank to keep the saved key"/>
  <DockPanel Margin="0,5,0,16"><Button DockPanel.Dock="Right" Content="Remove saved key" Command="{Binding ClearKeyCommand}" Style="{DynamicResource QuietButton}"/><TextBlock Text="{Binding CredentialStatus}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></DockPanel>
  <DockPanel Margin="0,0,0,5"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Load models" Command="{Binding RefreshModelsCommand}"/><Button Content="Cancel" Command="{Binding RefreshModelsCancelCommand}"/></StackPanel><TextBlock Text="MODEL" Style="{DynamicResource SectionLabel}" VerticalAlignment="Center"/></DockPanel>
  <ComboBox ItemsSource="{Binding Models}" IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Id" Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Id" AutomationProperties.Name="OpenRouter model ID" ToolTip="Choose a model or enter its exact OpenRouter model ID"/>
  <TextBlock Text="Paste your key above, then load models. You can also paste a model ID from openrouter.ai/models." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="2,5,0,16"/>
  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,12,0"><TextBlock Text="MAXIMUM OUTPUT TOKENS" Style="{DynamicResource SectionLabel}"/><TextBox Text="{Binding MaxOutputTokens, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Maximum output tokens"/><TextBlock Text="256–16,384" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1"><CheckBox Content="Custom temperature" IsChecked="{Binding UseTemperature}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/><TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" IsEnabled="{Binding UseTemperature}" AutomationProperties.Name="Model temperature"/><TextBlock Text="0–2 · off uses model default" Foreground="{DynamicResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/></StackPanel>
  </Grid>
  <TextBlock Text="Saved keys use Windows user-scoped protection. Conversation history is kept in memory and cleared when WpfStudio closes." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,14"/>
  <DockPanel><Button DockPanel.Dock="Right" Content="Save ColtonGPT settings" Command="{Binding SaveCommand}" Style="{DynamicResource AccentButton}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.LiveSetting="Polite"/></DockPanel>
 </StackPanel></ScrollViewer>
</UserControl>
