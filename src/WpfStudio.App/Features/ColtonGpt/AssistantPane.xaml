<UserControl x:Class="WpfStudio.App.Features.ColtonGpt.AssistantPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:WpfStudio.App.Features.ColtonGpt"
 xmlns:c="clr-namespace:WpfStudio.App.Controls"
 MinWidth="280" Background="{DynamicResource SurfaceBrush}">
 <Grid Margin="12,4,12,10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,8">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
    <Button Style="{DynamicResource IconButton}" c:Ui.Icon="Plus" Command="{Binding ClearCommand}" ToolTip="New chat — clears the in-memory conversation" Width="26" Height="26"/>
    <Button Style="{DynamicResource IconButton}" c:Ui.Icon="Settings" Command="{Binding OpenSettingsCommand}" ToolTip="ColtonGPT settings" Width="26" Height="26"/>
   </StackPanel>
   <Border Width="28" Height="28" CornerRadius="7" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
    <c:Glyph Kind="Chat" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}"/>
   </Border>
   <StackPanel VerticalAlignment="Center">
    <TextBlock Text="ColtonGPT" FontSize="13" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding ModelLabel}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ModelLabel}"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1">
   <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12" MaxWidth="300" Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibility}}">
    <c:Glyph Kind="Chat" Width="28" Height="28" Foreground="{DynamicResource SubtleBrush}" StrokeWeight="1.1"/>
    <TextBlock Text="Ask about your WPF code" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,4"/>
    <TextBlock Text="Nothing is sent until you press Send. Attach the selection or document explicitly and preview the exact request below." Style="{StaticResource Caption}" TextAlignment="Center"/>
    <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12,10">
     <StackPanel>
      <TextBlock Text="TRY" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
      <TextBlock Text="Why is this binding not updating?" Foreground="{DynamicResource MutedBrush}" Margin="0,2"/>
      <TextBlock Text="Help me split this view model." Foreground="{DynamicResource MutedBrush}" Margin="0,2"/>
      <TextBlock Text="Review this async relay command." Foreground="{DynamicResource MutedBrush}" Margin="0,2"/>
     </StackPanel>
    </Border>
   </StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" local:AssistantViewBehavior.FollowOutput="True">
    <ItemsControl ItemsSource="{Binding Messages}" HorizontalContentAlignment="Stretch">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Border x:Name="Bubble" CornerRadius="8" Padding="10,8,10,9" Margin="0,4,4,4" Background="Transparent">
       <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
         <Border x:Name="Avatar" Width="18" Height="18" CornerRadius="9" Background="{DynamicResource RaisedBrush}" Margin="0,0,7,0">
          <c:Glyph x:Name="AvatarGlyph" Kind="Chat" Width="11" Height="11" Foreground="{DynamicResource MutedBrush}" StrokeWeight="1.6"/>
         </Border>
         <TextBlock Text="{Binding Role}" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0" MinHeight="0" Background="Transparent" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Conversation message"/>
        <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource SubtleBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
      <DataTemplate.Triggers>
       <DataTrigger Binding="{Binding IsAssistant}" Value="False">
        <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource EditorBrush}"/>
        <Setter TargetName="AvatarGlyph" Property="Kind" Value="Braces"/>
       </DataTrigger>
       <DataTrigger Binding="{Binding IsAssistant}" Value="True">
        <Setter TargetName="Avatar" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter TargetName="AvatarGlyph" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
       </DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </ScrollViewer>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,10,0,0">
   <Border Background="{DynamicResource EditorBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" CornerRadius="8">
    <StackPanel>
     <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="180" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" BorderThickness="0" Background="Transparent" Padding="10,8"
              c:Ui.Placeholder="Ask ColtonGPT…" AutomationProperties.Name="Message ColtonGPT" ToolTip="Write a message; use Ctrl+Enter to send">
      <TextBox.InputBindings><KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SendCommand}"/></TextBox.InputBindings>
     </TextBox>
     <DockPanel Margin="6,0,6,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
       <Button Style="{DynamicResource IconButton}" c:Ui.Icon="Stop" Command="{Binding SendCancelCommand}" ToolTip="Stop the response" Width="26" Height="26"/>
       <Button Content="Send" c:Ui.Icon="ChevronRight" Command="{Binding SendCommand}" Style="{DynamicResource AccentButton}" ToolTip="Send the previewed request to OpenRouter (Ctrl+Enter)" MinHeight="26" Padding="10,2" Margin="4,0,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding PromptCount}" Foreground="{DynamicResource SubtleBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="4,0,0,0"/>
     </DockPanel>
    </StackPanel>
   </Border>
   <DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Style="{DynamicResource IconButton}" c:Ui.Icon="Refresh" Command="{Binding RefreshContextCommand}" ToolTip="Update the context preview from the active editor" Width="26" Height="26"/><ComboBox ItemsSource="{Binding ContextOptions}" SelectedItem="{Binding ContextMode}" Margin="0,0,2,0" AutomationProperties.Name="Editor context to attach" ToolTip="Editor context to attach"/></DockPanel>
   <TextBlock Text="{Binding ContextLabel}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" TextWrapping="Wrap" Margin="2,4,0,4"/>
   <Expander Header="Preview exactly what will be sent" Margin="0,0,0,2" FontSize="11.5">
    <TextBox Text="{Binding RequestPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="200" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="{DynamicResource CodeFont}" FontSize="11" AutomationProperties.Name="Full request preview"/>
   </Expander>
  </StackPanel>
  <StackPanel Grid.Row="3" Margin="0,6,0,0">
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Text="{Binding HistorySummary}" TextWrapping="Wrap" FontSize="10.5" Foreground="{DynamicResource SubtleBrush}" Margin="0,3,0,0"/>
   <Expander Header="Last request sent" FontSize="11" Margin="0,2,0,0"><TextBox Text="{Binding LastRequestPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" FontFamily="{DynamicResource CodeFont}" FontSize="11"/></Expander>
  </StackPanel>
 </Grid>
</UserControl>
