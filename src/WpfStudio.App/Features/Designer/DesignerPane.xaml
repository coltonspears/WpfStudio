<UserControl x:Class="WpfStudio.App.Features.Designer.DesignerPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:WpfStudio.App.Features.Designer" xmlns:b="clr-namespace:WpfStudio.App.Behaviors"
 xmlns:c="clr-namespace:WpfStudio.App.Controls"
 xmlns:layout="clr-namespace:WpfStudio.App.Features.Layout" xmlns:appearance="clr-namespace:WpfStudio.App.Features.Appearance"
 xmlns:bindings="clr-namespace:WpfStudio.App.Features.BindingSources">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="DesignerBoolVisibility"/>
  <local:NativePreviewSuppressionConverter x:Key="NativePreviewSuppression"/>
  <local:PropertyIsSetConverter x:Key="PropertyIsSet"/>
  <!-- The appearance picker lists every property; the grid's search filter applies only to the grid. -->
  <CollectionViewSource x:Key="AppearanceProperties" Source="{Binding Properties}"/>

  <!-- Pasteboard: a quiet dot grid around the artboard. -->
  <DrawingBrush x:Key="PasteboardBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute" Viewbox="0,0,16,16" ViewboxUnits="Absolute">
   <DrawingBrush.Drawing>
    <DrawingGroup>
     <GeometryDrawing Brush="{DynamicResource CanvasBrush}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16"/></GeometryDrawing.Geometry></GeometryDrawing>
     <GeometryDrawing Brush="{DynamicResource CanvasDotBrush}"><GeometryDrawing.Geometry><EllipseGeometry Center="1,1" RadiusX="1" RadiusY="1"/></GeometryDrawing.Geometry></GeometryDrawing>
    </DrawingGroup>
   </DrawingBrush.Drawing>
  </DrawingBrush>

  <Style x:Key="ToolbarSeparator" TargetType="Border">
   <Setter Property="Width" Value="1"/>
   <Setter Property="Height" Value="18"/>
   <Setter Property="Margin" Value="6,0"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style x:Key="CanvasBarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="Width" Value="26"/>
   <Setter Property="Height" Value="24"/>
  </Style>
  <!-- Compact inspector tabs keep all five headers visible in a 360 px inspector. -->
  <Style x:Key="InspectorTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
   <Setter Property="Padding" Value="6,0"/>
  </Style>

  <HierarchicalDataTemplate DataType="{x:Type local:DesignerNode}" ItemsSource="{Binding Children}">
   <DockPanel x:Name="Row" ToolTip="{Binding ToolTip}" Background="Transparent">
    <c:Glyph x:Name="Icon" Kind="{Binding IconKind}" Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}"/>
    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"><Run Text="{Binding TypeName, Mode=OneWay}"/><Run
      Text="{Binding NameSuffix, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/></TextBlock>
   </DockPanel>
   <HierarchicalDataTemplate.Triggers>
    <!-- Template and framework parts are available but visually secondary to authored markup. -->
    <DataTrigger Binding="{Binding IsAuthored}" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.5"/></DataTrigger>
   </HierarchicalDataTemplate.Triggers>
  </HierarchicalDataTemplate>
 </UserControl.Resources>
 <UserControl.InputBindings>
  <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomToFitCommand}"/>
  <KeyBinding Gesture="Ctrl+D1" Command="{Binding ZoomToActualSizeCommand}"/>
  <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomInCommand}"/>
  <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomOutCommand}"/>
 </UserControl.InputBindings>

 <DockPanel Background="{DynamicResource SurfaceBrush}">
  <StackPanel x:Name="DesignerHeader" DockPanel.Dock="Top">
   <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,4">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <WrapPanel VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,8,0" ToolTip="{Binding SourcePath}">
       <c:Glyph Kind="Markup" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
       <TextBlock Text="{Binding DocumentName}" MaxWidth="220" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </StackPanel>
      <ComboBox ItemsSource="{Binding PreviewModes}" SelectedItem="{Binding Mode}" MinWidth="96" Margin="1,0" Height="28" VerticalAlignment="Center"
                AutomationProperties.Name="Preview mode" ToolTip="Source renders the editor buffer; Compiled runs the last built view and its code-behind"/>
      <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource ToolbarButton}" c:Ui.Icon="Refresh" VerticalAlignment="Center"
              ToolTip="Recreate the preview from its source or built view; resets preview state"/>
      <CheckBox Content="Live" IsChecked="{Binding AutoRefresh}" IsEnabled="{Binding SupportsLivePreview}" Style="{StaticResource ToolbarToggle}" c:Ui.Icon="Play"
                AutomationProperties.Name="Live preview" ToolTip="Live preview: re-render as you type in the XAML editor (Source mode)"/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <Button Content="Interact" Command="{Binding EnterInteractionCommand}" c:Ui.Icon="Interact" VerticalAlignment="Center"
              AutomationProperties.Name="Interact with preview" ToolTip="Use the real view with mouse and keyboard at 100% size. Press F8 to return to inspection.">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}"><Style.Triggers>
        <DataTrigger Binding="{Binding IsInteracting}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
       </Style.Triggers></Style></Button.Style>
      </Button>
      <Button Content="Inspect" Command="{Binding ExitInteractionCommand}" c:Ui.Icon="Pointer" VerticalAlignment="Center"
              AutomationProperties.Name="Inspect preview" ToolTip="Return to picking and overlays; update the snapshot without recreating the view (F8)">
       <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
        <DataTrigger Binding="{Binding IsInteracting}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
       </Style.Triggers></Style></Button.Style>
      </Button>
      <CheckBox Content="Edit layout" IsChecked="{Binding IsLayoutEditingEnabled}" Style="{StaticResource ToolbarToggle}" c:Ui.Icon="Move"
                AutomationProperties.Name="Edit preview layout" ToolTip="Move or resize an authored element, then review one XAML edit. Source preview in Inspect mode only."/>
      <CheckBox IsChecked="{Binding SnapToLayout}" IsEnabled="{Binding IsLayoutEditingEnabled}" Style="{StaticResource ToolbarToggle}" c:Ui.Icon="Magnet"
                AutomationProperties.Name="Snap preview layout" ToolTip="Snap to layout: snap pointer gestures to nearby layout edges and centers; hold Alt to bypass. Keyboard nudges do not snap."/>
      <Border Style="{StaticResource ToolbarSeparator}"/>
      <ComboBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" DisplayMemberPath="Name" Height="28" VerticalAlignment="Center"
                MinWidth="130" MaxWidth="240" AutomationProperties.Name="Preview scenario" Margin="1,0"
                ToolTip="{Binding ScenarioDescription}"/>
      <CheckBox Content="d:" IsChecked="{Binding UseDesignTimeValues}" IsEnabled="{Binding SupportsLivePreview}" Style="{StaticResource ToolbarToggle}" c:Ui.Icon="Braces"
                AutomationProperties.Name="Use design-time values" ToolTip="Design-time values: apply supported d: values in Source mode. Refresh to apply changes."/>
     </WrapPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
      <Button Command="{Binding UpdateSnapshotCommand}" Style="{StaticResource IconButton}" c:Ui.Icon="Camera"
              AutomationProperties.Name="Update preview snapshot" ToolTip="Update snapshot: reread the existing view, tree and diagnostics without recreating the preview"/>
      <Button Command="{Binding RestartCommand}" Style="{StaticResource IconButton}" c:Ui.Icon="Restart"
              AutomationProperties.Name="Restart preview" ToolTip="Restart the isolated preview process and reload built controls"/>
      <Button Command="{Binding StopCommand}" Style="{StaticResource IconButton}" c:Ui.Icon="Stop"
              AutomationProperties.Name="Stop preview" ToolTip="Stop the preview process; Refresh resumes"/>
      <ToggleButton IsChecked="{Binding IsExpanded, ElementName=PreviewSettings}" Style="{StaticResource IconButton}" c:Ui.Icon="Settings"
                    AutomationProperties.Name="Show preview settings" ToolTip="Preview settings: artboard size, compiled view, scenario configuration"/>
     </StackPanel>
    </Grid>
   </Border>
   <Expander x:Name="PreviewSettings" IsExpanded="False" AutomationProperties.Name="Preview settings">
    <Expander.Template>
     <ControlTemplate TargetType="Expander">
      <Border x:Name="Body" Visibility="Collapsed" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8,14,8">
       <ContentPresenter/>
      </Border>
      <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
     </ControlTemplate>
    </Expander.Template>
    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <WrapPanel>
       <TextBlock Text="Artboard" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
       <ComboBox ItemsSource="{Binding SizePresets}" SelectedItem="{Binding SelectedSizePreset}" MinWidth="130" Margin="0,0,8,0"
                 AutomationProperties.Name="Artboard size preset" ToolTip="Auto uses the root's Width/Height or d:DesignWidth/d:DesignHeight"/>
       <TextBox Text="{Binding PreviewWidth}" Width="62" Margin="2" AutomationProperties.Name="Artboard width" ToolTip="Width in DIPs, used when the size is fixed or the root has no width"/>
       <TextBlock Text="×" VerticalAlignment="Center" Margin="2,0" Foreground="{DynamicResource MutedBrush}"/>
       <TextBox Text="{Binding PreviewHeight}" Width="62" Margin="2" AutomationProperties.Name="Artboard height" ToolTip="Height in DIPs, used when the size is fixed or the root has no height"/>
       <Button Content="Reload scenarios" Command="{Binding ReloadScenariosCommand}" Margin="16,2,2,2" c:Ui.Icon="Refresh"/>
       <Button Content="Open configuration" Command="{Binding OpenScenarioConfigurationCommand}" Margin="2" c:Ui.Icon="File"/>
      </WrapPanel>
      <StackPanel Visibility="{Binding UsesApplicationResources, Converter={StaticResource DesignerBoolVisibility}}" Margin="0,8,0,0">
       <WrapPanel>
        <StackPanel Orientation="Horizontal" Visibility="{Binding IsCompiledPreview, Converter={StaticResource DesignerBoolVisibility}}">
         <TextBlock Text="View type" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}"/>
         <TextBox Text="{Binding ViewTypeName, UpdateSourceTrigger=PropertyChanged}" MinWidth="240" Margin="0,0,12,0" ToolTip="Full CLR name of the built view"/>
        </StackPanel>
        <TextBlock Text="App resources" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}"/>
        <TextBox Text="{Binding ApplicationResourcePath, UpdateSourceTrigger=PropertyChanged}" MinWidth="150" ToolTip="Compiled application XAML resource path; leave empty to omit"/>
       </WrapPanel>
       <TextBlock Text="{Binding BuildDescription}" TextWrapping="Wrap" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
      <TextBlock Text="{Binding SessionDescription}" TextWrapping="Wrap" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding ScenarioDescription}" TextWrapping="Wrap" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,2,0,0"/>
      <TextBlock Text="{Binding ScenarioConfigurationTitle}" FontWeight="SemiBold" Margin="0,8,0,0"/>
      <TextBlock Text="{Binding ScenarioConfigurationDescription}" TextWrapping="Wrap" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}"/>
      <TextBlock Text="Factories run from the last built project in the isolated preview. Save configuration changes, then Refresh."
                 TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,2"/>
      <ItemsControl ItemsSource="{Binding ScenarioWarnings}">
       <ItemsControl.ItemTemplate><DataTemplate>
        <DockPanel Margin="0,2"><c:Glyph Kind="Warning" Width="14" Height="14" Foreground="{DynamicResource WarningBrush}" Margin="0,1,6,0" VerticalAlignment="Top"/><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DockPanel>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
   </Expander>
  </StackPanel>

  <!-- Status line -->
  <Border DockPanel.Dock="Bottom" Padding="12,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" MinHeight="26">
   <DockPanel>
    <c:Glyph DockPanel.Dock="Left" Kind="Info" Width="14" Height="14" Margin="0,0,7,0" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"/>
    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
   </DockPanel>
  </Border>

  <Grid x:Name="DesignerBody">
   <Grid.ColumnDefinitions><ColumnDefinition Width="220" MinWidth="140"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*" MinWidth="220"/><ColumnDefinition Width="1"/><ColumnDefinition Width="360" MinWidth="250"/></Grid.ColumnDefinitions>

   <!-- Outline -->
   <DockPanel>
    <DockPanel DockPanel.Dock="Top" Margin="10,6,4,2">
     <Button DockPanel.Dock="Right" Command="{Binding GoToSourceCommand}" Style="{StaticResource IconButton}" c:Ui.Icon="Markup"
             AutomationProperties.Name="Go to source" ToolTip="Go to the selected element's XAML"/>
     <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowLogicalTree}" Style="{StaticResource ToolbarToggle}" c:Ui.Icon="Outline"
               AutomationProperties.Name="Logical tree" ToolTip="Show the logical tree instead of the visual tree"/>
     <TextBlock Text="OUTLINE" Style="{StaticResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
    </DockPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Click selects authored markup · Ctrl+click selects template parts" TextWrapping="Wrap"
               FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="12,4,10,8"/>
    <TreeView ItemsSource="{Binding Tree}" b:Interaction.SelectedNode="{Binding SelectedNode}" b:Interaction.FollowSelection="True" BorderThickness="0"
              VirtualizingPanel.IsVirtualizing="False" AutomationProperties.Name="Preview element outline">
     <TreeView.ItemContainerStyle>
      <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
       <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
       <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
      </Style>
     </TreeView.ItemContainerStyle>
    </TreeView>
   </DockPanel>
   <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Margin="-3,0" BorderThickness="3,0" BorderBrush="Transparent" Background="{DynamicResource BorderBrush}" Panel.ZIndex="1"/>

   <!-- Canvas -->
   <DockPanel Grid.Column="2">
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,3">
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock Text="{Binding ArtboardSizeText}" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"
                  ToolTip="Artboard size in device-independent pixels"/>
       <ComboBox ItemsSource="{Binding SizePresets}" SelectedItem="{Binding SelectedSizePreset}" Style="{StaticResource ToolbarCombo}" Height="24" MinWidth="92"
                 AutomationProperties.Name="Artboard size" ToolTip="Artboard size. Auto uses the root's Width/Height or d:DesignWidth/d:DesignHeight."/>
       <Border Style="{StaticResource ToolbarSeparator}" Height="14"/>
       <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource CanvasBarButton}" c:Ui.Icon="ZoomOut" AutomationProperties.Name="Zoom out" ToolTip="Zoom out (Ctrl+wheel)"/>
       <TextBlock Text="{Binding ZoomText}" MinWidth="40" TextAlignment="Center" VerticalAlignment="Center" FontSize="11" AutomationProperties.Name="Zoom level"/>
       <Button Command="{Binding ZoomInCommand}" Style="{StaticResource CanvasBarButton}" c:Ui.Icon="ZoomIn" AutomationProperties.Name="Zoom in" ToolTip="Zoom in (Ctrl+wheel)"/>
       <ToggleButton IsChecked="{Binding IsZoomToFit}" Style="{StaticResource IconButton}" Width="26" Height="24" c:Ui.Icon="Fit" AutomationProperties.Name="Zoom to fit" ToolTip="Fit the artboard in the canvas"/>
       <Button Command="{Binding ZoomToActualSizeCommand}" Style="{StaticResource CanvasBarButton}" c:Ui.Icon="ActualSize" AutomationProperties.Name="Actual size" ToolTip="Actual size (100%)"/>
      </StackPanel>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{Binding SelectionDescription}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectionDescription}"
                  Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
       <TextBlock Text="{Binding LayoutEditingStatus}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                  ToolTip="{Binding LayoutEditingStatus}" AutomationProperties.Name="Preview layout editing status"
                  Visibility="{Binding IsLayoutEditingEnabled, Converter={StaticResource DesignerBoolVisibility}}"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <Grid Background="{StaticResource PasteboardBrush}" ClipToBounds="True">
     <ScrollViewer x:Name="CanvasScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False"
                   AutomationProperties.Name="Preview canvas area">
      <ScrollViewer.Style><Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}"><Style.Triggers>
       <DataTrigger Binding="{Binding IsInteracting}" Value="True"><Setter Property="Visibility" Value="Hidden"/></DataTrigger>
      </Style.Triggers></Style></ScrollViewer.Style>
      <Grid Margin="32,28,32,32" HorizontalAlignment="Center" VerticalAlignment="Center"
            Visibility="{Binding HasCanvasContent, Converter={StaticResource DesignerBoolVisibility}}">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <DockPanel Margin="1,0,0,6" MaxWidth="{Binding ActualWidth, ElementName=ArtboardFrame}" HorizontalAlignment="Left" MinWidth="0">
        <c:Glyph Kind="Artboard" Width="12" Height="12" Margin="0,0,5,0" Foreground="{DynamicResource SubtleBrush}"/>
        <TextBlock Text="{Binding ArtboardTitle}" FontSize="11" Foreground="{DynamicResource SubtleBrush}" TextTrimming="CharacterEllipsis"/>
       </DockPanel>
       <Grid x:Name="ArtboardFrame" Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Top">
        <Grid.Style><Style TargetType="Grid"><Style.Triggers>
         <DataTrigger Binding="{Binding IsStale}" Value="True"><Setter Property="Opacity" Value="0.5"/></DataTrigger>
        </Style.Triggers></Style></Grid.Style>
        <Border Background="White" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1" Margin="-1">
         <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.3" Color="Black" RenderingBias="Performance"/></Border.Effect>
        </Border>
        <local:PreviewSurface ImageBytes="{Binding DisplayImage}" Scale="{Binding Zoom}" Selection="{Binding SelectionBounds}" LayoutOverlays="{Binding LayoutDetails.VisibleOverlays}"
                              PickCommand="{Binding PickElementCommand}" IsEnabled="{Binding IsCurrent}" HorizontalAlignment="Left" VerticalAlignment="Top"
                              LayoutEditing="{Binding LayoutEditing}" LayoutDraft="{Binding LayoutDraft}" LayoutGestureCommand="{Binding LayoutGestureCommand}"
                              IsLayoutEditingEnabled="{Binding IsLayoutEditingEnabled}" HoverNodes="{Binding CanvasNodes}" SelectionLabel="{Binding SelectionLabel}"
                              AutomationProperties.Name="Preview canvas"/>
       </Grid>
      </Grid>
     </ScrollViewer>

     <!-- Empty state -->
     <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440" Margin="24"
                 Visibility="{Binding HasCanvasContent, Converter={StaticResource Presence}, ConverterParameter=Invert}">
      <c:Glyph Kind="Artboard" Width="36" Height="36" StrokeWeight="1" Foreground="{DynamicResource SubtleBrush}" Margin="0,0,0,12"/>
      <TextBlock Text="{Binding EmptyCanvasTitle}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="{Binding EmptyCanvasText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
     </StackPanel>

     <!-- Busy sweep. The bar is created only while busy: ActivityBar starts its animation
          on Loaded, which fails for a bar that is collapsed before its template is built. -->
     <ContentControl VerticalAlignment="Top" Height="2" Content="" Focusable="False" IsTabStop="False" IsHitTestVisible="False">
      <ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
       <DataTrigger Binding="{Binding IsBusy}" Value="True">
        <Setter Property="Visibility" Value="Visible"/>
        <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><ProgressBar Style="{StaticResource ActivityBar}"/></DataTemplate></Setter.Value></Setter>
       </DataTrigger>
      </Style.Triggers></Style></ContentControl.Style>
     </ContentControl>

     <!-- Last frame notice: shown while an older render stays visible. -->
     <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" Padding="10,4" CornerRadius="12"
             Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1"
             Visibility="{Binding ShowCanvasNotice, Converter={StaticResource DesignerBoolVisibility}}" IsHitTestVisible="False"
             AutomationProperties.Name="Preview update notice">
      <StackPanel Orientation="Horizontal">
       <c:Glyph Kind="Clock" Width="14" Height="14" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}"/>
       <TextBlock Text="{Binding CanvasNotice}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>
     </Border>

     <!-- Render error banner -->
     <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="16,12,16,0" Padding="12,8,8,8" CornerRadius="8" MaxWidth="760"
             Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1"
             Visibility="{Binding HasRenderError, Converter={StaticResource DesignerBoolVisibility}}" AutomationProperties.Name="Preview render error">
      <DockPanel>
       <c:Glyph DockPanel.Dock="Left" Kind="Error" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Top" Margin="0,1,10,0"/>
       <Button DockPanel.Dock="Right" Content="Go to error" Command="{Binding GoToRenderErrorCommand}" Style="{StaticResource QuietButton}" VerticalAlignment="Top" Margin="12,-2,0,0"/>
       <StackPanel>
        <TextBlock FontWeight="SemiBold">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="The preview could not render"/><Style.Triggers>
          <DataTrigger Binding="{Binding HasCanvasContent}" Value="True"><Setter Property="Text" Value="The preview could not render · showing the last successful render"/></DataTrigger>
         </Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <TextBlock Text="{Binding RenderError}" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding RenderError}"/>
       </StackPanel>
      </DockPanel>
     </Border>

     <!-- Native content is never transformed or placed inside a WPF ScrollViewer. -->
     <local:NativePreviewPane Session="{Binding InteractionSession}" IsActive="{Binding IsInteracting}"
                              ContentWidth="{Binding InteractionWidth}" ContentHeight="{Binding InteractionHeight}"
                              ExitInteractionCommand="{Binding ExitInteractionCommand}">
      <local:NativePreviewPane.Style><Style TargetType="local:NativePreviewPane"><Setter Property="Visibility" Value="Hidden"/><Style.Triggers>
       <DataTrigger Binding="{Binding IsInteracting}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
      </Style.Triggers></Style></local:NativePreviewPane.Style>
      <local:NativePreviewPane.IsSuppressed>
       <MultiBinding Converter="{StaticResource NativePreviewSuppression}">
        <Binding Path="MainWindow.DataContext.IsPaletteOpen" Source="{x:Static Application.Current}"/>
        <Binding Path="MainWindow.DataContext.IsScaffoldOpen" Source="{x:Static Application.Current}"/>
        <Binding Path="MainWindow.DataContext.IsPreviewOpen" Source="{x:Static Application.Current}"/>
        <Binding Path="MainWindow.DataContext.IsSettingsOpen" Source="{x:Static Application.Current}"/>
       </MultiBinding>
      </local:NativePreviewPane.IsSuppressed>
     </local:NativePreviewPane>
    </Grid>
   </DockPanel>
   <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Margin="-3,0" BorderThickness="3,0" BorderBrush="Transparent" Background="{DynamicResource BorderBrush}" Panel.ZIndex="1"/>

   <!-- Inspector -->
   <TabControl Grid.Column="4" b:Interaction.FollowSelection="True" SelectedIndex="{Binding SelectedTabIndex}" ItemContainerStyle="{StaticResource InspectorTab}">
    <!-- Keep inspector headers on one row as the pane narrows. Wrapping takes
         space from the selected property's rows and editing controls. -->
    <TabControl.Template>
     <ControlTemplate TargetType="TabControl">
      <Grid KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1">
        <ScrollViewer x:Name="DesignerInspectorTabs" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Focusable="False" CanContentScroll="False" AutomationProperties.Name="Preview inspector tabs">
         <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Margin="4,0" KeyboardNavigation.TabIndex="1" Panel.ZIndex="1"/>
        </ScrollViewer>
       </Border>
       <Border Grid.Row="1" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
               KeyboardNavigation.TabNavigation="Local" KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabIndex="2">
        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
       </Border>
      </Grid>
     </ControlTemplate>
    </TabControl.Template>
    <TabItem Header="Properties">
     <DockPanel>
      <!-- Search and filter -->
      <DockPanel DockPanel.Dock="Top" Margin="8,6,6,6">
       <CheckBox DockPanel.Dock="Right" Content="Set" IsChecked="{Binding ShowSetPropertiesOnly}" Style="{StaticResource ToolbarToggle}" c:Ui.Icon="Filter" Margin="4,0,0,0"
                 AutomationProperties.Name="Show set properties only" ToolTip="Only properties set on this element: local values, bindings, styles, templates and animations"/>
       <TextBox Text="{Binding PropertyFilter, UpdateSourceTrigger=PropertyChanged}" MinHeight="28" ToolTip="{Binding PropertyCountText}"
                c:Ui.Placeholder="{Binding PropertyCountText, StringFormat='Search {0}', TargetNullValue='Search properties', FallbackValue='Search properties'}"
                AutomationProperties.Name="Search properties"/>
      </DockPanel>
      <!-- Selected property editor -->
      <Border DockPanel.Dock="Bottom" Padding="8,6,8,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" IsEnabled="{Binding IsCurrent}">
       <StackPanel>
        <DockPanel>
         <TextBlock Text="{Binding SelectedProperty.Name}" FontWeight="SemiBold" Margin="0,0,8,0"/>
         <TextBlock Text="{Binding SelectedProperty.Type}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource SubtleBrush}" VerticalAlignment="Center"
                    ToolTip="{Binding SelectedProperty.Type}"/>
        </DockPanel>
        <TextBox Text="{Binding EditedValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,4" MinHeight="28" MaxHeight="96"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource CodeFont}"
                 c:Ui.Placeholder="Select a property to edit its value" AutomationProperties.Name="Property value"
                 ToolTip="Literal property value; try it in the preview or review a XAML edit"/>
        <WrapPanel>
         <WrapPanel IsEnabled="{Binding SelectedProperty.CanEdit}">
          <Button Content="Try value" Command="{Binding ApplyPropertyCommand}" Margin="0,0,4,0" MinHeight="26" Padding="10,2"
                  ToolTip="Temporarily apply this value in the preview; the source does not change"/>
          <Button Content="Reset" Command="{Binding ResetPropertyCommand}" Margin="0,0,4,0" MinHeight="26" Padding="10,2" ToolTip="Restore the original preview value"/>
         </WrapPanel>
         <WrapPanel ToolTip="{Binding SourceEditDescription}">
          <Button Content="Write to XAML…" Command="{Binding WritePropertyToSourceCommand}" Margin="0,0,4,0" MinHeight="26" Padding="10,2"/>
          <Button Content="Remove local XAML…" Command="{Binding RemovePropertyFromSourceCommand}" Style="{StaticResource QuietButton}" MinHeight="26" Padding="8,2"/>
         </WrapPanel>
        </WrapPanel>
       </StackPanel>
      </Border>
      <DataGrid x:Name="PreviewPropertiesGrid" ItemsSource="{Binding Properties}" SelectedItem="{Binding SelectedProperty}" b:Interaction.FollowSelection="True"
                AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" RowHeight="26" GridLinesVisibility="None"
                AutomationProperties.Name="Preview properties">
       <DataGrid.Columns>
        <DataGridTemplateColumn Header="Property" Width="120" SortMemberPath="Name">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <TextBlock x:Name="Name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OwnerType}" Foreground="{DynamicResource MutedBrush}"/>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding Converter={StaticResource PropertyIsSet}}" Value="True">
            <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
           </DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Value" Width="*" SortMemberPath="Value">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <DockPanel ToolTip="{Binding Value}">
           <c:Glyph x:Name="Bound" Kind="Link" Width="12" Height="12" Margin="0,0,5,0" Foreground="{DynamicResource SuccessBrush}" Visibility="Collapsed"
                    ToolTip="{Binding BindingPath, StringFormat='Binding: {0}'}"/>
           <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding IsExpression}" Value="True"><Setter TargetName="Bound" Property="Visibility" Value="Visible"/></DataTrigger>
           <DataTrigger Binding="{Binding BindingStatus}" Value="PathError"><Setter TargetName="Bound" Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="From" Width="84" SortMemberPath="ValueSource">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Border x:Name="Pill" CornerRadius="4" Padding="5,0" HorizontalAlignment="Left" ToolTip="{Binding ValueSource}">
           <TextBlock x:Name="Source" Text="{Binding ValueSource}" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubtleBrush}"/>
          </Border>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding Converter={StaticResource PropertyIsSet}}" Value="True">
            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="Source" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
           </DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>
    </TabItem>
    <TabItem Header="Bindings">
     <DockPanel>
      <bindings:BindingSourcePanel DockPanel.Dock="Top"/>
      <diagnostics:BindingExplanationPanel xmlns:diagnostics="clr-namespace:WpfStudio.App.Features.BindingDiagnostics" DataContext="{Binding BindingExplanation}"/>
     </DockPanel>
    </TabItem>
    <TabItem Header="Diagnostics" AutomationProperties.Name="Preview diagnostics">
     <TabItem.HeaderTemplate><DataTemplate>
      <StackPanel Orientation="Horizontal">
       <TextBlock Text="{Binding}"/>
       <Border Style="{StaticResource Badge}" Margin="5,0,0,0" Padding="5,0"
               Visibility="{Binding DataContext.DiagnosticsSummary, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource Presence}}">
        <TextBlock Text="{Binding DataContext.DiagnosticsSummary, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
       </Border>
      </StackPanel>
     </DataTemplate></TabItem.HeaderTemplate>
     <DockPanel>
      <TextBlock DockPanel.Dock="Top" Text="No diagnostics for this preview." Margin="12,10" Foreground="{DynamicResource MutedBrush}"
                 Visibility="{Binding Diagnostics.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>
      <ListBox ItemsSource="{Binding Diagnostics}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Preview diagnostics list">
       <ListBox.ItemTemplate><DataTemplate>
        <DockPanel Margin="0,2">
         <c:Glyph x:Name="Severity" DockPanel.Dock="Left" Kind="Info" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top" Foreground="{DynamicResource MutedBrush}"/>
         <StackPanel>
          <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
          <TextBlock FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0" Visibility="{Binding Line, Converter={StaticResource Presence}}">
           <Run Text="Line"/> <Run Text="{Binding Line, Mode=OneWay}"/><Run Text=", column"/> <Run Text="{Binding Column, Mode=OneWay}"/>
          </TextBlock>
          <Button Content="Explain binding" HorizontalAlignment="Left" Margin="0,4,0,0" c:Ui.Icon="Link"
                  Command="{Binding DataContext.ShowBindingDiagnosticCommand,RelativeSource={RelativeSource AncestorType=UserControl}}"
                  CommandParameter="{Binding}" AutomationProperties.Name="Explain preview binding">
           <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding BindingId}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style>
          </Button>
         </StackPanel>
        </DockPanel>
        <DataTemplate.Triggers>
         <DataTrigger Binding="{Binding Severity}" Value="Error"><Setter TargetName="Severity" Property="Kind" Value="Error"/><Setter TargetName="Severity" Property="Foreground" Value="{DynamicResource DangerBrush}"/></DataTrigger>
         <DataTrigger Binding="{Binding Severity}" Value="Warning"><Setter TargetName="Severity" Property="Kind" Value="Warning"/><Setter TargetName="Severity" Property="Foreground" Value="{DynamicResource WarningBrush}"/></DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </DockPanel>
    </TabItem>
    <TabItem Header="Layout" AutomationProperties.Name="Element layout"><layout:LayoutPanel DataContext="{Binding LayoutDetails}"/></TabItem>
    <TabItem Header="Appearance" IsSelected="{Binding AppearanceTabIsActive, Mode=TwoWay}" AutomationProperties.Name="Property appearance">
     <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="8,6">
       <Button DockPanel.Dock="Right" Command="{Binding RefreshAppearanceCommand}" Style="{StaticResource IconButton}" c:Ui.Icon="Refresh" Margin="6,0,0,0"
               AutomationProperties.Name="Refresh appearance" ToolTip="Refresh appearance"/>
       <ComboBox ItemsSource="{Binding Source={StaticResource AppearanceProperties}}" SelectedItem="{Binding SelectedProperty, Mode=TwoWay}" AutomationProperties.Name="Appearance property">
        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip="{Binding OwnerType}"/></DataTemplate></ComboBox.ItemTemplate>
       </ComboBox>
      </DockPanel>
      <appearance:AppearancePanel DataContext="{Binding AppearanceDetails}"/>
     </DockPanel>
    </TabItem>
   </TabControl>
  </Grid>
 </DockPanel>
</UserControl>
