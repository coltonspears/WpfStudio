<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WpfStudio.Contracts\WpfStudio.Contracts.csproj" />
    <ProjectReference Include="..\WpfStudio.Core\WpfStudio.Core.csproj" />
    <ProjectReference Include="..\WpfStudio.Workspace\WpfStudio.Workspace.csproj" />
    <ProjectReference Include="..\WpfStudio.Database\WpfStudio.Database.csproj" />
    <ProjectReference Include="..\WpfStudio.Runtime\WpfStudio.Runtime.csproj" />
    <ProjectReference Include="..\WpfStudio.WorkspaceHost\WpfStudio.WorkspaceHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WpfStudio.PreviewHost\WpfStudio.PreviewHost.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\WpfStudio.Inspection.StartupHook\WpfStudio.Inspection.StartupHook.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="..\WpfStudio.Inspection.Agent\WpfStudio.Inspection.Agent.csproj" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Dirkster.AvalonDock" Version="5.0.0" />
    <PackageReference Include="Dirkster.AvalonDock.Serializer.Xml" Version="5.0.0" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WpfStudio</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\WpfStudio.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\WpfStudio.ico" />
  </ItemGroup>

  <Target Name="CopyWorkspaceHost" AfterTargets="Build">
    <ItemGroup>
      <WorkspaceHostFiles Include="$(MSBuildProjectDirectory)\..\WpfStudio.WorkspaceHost\bin\$(Configuration)\net10.0\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkspaceHostFiles)" DestinationFiles="@(WorkspaceHostFiles->'$(OutDir)WorkspaceHost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPreviewHost" AfterTargets="Build">
    <ItemGroup>
      <PreviewHostFiles Include="$(MSBuildProjectDirectory)\..\WpfStudio.PreviewHost\bin\$(Configuration)\net10.0-windows\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PreviewHostFiles)" DestinationFiles="@(PreviewHostFiles->'$(OutDir)PreviewHost\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyInspectionAgent" AfterTargets="Build">
    <ItemGroup>
      <InspectionFiles Include="$(MSBuildProjectDirectory)\..\WpfStudio.Inspection.StartupHook\bin\$(Configuration)\net8.0\WpfStudio.Inspection.StartupHook.dll" />
      <InspectionFiles Include="$(MSBuildProjectDirectory)\..\WpfStudio.Inspection.Agent\bin\$(Configuration)\net8.0-windows\WpfStudio.Inspection.Agent.dll" />
      <InspectionFiles Include="$(MSBuildProjectDirectory)\..\WpfStudio.Inspection.Agent\bin\$(Configuration)\net8.0-windows\WpfStudio.Inspection.Protocol.dll" />
      <InspectionFiles Include="$(MSBuildProjectDirectory)\..\WpfStudio.Inspection.Agent\bin\$(Configuration)\net8.0-windows\WpfStudio.Wpf.PropertyEditing.dll" />
      <InspectionFiles Include="$(MSBuildProjectDirectory)\..\WpfStudio.Inspection.Agent\bin\$(Configuration)\net8.0-windows\WpfStudio.Wpf.Diagnostics.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(InspectionFiles)" DestinationFolder="$(OutDir)Inspection" SkipUnchangedFiles="true" />
  </Target>
</Project>
