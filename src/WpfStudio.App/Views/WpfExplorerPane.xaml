<UserControl x:Class="WpfStudio.App.Views.WpfExplorerPane"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:c="clr-namespace:WpfStudio.App.Controls" xmlns:b="clr-namespace:WpfStudio.App.Behaviors">
 <DockPanel Background="{DynamicResource SurfaceBrush}">
  <StackPanel DockPanel.Dock="Top" Margin="10,0,10,4">
   <DockPanel Height="28" Margin="2,0,0,6">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
     <Button Style="{StaticResource IconButton}" c:Ui.Icon="NewFile" Command="{Binding NewWpfItemCommand}" ToolTip="New WPF item (Ctrl+Shift+N)" Width="26" Height="26"/>
     <Button Style="{StaticResource IconButton}" c:Ui.Icon="Refresh" Command="{Binding RefreshWpfCommand}" ToolTip="Refresh the WPF index" Width="26" Height="26"/>
    </StackPanel>
    <TextBlock Text="{Binding WpfSummary}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding WpfSummary}"/>
   </DockPanel>
   <Grid>
    <TextBox Text="{Binding WpfFilter, UpdateSourceTrigger=PropertyChanged}" Padding="28,5,7,5" c:Ui.Placeholder="Search names, keys and files" ToolTip="Search names, resource keys, and file paths"/>
    <c:Glyph Kind="Search" Width="14" Height="14" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="{DynamicResource SubtleBrush}" IsHitTestVisible="False"/>
   </Grid>
   <DockPanel Margin="0,6,0,0">
    <TextBlock DockPanel.Dock="Right" Text="{Binding WpfResultSummary}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,2,0"/>
    <ComboBox ItemsSource="{Binding WpfCategories}" SelectedItem="{Binding WpfCategory}" Margin="0" ToolTip="Filter by kind"/>
   </DockPanel>
  </StackPanel>
  <TabControl Margin="0,2,0,0">
   <TabItem Header="Components"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="0"/><Style.Triggers><DataTrigger Binding="{Binding HasWpfSelection}" Value="True"><Setter Property="Height" Value="1.4*"/></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition></Grid.RowDefinitions>
    <ListBox ItemsSource="{Binding WpfItems}" SelectedItem="{Binding SelectedWpfItem}" b:Interaction.ActivateCommand="{Binding NavigateWpfCommand}" b:Interaction.SelectOnRightClick="True" Padding="2,4">
     <ListBox.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Open source" c:Ui.Icon="File" Command="{Binding NavigateWpfCommand}" CommandParameter="{Binding SelectedWpfItem}"/><MenuItem Header="Rename resource key…" c:Ui.Icon="Tag" Command="{Binding RenameResourceCommand}" IsEnabled="{Binding CanRenameWpfResource}"/><Separator/><MenuItem Header="New WPF item…" c:Ui.Icon="NewFile" Command="{Binding NewWpfItemCommand}"/><MenuItem Header="Refresh" c:Ui.Icon="Refresh" Command="{Binding RefreshWpfCommand}"/></ContextMenu></ListBox.ContextMenu>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><c:StudioIcon Kind="{Binding Kind}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,0,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"><Run Text="{Binding TypeLabel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding FileLabel, Mode=OneWay}"/></TextBlock></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Text="Open a WPF project to see its views, view models, dictionaries, styles and converters." Style="{StaticResource Caption}" TextAlignment="Center" Margin="24,40,24,0" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="{Binding WpfItems.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}"/>
    <Border Grid.Row="1" Visibility="{Binding HasWpfSelection, Converter={StaticResource BooleanToVisibility}}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,10,10,6"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <DockPanel><c:StudioIcon DockPanel.Dock="Left" Kind="{Binding SelectedWpfItem.Kind}" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="{Binding SelectedWpfItem.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
     <TextBlock Text="{Binding SelectedWpfDescription}" Style="{StaticResource Caption}" FontSize="11.5" Margin="0,6,0,8"/>
     <TextBlock Text="{Binding WpfUsageSummary}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
     <ListBox ItemsSource="{Binding WpfReferences}" MaxHeight="110" Margin="-6,4,-6,4" b:Interaction.ActivateCommand="{Binding NavigateSearchCommand}"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><c:StudioIcon Kind="{Binding Path, Converter={StaticResource FileIconKind}}" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="{Binding Location}" Foreground="{DynamicResource AccentBrush}"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock Text="{Binding SelectedWpfItem.Path}" ToolTip="{Binding SelectedWpfItem.Path}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource SubtleBrush}" Margin="0,2,0,0"/>
     <WrapPanel Margin="-2,8,0,0"><Button Content="Open source" c:Ui.Icon="File" Command="{Binding NavigateWpfCommand}" CommandParameter="{Binding SelectedWpfItem}" IsEnabled="{Binding HasWpfSelection}"/><Button Content="Rename key…" c:Ui.Icon="Tag" Command="{Binding RenameResourceCommand}" IsEnabled="{Binding CanRenameWpfResource}"/></WrapPanel>
     <Expander Header="Asset tools" Margin="0,10,0,0" Visibility="{Binding HasWpfAssetSelection, Converter={StaticResource BooleanToVisibility}}"><StackPanel><Button Content="Import asset…" c:Ui.Icon="Image" Command="{Binding ImportAssetCommand}" HorizontalAlignment="Left"/><ComboBox ItemsSource="{Binding BuildActions}" SelectedItem="{Binding SelectedBuildAction}" ToolTip="Build action"/><WrapPanel><Button Content="Set build action" Command="{Binding SetBuildActionCommand}"/><Button Content="Show pack URI" c:Ui.Icon="Link" Command="{Binding ShowPackUriCommand}"/></WrapPanel></StackPanel></Expander>
    </StackPanel></ScrollViewer></Border>
   </Grid></TabItem>
   <TabItem Header="{Binding WpfIssueTitle}">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Margin="12,8,12,4">
      <TextBlock Text="Errors are definite problems. Informational items need runtime or library context and may be valid." Style="{StaticResource Caption}" />
      <TextBlock Text="{Binding XamlAnalysisStatus}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
      <Button Content="Check project XAML" Style="{StaticResource QuietButton}" Command="{Binding RefreshProjectXamlAnalysisCommand}" HorizontalAlignment="Left" Margin="-4,4,0,0" />
     </StackPanel>
     <ListBox ItemsSource="{Binding WpfIssues}" b:Interaction.ActivateCommand="{Binding NavigateDiagnosticCommand}">
      <ListBox.ItemTemplate><DataTemplate><DockPanel>
       <c:Glyph DockPanel.Dock="Left" Width="15" Height="15" Margin="0,1,8,0" VerticalAlignment="Top" Kind="{Binding Severity, Converter={StaticResource SeverityGlyph}}" Foreground="{Binding Severity, Converter={StaticResource SeverityGlyph}, ConverterParameter=Brush}"/>
       <StackPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ProjectName}" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,3,0,0" Visibility="{Binding ProjectName, Converter={StaticResource Presence}}"/>
        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="0,3,0,0"/>
       </StackPanel>
      </DockPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </TabItem>
  </TabControl>
 </DockPanel>
</UserControl>
