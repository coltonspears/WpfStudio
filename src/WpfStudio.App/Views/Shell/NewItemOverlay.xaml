<UserControl x:Class="WpfStudio.App.Views.Shell.NewItemOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WpfStudio.App.Controls"
             xmlns:b="clr-namespace:WpfStudio.App.Behaviors">
  <UserControl.Resources>
    <c:ScaffoldKindTextConverter x:Key="ScaffoldText" />
  </UserControl.Resources>
  <Grid Background="{DynamicResource OverlayBrush}">
    <Grid.InputBindings>
      <KeyBinding Key="Escape" Command="{Binding CancelScaffoldCommand}" />
    </Grid.InputBindings>
    <Border Style="{StaticResource OverlayCard}" Width="560" VerticalAlignment="Center" Padding="28,24">
      <StackPanel>
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Close" Command="{Binding CancelScaffoldCommand}" ToolTip="Cancel (Esc)" />
          <TextBlock Text="New WPF item" FontSize="20" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" />
        </DockPanel>
        <TextBlock Text="Generates the files together. You review every change before anything is written." Style="{StaticResource Caption}" FontSize="12" Margin="0,0,0,18" />
        <TextBlock Text="TYPE" Style="{StaticResource SectionLabel}" />
        <ListBox ItemsSource="{Binding ScaffoldKinds}" SelectedItem="{Binding SelectedScaffoldKind}" Margin="-4,0,-4,14" Padding="0">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Padding" Value="10,7" />
              <Setter Property="Margin" Value="4,1" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <c:Glyph DockPanel.Dock="Left" Kind="{Binding Converter={StaticResource ScaffoldText}, ConverterParameter=Icon}" Width="16" Height="16" Margin="0,0,12,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <StackPanel>
                  <TextBlock Text="{Binding Converter={StaticResource ScaffoldText}}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Converter={StaticResource ScaffoldText}, ConverterParameter=Detail}" Style="{StaticResource Caption}" Margin="0,1,0,0" />
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="NAME" Style="{StaticResource SectionLabel}" />
        <TextBox Text="{Binding ScaffoldName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" FontSize="13" b:Interaction.FocusWhenVisible="True" c:Ui.Placeholder="CustomerView">
          <TextBox.InputBindings>
            <KeyBinding Key="Enter" Command="{Binding CreateWpfItemCommand}" />
          </TextBox.InputBindings>
        </TextBox>
        <CheckBox Content="Also add a view-model DataTemplate to a shared dictionary" IsChecked="{Binding AddDataTemplate}" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
          <Button Content="Cancel" Command="{Binding CancelScaffoldCommand}" />
          <Button Content="Preview files" c:Ui.Icon="ChevronRight" Command="{Binding CreateWpfItemCommand}" Style="{StaticResource AccentButton}" Margin="8,2,0,2" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
