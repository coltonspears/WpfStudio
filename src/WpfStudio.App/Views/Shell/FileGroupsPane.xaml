<UserControl x:Class="WpfStudio.App.Views.Shell.FileGroupsPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workbench="clr-namespace:WpfStudio.App.Features.Workbench"
             xmlns:controls="clr-namespace:WpfStudio.App.Controls"
             xmlns:c="clr-namespace:WpfStudio.App.Controls"
             xmlns:b="clr-namespace:WpfStudio.App.Behaviors">
  <DockPanel Background="{DynamicResource SurfaceBrush}">
    <DockPanel DockPanel.Dock="Top" Margin="12,0,6,4" Height="28">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource IconButton}" c:Ui.Icon="Pin" Command="{Binding FileGroups.AddOpenTabsCommand}" ToolTip="Pin the open tabs as a group" Width="26" Height="26" />
        <Button Style="{StaticResource IconButton}" c:Ui.Icon="Plus" Command="{Binding FileGroups.AddActiveCommand}" ToolTip="Add the active file to a group" Width="26" Height="26" />
      </StackPanel>
      <TextBlock Text="Files you open together" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" />
    </DockPanel>
    <Grid>
      <TreeView ItemsSource="{Binding FileGroups.Groups}" b:Interaction.SelectOnRightClick="True">
        <TreeView.Resources>
          <HierarchicalDataTemplate DataType="{x:Type workbench:FileGroupViewModel}" ItemsSource="{Binding Files}">
            <DockPanel Background="Transparent">
              <DockPanel.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.FileGroups.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}" />
              </DockPanel.InputBindings>
              <DockPanel.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Open all" c:Ui.Icon="FolderOpen" Command="{Binding PlacementTarget.Tag.FileGroups.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                  <MenuItem Header="Switch to this group" ToolTip="Close other tabs, then open this group" Command="{Binding PlacementTarget.Tag.FileGroups.SwitchToGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                  <Separator />
                  <MenuItem Header="Rename…" Command="{Binding PlacementTarget.Tag.FileGroups.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                  <MenuItem Header="Delete group" c:Ui.Icon="Trash" Command="{Binding PlacementTarget.Tag.FileGroups.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                </ContextMenu>
              </DockPanel.ContextMenu>
              <DockPanel.Tag><Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=TreeView}" /></DockPanel.Tag>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="FolderOpen" Width="22" Height="22" ToolTip="Open all files in this group"
                      Command="{Binding DataContext.FileGroups.OpenGroupCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}" />
              <c:Glyph DockPanel.Dock="Left" Kind="Pin" Width="14" Height="14" Margin="0,0,7,0" Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
            </DockPanel>
          </HierarchicalDataTemplate>
          <DataTemplate DataType="{x:Type workbench:FileGroupEntry}">
            <DockPanel Background="Transparent" ToolTip="{Binding Path}">
              <DockPanel.InputBindings>
                <MouseBinding Gesture="LeftDoubleClick" Command="{Binding DataContext.FileGroups.OpenEntryCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}" />
              </DockPanel.InputBindings>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Close" Width="20" Height="20" ToolTip="Remove from group"
                      Command="{Binding DataContext.FileGroups.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" CommandParameter="{Binding}" />
              <controls:StudioIcon DockPanel.Dock="Left" Kind="{Binding IconKind}" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </DockPanel>
          </DataTemplate>
        </TreeView.Resources>
        <TreeView.ItemContainerStyle>
          <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay, FallbackValue=False}" />
          </Style>
        </TreeView.ItemContainerStyle>
      </TreeView>
      <StackPanel VerticalAlignment="Center" Margin="22,0,22,40" Visibility="{Binding FileGroups.Groups.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}">
        <c:Glyph Kind="Pin" Width="26" Height="26" Foreground="{DynamicResource SubtleBrush}" StrokeWeight="1.1" />
        <TextBlock Text="No file groups" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
        <TextBlock Text="Pin the files of a feature together, then open them all in one step. Use the pin button to group the open tabs, or right-click a file in Solution Explorer." Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
