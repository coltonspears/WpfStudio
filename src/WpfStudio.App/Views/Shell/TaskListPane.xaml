<UserControl x:Class="WpfStudio.App.Views.Shell.TaskListPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WpfStudio.App.Controls"
             xmlns:b="clr-namespace:WpfStudio.App.Behaviors">
  <Grid Background="{DynamicResource SurfaceBrush}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="5" /><ColumnDefinition Width="320" MinWidth="200" /></Grid.ColumnDefinitions>
    <!-- TODO-style comments found in the workspace -->
    <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="10,3,8,3">
        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Refresh" Command="{Binding TaskList.RefreshCommand}" ToolTip="Rescan the workspace for TODO, HACK, FIXME, UNDONE and BUG comments" Width="26" Height="26" />
        <TextBox DockPanel.Dock="Left" Width="220" Text="{Binding TaskList.Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}" c:Ui.Placeholder="Filter comments" />
        <TextBlock Text="{Binding TaskList.Status}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <DataGrid ItemsSource="{Binding TaskList.Comments}" SelectedItem="{Binding TaskList.SelectedComment}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" b:Interaction.ActivateCommand="{Binding TaskList.NavigateCommentCommand}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Token" Binding="{Binding Token}" Width="70" />
          <DataGridTextColumn Header="Description" Binding="{Binding Text}" Width="*" />
          <DataGridTextColumn Header="Owner" Binding="{Binding Owner}" Width="90" />
          <DataGridTextColumn Header="File" Binding="{Binding Location}" Width="200" />
        </DataGrid.Columns>
      </DataGrid>
    </DockPanel>
    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{DynamicResource BorderBrush}" />
    <!-- The user's own to-do items for this workspace -->
    <DockPanel Grid.Column="2">
      <DockPanel DockPanel.Dock="Top" Margin="10,3,8,3">
        <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Clear done" Command="{Binding TaskList.ClearCompletedCommand}" ToolTip="Remove checked tasks" />
        <TextBlock Text="MY TASKS" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0" />
      </DockPanel>
      <TextBox DockPanel.Dock="Top" Margin="10,0,8,6" Text="{Binding TaskList.NewTaskText, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Add a task (start with @ to link the caret line)">
        <TextBox.InputBindings>
          <KeyBinding Key="Enter" Command="{Binding TaskList.AddCommand}" />
        </TextBox.InputBindings>
      </TextBox>
      <ListBox ItemsSource="{Binding TaskList.UserTasks}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" b:Interaction.ActivateCommand="{Binding TaskList.NavigateUserTaskCommand}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Close" Width="22" Height="22" ToolTip="Remove task"
                      Command="{Binding DataContext.TaskList.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding Location}" Foreground="{DynamicResource AccentBrush}" Margin="6,0" VerticalAlignment="Center" Visibility="{Binding HasLocation, Converter={StaticResource BooleanToVisibility}}" />
              <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
              </CheckBox>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
