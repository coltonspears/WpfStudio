<UserControl x:Class="WpfStudio.App.Views.Shell.OutputPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WpfStudio.App.Controls">
  <DockPanel Background="{DynamicResource SurfaceBrush}">
    <DockPanel DockPanel.Dock="Top" Margin="12,0,6,4" Height="26">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Trash" Command="{Binding ClearOutputCommand}" ToolTip="Clear output" Width="26" Height="26" />
      <TextBlock Text="Build, restore, test and workspace messages" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" />
    </DockPanel>
    <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource CodeFont}" FontSize="12" BorderThickness="0" Padding="12,6" AcceptsReturn="True" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="{DynamicResource EditorBrush}" />
  </DockPanel>
</UserControl>
