<UserControl x:Class="WpfStudio.App.Views.Shell.FileGroupPickerOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:workbench="clr-namespace:WpfStudio.App.Features.Workbench"
             xmlns:controls="clr-namespace:WpfStudio.App.Controls"
             xmlns:c="clr-namespace:WpfStudio.App.Controls"
             xmlns:b="clr-namespace:WpfStudio.App.Behaviors">
  <!-- Chooses the file group that files go to: an existing group from the list, or a new one named below it.
       The DataContext is a FileGroupPickerViewModel. -->
  <Grid Background="{DynamicResource OverlayBrush}">
    <Grid.InputBindings>
      <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
      <KeyBinding Key="Enter" Command="{Binding AddCommand}" />
    </Grid.InputBindings>
    <Border Style="{StaticResource OverlayCard}" Width="520" VerticalAlignment="Center" Padding="28,24" AutomationProperties.Name="{Binding Title}">
      <StackPanel>
        <DockPanel Margin="0,0,0,4">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Close" Command="{Binding CancelCommand}" ToolTip="Cancel (Esc)" />
          <c:Glyph DockPanel.Dock="Left" Kind="Pin" Width="18" Height="18" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <TextBlock Text="{Binding FilesSummary}" Style="{StaticResource Caption}" FontSize="12" Margin="0,0,0,8" />
        <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,18" Focusable="False">
          <ItemsControl ItemsSource="{Binding Files}" Focusable="False" AutomationProperties.Name="Files to add">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type workbench:FileGroupCandidate}">
                <Border Background="{DynamicResource RaisedBrush}" CornerRadius="4" Padding="6,2,8,2" Margin="0,0,4,4" ToolTip="{Binding Path}">
                  <StackPanel Orientation="Horizontal">
                    <controls:StudioIcon Kind="{Binding IconKind}" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <TextBlock Text="GROUP" Style="{StaticResource SectionLabel}" />
        <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" MaxHeight="240" Margin="-4,0,-4,8" Padding="0" AutomationProperties.Name="File group">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
              <Setter Property="Padding" Value="10,7" />
              <Setter Property="Margin" Value="4,1" />
              <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type workbench:FileGroupChoice}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Detail}" Style="{StaticResource Caption}" TextWrapping="NoWrap" VerticalAlignment="Center" Margin="12,0,0,0" />
                <c:Glyph DockPanel.Dock="Left" Kind="{Binding Icon}" Width="14" Height="14" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBox Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" c:Ui.Placeholder="Or name a new group, such as Orders feature"
                 b:Interaction.FocusWhenTrue="{Binding FocusNewName}" AutomationProperties.Name="New group name">
          <TextBox.Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsNewGroup}" Value="False" />
                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="False" />
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Opacity" Value="0.6" />
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </TextBox.Style>
        </TextBox>
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Error, Converter={StaticResource Presence}}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
          <Button Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Content="{Binding AddLabel}" c:Ui.Icon="Pin" Command="{Binding AddCommand}" Style="{StaticResource AccentButton}" Margin="8,2,0,2" MaxWidth="300" ToolTip="Enter" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
