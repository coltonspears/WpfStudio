<UserControl x:Class="WpfStudio.App.Views.Shell.TasksPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WpfStudio.App.Controls"
             xmlns:b="clr-namespace:WpfStudio.App.Behaviors"
             xmlns:tasks="clr-namespace:WpfStudio.App.Features.Tasks">
  <UserControl.Resources>
    <Style x:Key="StateGlyph" TargetType="c:Glyph">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Margin" Value="2,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Visibility" Value="Hidden" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding State}" Value="{x:Static tasks:TaskRunState.Running}">
          <Setter Property="Kind" Value="Play" /><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static tasks:TaskRunState.Succeeded}">
          <Setter Property="Kind" Value="Check" /><Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" /><Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static tasks:TaskRunState.Failed}">
          <Setter Property="Kind" Value="Error" /><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /><Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
        <DataTrigger Binding="{Binding State}" Value="{x:Static tasks:TaskRunState.Stopped}">
          <Setter Property="Kind" Value="Stop" /><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Visibility" Value="Visible" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Margin" Value="6,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
      <Setter Property="Margin" Value="0,8,0,3" />
    </Style>
  </UserControl.Resources>
  <Grid Background="{DynamicResource SurfaceBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <DockPanel Margin="10,3,8,3">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Refresh" Command="{Binding Tasks.RefreshCommand}" Width="26" Height="26" ToolTip="Read the tasks files again" />
      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Stop" Command="{Binding Tasks.StopAllCommand}" Width="26" Height="26" ToolTip="Stop every running task" />
      <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Personal tasks" Command="{Binding Tasks.EditPersonalCommand}" ToolTip="{Binding Tasks.PersonalFile}" Margin="4,0" />
      <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Shared tasks" Command="{Binding Tasks.EditSharedCommand}" IsEnabled="{Binding Tasks.HasWorkspace}" ToolTip="The repository's .wpfstudio/tasks.json" Margin="4,0" />
      <Button DockPanel.Dock="Right" Style="{StaticResource QuietButton}" c:Ui.Icon="Plus" Content="New task…" Command="{Binding Tasks.NewTaskCommand}" Margin="4,0" />
      <Button DockPanel.Dock="Left" Style="{StaticResource QuietButton}" c:Ui.Icon="Build" Content="Run build task" Command="{Binding Tasks.RunBuildTaskCommand}" ToolTip="Run the default task of the build group" Margin="0,0,6,0" />
      <TextBox DockPanel.Dock="Left" Width="180" Text="{Binding Tasks.Filter, UpdateSourceTrigger=PropertyChanged, Delay=150}" c:Ui.Placeholder="Filter tasks" AutomationProperties.Name="Filter tasks" />
      <TextBlock Text="{Binding Tasks.Status}" Foreground="{DynamicResource SubtleBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tasks.Status}" />
    </DockPanel>

    <!-- Files that could not be read completely -->
    <Border Grid.Row="1" Margin="10,0,8,4" Padding="8,5" CornerRadius="4" Background="{DynamicResource WarningSoftBrush}" Visibility="{Binding Tasks.HasProblems, Converter={StaticResource BooleanToVisibility}}">
      <ItemsControl ItemsSource="{Binding Tasks.FileProblems}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock TextWrapping="Wrap" Margin="0,1">
              <Hyperlink Command="{Binding DataContext.Tasks.NavigateProblemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding Path}"><Run Text="{Binding Location, Mode=OneWay}" /></Hyperlink><Run Text=": " /><Run Text="{Binding Message, Mode=OneWay}" />
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- The tasks -->
    <ListBox Grid.Row="2" ItemsSource="{Binding Tasks.Items}" SelectedItem="{Binding Tasks.SelectedItem}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             b:Interaction.ActivateCommand="{Binding Tasks.RunCommand}" AutomationProperties.Name="Tasks">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel ToolTip="{Binding ToolTip}" Margin="0,2">
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Braces" Width="24" Height="24" ToolTip="Edit in its tasks file" Visibility="{Binding CanEdit, Converter={StaticResource BooleanToVisibility}}"
                    Command="{Binding DataContext.Tasks.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Restart" Width="24" Height="24" ToolTip="Stop and run again" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}"
                    Command="{Binding DataContext.Tasks.RestartCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Stop" Width="24" Height="24" ToolTip="Stop" Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibility}}"
                    Command="{Binding DataContext.Tasks.StopCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Play" Width="24" Height="24" ToolTip="Run" Visibility="{Binding IsRunning, Converter={StaticResource Presence}, ConverterParameter=Invert}"
                    Command="{Binding DataContext.Tasks.RunCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" Margin="8,0" />
            <c:Glyph DockPanel.Dock="Left" Style="{StaticResource StateGlyph}" />
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Style="{StaticResource Chip}" Visibility="{Binding GroupText, Converter={StaticResource Presence}}"><TextBlock Text="{Binding GroupText}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" /></Border>
                <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding SourceText}" FontSize="10.5" Foreground="{DynamicResource MutedBrush}" /></Border>
              </StackPanel>
              <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource SubtleBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="460" IsHitTestVisible="False"
                Visibility="{Binding Tasks.Items.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}">
      <TextBlock Text="{Binding Tasks.Status}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" />
      <TextBlock Foreground="{DynamicResource SubtleBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" FontSize="11.5"
                 Text="Tasks use Visual Studio Code's tasks.json format: shell and process tasks, groups, dependsOn and the $msCompile problem matcher." />
    </StackPanel>

    <!-- New task -->
    <Border Grid.Column="1" Grid.RowSpan="3" Width="360" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,0,0" Visibility="{Binding Tasks.Editor.IsOpen, Converter={StaticResource BooleanToVisibility}}">
      <DockPanel DataContext="{Binding Tasks}">
        <DockPanel DockPanel.Dock="Top" Margin="12,6,8,0">
          <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" c:Ui.Icon="Close" Width="24" Height="24" Command="{Binding CancelNewTaskCommand}" ToolTip="Close without saving" />
          <TextBlock Text="NEW TASK" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0" />
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,10">
          <TextBlock Text="{Binding Editor.Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Visibility="{Binding Editor.Error, Converter={StaticResource Presence}}" Margin="0,0,0,6" />
          <TextBlock Text="{Binding Editor.TestStatus}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Visibility="{Binding Editor.TestStatus, Converter={StaticResource Presence}}" Margin="0,0,0,6" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Style="{StaticResource QuietButton}" c:Ui.Icon="Play" Content="Test run" Command="{Binding TestNewTaskCommand}" ToolTip="Run it in the terminal as it stands, without saving it" Margin="0,0,6,0" />
            <Button Style="{StaticResource AccentButton}" Content="Save…" Command="{Binding SaveNewTaskCommand}" ToolTip="Review the change to the tasks file, then save it" />
          </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,0,12,6" DataContext="{Binding Editor}">
            <TextBlock Text="Label" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Task label" />
            <TextBlock Text="Command" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" c:Ui.Placeholder="dotnet build -c ${configuration}" AutomationProperties.Name="Command" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
              <RadioButton Style="{StaticResource Segment}" GroupName="TaskKind" Content="Through PowerShell" IsChecked="{Binding IsProcess, Converter={StaticResource Not}}" ToolTip="The command is a PowerShell command line" />
              <RadioButton Style="{StaticResource Segment}" GroupName="TaskKind" Content="As a program" IsChecked="{Binding IsProcess}" ToolTip="The command is one program, found on PATH, and the arguments are passed to it as they are" />
            </StackPanel>
            <TextBlock Text="Arguments" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" c:Ui.Placeholder="Quote an argument that has spaces" AutomationProperties.Name="Arguments" />
            <TextBlock Text="Working folder" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" c:Ui.Placeholder="${workspaceFolder}" AutomationProperties.Name="Working folder" />
            <TextBlock Text="Environment variables, one NAME=value per line" Style="{StaticResource FieldLabel}" />
            <TextBox Text="{Binding EnvironmentText, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource CodeFont}" AcceptsReturn="True" MinHeight="54" MaxHeight="120" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Environment variables" />
            <TextBlock Text="Group" Style="{StaticResource FieldLabel}" />
            <DockPanel>
              <ComboBox ItemsSource="{Binding Groups}" SelectedItem="{Binding Group}" Width="110" AutomationProperties.Name="Group" />
              <CheckBox Content="Default task of the group" IsChecked="{Binding IsDefault}" IsEnabled="{Binding HasGroup}" Margin="10,0,0,0" VerticalAlignment="Center" ToolTip="Run build task and Run test task start this one without asking" />
            </DockPanel>
            <CheckBox Content="Show MSBuild errors and warnings in Problems" IsChecked="{Binding MatchMSBuildProblems}" Margin="0,10,0,0" ToolTip="Reads file(line,column): error CODE: message lines from the output. MSBuild's live progress display is turned off for the task, so the lines arrive whole." />
            <TextBlock Text="Save in" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
            <StackPanel Orientation="Horizontal">
              <RadioButton Style="{StaticResource Segment}" GroupName="TaskFile" Content="Repository" IsChecked="{Binding SaveToPersonal, Converter={StaticResource Not}}" IsEnabled="{Binding DataContext.HasWorkspace, RelativeSource={RelativeSource AncestorType=DockPanel}}" ToolTip=".wpfstudio/tasks.json, shared through source control" />
              <RadioButton Style="{StaticResource Segment}" GroupName="TaskFile" Content="My profile" IsChecked="{Binding SaveToPersonal}" ToolTip="Your own tasks.json, available in every workspace" />
            </StackPanel>
            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,10,0,0"
                       Text="Variables: ${workspaceFolder}, ${file}, ${fileDirname}, ${projectDir}, ${configuration}, ${env:NAME}. Dependencies, background tasks and other shells are set in the file itself." />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
