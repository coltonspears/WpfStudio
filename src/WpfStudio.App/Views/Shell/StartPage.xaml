<UserControl x:Class="WpfStudio.App.Views.Shell.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WpfStudio.App.Controls">
  <UserControl.Resources>
    <!-- Start page action row: icon, title, description and shortcut. -->
    <Style x:Key="StartAction" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,9">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border x:Name="IconWell" Width="32" Height="32" CornerRadius="7" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                  <c:Glyph Kind="{Binding (c:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <ContentPresenter TextElement.FontWeight="SemiBold" />
                  <TextBlock Text="{TemplateBinding ToolTip}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ItemsControl Grid.Column="2" Style="{StaticResource KeyCaps}" ItemsSource="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ToKeyCaps}}" Margin="12,0,0,0" />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter TargetName="IconWell" Property="Background" Value="{DynamicResource AccentSoftBrush}" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ToolTipService.IsEnabled" Value="False" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer Background="{DynamicResource EditorBrush}" VerticalScrollBarVisibility="Auto">
    <Grid MaxWidth="1000" Margin="48,40,48,32" HorizontalAlignment="Center" VerticalAlignment="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal">
        <Image Source="{StaticResource AppMark}" Width="48" Height="48" VerticalAlignment="Center" AutomationProperties.Name="WpfStudio" />
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="WpfStudio" FontSize="28" FontWeight="SemiBold" TextOptions.TextFormattingMode="Ideal" />
          <TextBlock Text="An IDE for WPF, XAML and MVVM — with the data and tools behind your app." Foreground="{DynamicResource MutedBrush}" FontSize="14" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>
      <Grid Grid.Row="1" Margin="0,32,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="320" />
          <ColumnDefinition Width="48" />
          <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="START" Style="{StaticResource SectionLabel}" Margin="10,0,0,10" />
          <Button Style="{StaticResource StartAction}" c:Ui.Icon="FolderOpen" Content="Open solution or project" ToolTip="Load a .sln, .slnx or .csproj with language services" Tag="Ctrl+Shift+O" Command="{Binding OpenWorkspaceCommand}" />
          <Button Style="{StaticResource StartAction}" c:Ui.Icon="File" Content="Open file" ToolTip="Edit a single file without a workspace" Tag="Ctrl+O" Command="{Binding OpenFileCommand}" />
          <Button Style="{StaticResource StartAction}" c:Ui.Icon="Sample" Content="Explore the sample app" ToolTip="CounterApp — WPF with CommunityToolkit.Mvvm, ready to debug" Command="{Binding OpenSampleCommand}" Visibility="{Binding HasSample, Converter={StaticResource BooleanToVisibility}}" />
          <Button Style="{StaticResource StartAction}" c:Ui.Icon="NewFile" Content="New WPF item" ToolTip="View + view model, user control, dictionary or converter" Tag="Ctrl+Shift+N" Command="{Binding NewWpfItemCommand}" IsEnabled="{Binding HasWorkspace}" />

        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="RECENT" Style="{StaticResource SectionLabel}" Margin="10,0,0,10" />
          <ScrollViewer MaxHeight="292" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
          <ItemsControl ItemsSource="{Binding RecentWorkspaces}" Focusable="False">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" ToolTip="{Binding}">
                  <Button.Style>
                    <Style TargetType="Button">
                      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                      <Setter Property="Margin" Value="0,0,0,4" />
                      <Setter Property="Cursor" Value="Hand" />
                      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="10,8">
                              <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource RaisedBrush}" /><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource BorderBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </Button.Style>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="7" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                      <c:StudioIcon Kind="Project" Width="17" Height="17" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Converter={StaticResource FileStem}}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Converter={StaticResource DirectoryOf}}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{DynamicResource RaisedBrush}" Margin="10,0,0,0">
                      <TextBlock Text="{Binding Converter={StaticResource ExtensionLabel}}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                    </Border>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
          <Border Style="{StaticResource Card}" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" Padding="16,14" Margin="0,0,0,0" Visibility="{Binding RecentWorkspaces.Count, Converter={StaticResource Presence}, ConverterParameter=Invert}">
            <StackPanel>
              <TextBlock Text="Nothing here yet" FontWeight="SemiBold" />
              <TextBlock Text="Solutions and projects you open appear here for one-click access." Style="{StaticResource Caption}" Margin="0,3,0,0" />
            </StackPanel>
          </Border>
          <TextBlock Text="GET STARTED" Style="{StaticResource SectionLabel}" Margin="10,26,0,12" />
          <StackPanel Margin="10,0,0,0">
            <StackPanel.Resources>
              <Style x:Key="Step" TargetType="Border">
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="BorderThickness" Value="1.5" />
                <Setter Property="BorderBrush" Value="{DynamicResource StrongBorderBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,1,12,0" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Resources>
            <DockPanel Margin="0,0,0,14">
              <Border Style="{StaticResource Step}" Tag="{Binding HasWorkspace}">
                <Grid>
                  <TextBlock Text="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasWorkspace, Converter={StaticResource Presence}, ConverterParameter=Invert}" />
                  <c:Glyph Kind="Check" Width="14" Height="14" Foreground="White" StrokeWeight="2" Visibility="{Binding HasWorkspace, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
              </Border>
              <StackPanel>
                <TextBlock Text="Open a solution or project" FontWeight="SemiBold" />
                <TextBlock Text="Language services, build, test and debug come online for it." Style="{StaticResource Caption}" Margin="0,2,0,0" />
              </StackPanel>
            </DockPanel>
            <DockPanel Margin="0,0,0,14">
              <Border Style="{StaticResource Step}">
                <TextBlock Text="2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <StackPanel>
                <TextBlock Text="Jump between a view and its view model" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0">Open any .xaml view and press <Run Text="F7" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" /> — WpfStudio follows naming conventions and declared DataContexts.</TextBlock>
              </StackPanel>
            </DockPanel>
            <DockPanel>
              <Border Style="{StaticResource Step}" Tag="{Binding IsColtonGptReady}">
                <Grid>
                  <TextBlock Text="3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsColtonGptReady, Converter={StaticResource Presence}, ConverterParameter=Invert}" />
                  <c:Glyph Kind="Check" Width="14" Height="14" Foreground="White" StrokeWeight="2" Visibility="{Binding IsColtonGptReady, Converter={StaticResource BooleanToVisibility}}" />
                </Grid>
              </Border>
              <StackPanel>
                <TextBlock Text="Connect ColtonGPT (optional)" FontWeight="SemiBold" />
                <TextBlock Text="Add an OpenRouter key to ask questions about your code with explicit, previewed context." Style="{StaticResource Caption}" Margin="0,2,0,0" />
                <Button Style="{StaticResource QuietButton}" Content="Open settings" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left" Foreground="{DynamicResource AccentBrush}" Padding="0,2" Margin="0,2,0,0" MinHeight="0" />
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
      <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="10,18,0,0">
        <StackPanel>
          <TextBlock Text="KEYBOARD" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
          <WrapPanel>
            <WrapPanel.Resources>
              <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /><Setter Property="Margin" Value="4,0,26,0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
              <Style TargetType="StackPanel"><Setter Property="Orientation" Value="Horizontal" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
            </WrapPanel.Resources>
            <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='Ctrl+P', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="Go to file" /></StackPanel>
            <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='Ctrl+Shift+P', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="All commands" /></StackPanel>
            <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='F7', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="View ⇄ view model" /></StackPanel>
            <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='Ctrl+.', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="Editor actions" /></StackPanel>
            <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='F5', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="Debug" /></StackPanel>
            <StackPanel><ItemsControl Style="{StaticResource KeyCaps}" ItemsSource="{Binding Source='Ctrl+Shift+B', Converter={StaticResource ToKeyCaps}}" /><TextBlock Text="Build" /></StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
  </ScrollViewer>
</UserControl>
