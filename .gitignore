# Local secrets, temporary files, and OS metadata
.env
.env.*
!.env.example
!.env.sample
*.tmp
*.temp
*.log
~$*
*~
.DS_Store
Thumbs.db
Desktop.ini

# Keep solution/project files, build configuration, scripts, and third-party notices.
# Do not ignore .csproj/.sln, global.json, Directory.Build.*, or bundled terminal assets.
